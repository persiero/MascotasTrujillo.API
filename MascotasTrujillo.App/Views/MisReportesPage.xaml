<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MascotasTrujillo.App.Views.MisReportesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MascotasTrujillo.App.Views.Controls"
    Title="Mis Reportes"
    BackgroundColor="#F5F1FF"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimaryDeep">#4C1D95</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="PrimarySoft2">#F3E8FF</Color>

            <Color x:Key="AccentPink">#FF4FB3</Color>
            <Color x:Key="AccentPinkSoft">#FDF2F8</Color>
            <Color x:Key="AccentPinkBorder">#F9A8D4</Color>
            <Color x:Key="AccentPinkText">#DB2777</Color>

            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextTitle">#1E1B4B</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Color x:Key="TextSecondary">#475569</Color>
            <Color x:Key="TextLight">#8A86A3</Color>

            <Color x:Key="CardBorder">#DCCBFF</Color>
            <Color x:Key="CardBorderStrong">#A855F7</Color>
            <Color x:Key="InputBackground">#F8F5FF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <Grid
            Grid.Row="0"
            Padding="12,12,12,0"
            RowDefinitions="Auto,Auto,*"
            RowSpacing="10">

            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0.0" Color="#E1D2FF" />
                    <GradientStop Offset="0.45" Color="#EADFFF" />
                    <GradientStop Offset="1.0" Color="#F4ECFF" />
                </LinearGradientBrush>
            </Grid.Background>

            <!--  Encabezado compacto  -->
            <Border
                Grid.Row="0"
                Padding="14,10"
                BackgroundColor="#FCFBFF"
                StrokeThickness="1.2">

                <Border.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0.0" Color="#D8B4FE" />
                        <GradientStop Offset="0.55" Color="#A855F7" />
                        <GradientStop Offset="1.0" Color="#6D28D9" />
                    </LinearGradientBrush>
                </Border.Stroke>

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow
                        Brush="#6D28D9"
                        Opacity="0.26"
                        Radius="18"
                        Offset="0,7" />
                </Border.Shadow>

                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">

                    <Border
                        Grid.Column="0"
                        BackgroundColor="#F3E8FF"
                        HeightRequest="44"
                        Stroke="#A855F7"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        WidthRequest="44">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="21" />
                        </Border.StrokeShape>

                        <Label
                            FontSize="21"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="📋"
                            TextColor="{StaticResource PrimaryColor}"
                            VerticalOptions="Center"
                            VerticalTextAlignment="Center" />
                    </Border>

                    <Label
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="Mis Reportes"
                        TextColor="{StaticResource PrimaryDark}"
                        VerticalOptions="Center" />

                    <Border
                        Grid.Column="2"
                        Padding="9,5"
                        BackgroundColor="#F3E8FF"
                        Stroke="#A855F7"
                        StrokeThickness="1"
                        VerticalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Label
                            x:Name="LblConteoReportes"
                            FontAttributes="Bold"
                            FontSize="11"
                            Text="0 reportes"
                            TextColor="{StaticResource PrimaryDark}" />
                    </Border>

                    <Button
                        Grid.Column="3"
                        Padding="0"
                        BackgroundColor="#F3E8FF"
                        BorderColor="#A855F7"
                        BorderWidth="1"
                        Clicked="OnActualizarClicked"
                        CornerRadius="19"
                        FontAttributes="Bold"
                        FontSize="17"
                        HeightRequest="38"
                        Text="↻"
                        TextColor="{StaticResource PrimaryColor}"
                        WidthRequest="38">
                        <Button.Shadow>
                            <Shadow
                                Brush="#5B21E6"
                                Opacity="0.18"
                                Radius="8"
                                Offset="0,3" />
                        </Button.Shadow>
                    </Button>

                </Grid>
            </Border>

            <ActivityIndicator
                x:Name="LoadingIndicator"
                Grid.Row="1"
                HeightRequest="18"
                IsRunning="False"
                IsVisible="False"
                Color="{StaticResource PrimaryColor}" />

            <!--  Lista  -->
            <CollectionView
                x:Name="MisReportesList"
                Grid.Row="2"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Border
                        Margin="0,10,0,0"
                        Padding="24"
                        BackgroundColor="#FFFCFF"
                        Stroke="#A855F7"
                        StrokeThickness="1.2">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow
                                Brush="#5B21E6"
                                Opacity="0.16"
                                Radius="14"
                                Offset="0,5" />
                        </Border.Shadow>

                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            Spacing="8"
                            VerticalOptions="Center">

                            <Label
                                FontSize="42"
                                HorizontalOptions="Center"
                                Text="🐾" />

                            <Label
                                FontAttributes="Bold"
                                FontSize="17"
                                HorizontalOptions="Center"
                                Text="Sin reportes"
                                TextColor="{StaticResource TextMain}" />

                            <Label
                                FontSize="13"
                                HorizontalTextAlignment="Center"
                                Text="Tus publicaciones aparecerán aquí."
                                TextColor="{StaticResource TextMuted}" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border
                            Margin="0,0,0,14"
                            Padding="0"
                            BackgroundColor="#FFFCFF"
                            StrokeThickness="1.3">

                            <Border.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0.0" Color="#D8B4FE" />
                                    <GradientStop Offset="0.65" Color="#A855F7" />
                                    <GradientStop Offset="1.0" Color="#7C3AED" />
                                </LinearGradientBrush>
                            </Border.Stroke>

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>

                            <Border.Shadow>
                                <Shadow
                                    Brush="#5B21E6"
                                    Opacity="0.20"
                                    Radius="14"
                                    Offset="0,5" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="6,*">

                                <!--  Barra lateral según estado  -->
                                <BoxView
                                    Grid.Column="0"
                                    CornerRadius="22,0,0,22"
                                    Color="{Binding EstadoReporteTexto}" />

                                <Grid
                                    Grid.Column="1"
                                    Padding="11"
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="12">

                                    <!--  Foto  -->
                                    <Border
                                        Grid.Column="0"
                                        BackgroundColor="#F8F5FF"
                                        HeightRequest="78"
                                        Stroke="#EEE7FF"
                                        StrokeThickness="1"
                                        VerticalOptions="Start"
                                        WidthRequest="78">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="18" />
                                        </Border.StrokeShape>

                                        <Image
                                            Aspect="AspectFill"
                                            HeightRequest="78"
                                            Source="{Binding FotoMostrar}"
                                            WidthRequest="78" />
                                    </Border>

                                    <!--  Información  -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="6">

                                        <!--  Título + tipo  -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1"
                                                Text="{Binding Titulo}"
                                                TextColor="#1E1B4B" />

                                            <Border
                                                Grid.Column="1"
                                                Padding="8,3"
                                                BackgroundColor="{Binding TipoReporteFondo}"
                                                Stroke="Transparent"
                                                VerticalOptions="Start">

                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>

                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="10"
                                                    Text="{Binding TipoReporte}"
                                                    TextColor="{Binding TipoReporteTexto}" />
                                            </Border>
                                        </Grid>

                                        <!--  Descripción  -->
                                        <Label
                                            FontSize="12"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1"
                                            Text="{Binding Descripcion}"
                                            TextColor="#475569" />

                                        <!--  Fecha  -->
                                        <Border
                                            Padding="7,3"
                                            BackgroundColor="#F3E8FF"
                                            HorizontalOptions="Start"
                                            Stroke="#D8B4FE"
                                            StrokeThickness="1">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>

                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                Text="{Binding FechaReporteTexto}"
                                                TextColor="#4C1D95" />
                                        </Border>

                                        <!--  Estado + acciones  -->
                                        <Grid
                                            Margin="0,2,0,0"
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="8">

                                            <Border
                                                Grid.Column="0"
                                                Padding="9,4"
                                                BackgroundColor="{Binding EstadoReporteFondo}"
                                                Stroke="Transparent"
                                                VerticalOptions="Center">

                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>

                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="11"
                                                    Text="{Binding EstadoReporte}"
                                                    TextColor="{Binding EstadoReporteTexto}" />
                                            </Border>

                                            <Button
                                                Grid.Column="2"
                                                Padding="12,0"
                                                BackgroundColor="#EEE7FF"
                                                BorderColor="#7C3AED"
                                                BorderWidth="1"
                                                Clicked="OnAccionesReporteClicked"
                                                CommandParameter="{Binding .}"
                                                CornerRadius="14"
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                HeightRequest="34"
                                                Text="⚙️ Acciones"
                                                TextColor="#4C1D95">
                                                <Button.Shadow>
                                                    <Shadow
                                                        Brush="#5B21E6"
                                                        Opacity="0.22"
                                                        Radius="8"
                                                        Offset="0,3" />
                                                </Button.Shadow>
                                            </Button>
                                        </Grid>

                                    </VerticalStackLayout>
                                </Grid>
                            </Grid>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--  Modal personalizado de acciones  -->
            <Grid
                x:Name="AccionesOverlay"
                Grid.RowSpan="3"
                Padding="18"
                BackgroundColor="#99000000"
                IsVisible="False"
                Opacity="0">

                <!--  Fondo oscuro para cerrar  -->
                <BoxView BackgroundColor="Transparent">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCerrarAccionesClicked" />
                    </BoxView.GestureRecognizers>
                </BoxView>

                <!--  Tarjeta de acciones  -->
                <Border
                    Margin="0,0,0,12"
                    Padding="16"
                    BackgroundColor="#FFFCFF"
                    Stroke="#A855F7"
                    StrokeThickness="1.2"
                    VerticalOptions="End">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#5B21E6"
                            Opacity="0.25"
                            Radius="18"
                            Offset="0,6" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                            <VerticalStackLayout Grid.Column="0" Spacing="2">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="Acciones del reporte"
                                    TextColor="{StaticResource PrimaryDark}" />

                                <Label
                                    x:Name="LblAccionesReporteTitulo"
                                    FontSize="12"
                                    LineBreakMode="TailTruncation"
                                    Text="Reporte seleccionado"
                                    TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Padding="0"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                Clicked="OnCerrarAccionesClicked"
                                CornerRadius="18"
                                FontAttributes="Bold"
                                HeightRequest="36"
                                Text="✕"
                                TextColor="{StaticResource PrimaryDark}"
                                WidthRequest="36" />
                        </Grid>

                        <BoxView
                            Margin="0,2"
                            HeightRequest="1"
                            Color="#EEE7FF" />

                        <Button
                            x:Name="BtnAccionDetalle"
                            BackgroundColor="#EEE7FF"
                            BorderColor="#A855F7"
                            BorderWidth="1"
                            Clicked="OnAccionDetalleClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            FontSize="14"
                            HeightRequest="46"
                            HorizontalOptions="Fill"
                            Text="👁 Ver detalle"
                            TextColor="#4C1D95" />

                        <Button
                            x:Name="BtnAccionResolver"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            Clicked="OnAccionResolverClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            FontSize="14"
                            HeightRequest="46"
                            HorizontalOptions="Fill"
                            Text="✅ Marcar como resuelto"
                            TextColor="White" />

                        <Button
                            x:Name="BtnAccionPausar"
                            BackgroundColor="#F59E0B"
                            Clicked="OnAccionPausarClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            FontSize="14"
                            HeightRequest="46"
                            HorizontalOptions="Fill"
                            Text="⏸ Pausar reporte"
                            TextColor="White" />

                        <Button
                            x:Name="BtnAccionReactivar"
                            BackgroundColor="#0F766E"
                            Clicked="OnAccionReactivarClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            FontSize="14"
                            HeightRequest="46"
                            HorizontalOptions="Fill"
                            Text="🔄 Reactivar reporte"
                            TextColor="White" />

                        <Button
                            BackgroundColor="#F3E8FF"
                            BorderColor="#D8B4FE"
                            BorderWidth="1"
                            Clicked="OnCerrarAccionesClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            FontSize="14"
                            HeightRequest="44"
                            HorizontalOptions="Fill"
                            Text="Cancelar"
                            TextColor="#4C1D95" />

                    </VerticalStackLayout>
                </Border>
            </Grid>

        </Grid>

        <controls:BottomNavBar Grid.Row="1" CurrentPage="Reportes" />
    </Grid>
</ContentPage>