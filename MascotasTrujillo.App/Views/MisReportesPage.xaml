<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MascotasTrujillo.App.Views.MisReportesPage"
    Title="Mis Reportes"
    BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,*"
          Padding="18"
          RowSpacing="14">

        <!-- Encabezado -->
        <Border Grid.Row="0"
                BackgroundColor="#FFFFFF"
                Stroke="Transparent"
                Padding="18">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="Black"
                        Opacity="0.08"
                        Offset="0,3"
                        Radius="8" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="6">
                <Label Text="Mis Reportes"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#1E1B4B" />

                <Label Text="Consulta y administra los reportes que registraste en la plataforma."
                       FontSize="14"
                       TextColor="#64748B"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Border>

        <!-- Lista -->
        <CollectionView Grid.Row="1"
                        x:Name="MisReportesList"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="30"
                                     Spacing="8"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">

                    <Label Text="🐾"
                           FontSize="42"
                           HorizontalOptions="Center" />

                    <Label Text="Aún no tienes reportes"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="#334155"
                           HorizontalOptions="Center" />

                    <Label Text="Cuando registres una mascota perdida o encontrada, aparecerá aquí."
                           FontSize="13"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border Stroke="Transparent"
                            BackgroundColor="#FFFFFF"
                            Margin="0,0,0,14"
                            Padding="12">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow Brush="Black"
                                    Opacity="0.08"
                                    Offset="0,3"
                                    Radius="8" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="88,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="12">

                            <!-- Foto -->
                            <Border Grid.RowSpan="2"
                                    Grid.Column="0"
                                    Stroke="Transparent"
                                    BackgroundColor="#F1F5F9"
                                    HeightRequest="82"
                                    WidthRequest="82">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Image Source="{Binding FotoUrl}"
                                       HeightRequest="82"
                                       WidthRequest="82"
                                       Aspect="AspectFill" />
                            </Border>

                            <!-- Información -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Grid.Row="0"
                                                 Spacing="5">

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">

                                    <Label Text="{Binding Titulo}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#1E293B"
                                           LineBreakMode="TailTruncation" />

                                    <Border Grid.Column="1"
                                            BackgroundColor="#EEF2FF"
                                            Stroke="Transparent"
                                            Padding="8,3"
                                            VerticalOptions="Center">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>

                                        <Label Text="{Binding TipoReporte}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#2B0B98" />
                                    </Border>
                                </Grid>

                                <Label Text="{Binding Descripcion}"
                                       FontSize="13"
                                       TextColor="#64748B"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />

                                <Label Text="{Binding FechaReporte, StringFormat='Registrado el {0:dd/MM/yyyy HH:mm}'}"
                                       FontSize="12"
                                       TextColor="#94A3B8" />

                            </VerticalStackLayout>

                            <!-- Acciones -->
                            <Grid Grid.Column="1"
                                  Grid.Row="1"
                                  RowDefinitions="Auto,Auto"
                                  Margin="0,10,0,0"
                                  RowSpacing="8">

                                <Label Grid.Row="0"
                                       Text="{Binding EstadoReporte}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#0F766E"
                                       VerticalOptions="Center" />

                                <HorizontalStackLayout Grid.Row="1"
                                        Spacing="8">

                                    <Button Text="Ver detalle"
                                            BackgroundColor="#EEF2FF"
                                            TextColor="#2B0B98"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            CornerRadius="14"
                                            HeightRequest="40"
                                            Padding="10,0"
                                            Clicked="OnVerDetalleClicked"
                                            CommandParameter="{Binding .}" />

                                    <Button Text="Resolver"
                                            BackgroundColor="#2B0B98"
                                            TextColor="White"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            CornerRadius="14"
                                            HeightRequest="40"
                                            Padding="10,0"
                                            IsVisible="{Binding PuedeResolver}"
                                            Clicked="OnMarcarResueltoClicked"
                                            CommandParameter="{Binding .}" />

                                    <Button Text="Suspender"
                                            BackgroundColor="#F59E0B"
                                            TextColor="White"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            CornerRadius="14"
                                            HeightRequest="40"
                                            Padding="10,0"
                                            IsVisible="{Binding PuedeSuspender}"
                                            Clicked="OnSuspenderReporteClicked"
                                            CommandParameter="{Binding .}" />

                                    <Button Text="Reactivar"
                                            BackgroundColor="#0F766E"
                                            TextColor="White"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            CornerRadius="14"
                                            HeightRequest="40"
                                            Padding="10,0"
                                            IsVisible="{Binding PuedeReactivar}"
                                            Clicked="OnReactivarReporteClicked"
                                            CommandParameter="{Binding .}" />

                                </HorizontalStackLayout>
                            </Grid>

                        </Grid>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>