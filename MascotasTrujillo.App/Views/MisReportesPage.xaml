<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MascotasTrujillo.App.Views.MisReportesPage"
    Title="Mis Reportes"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F1FF">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="AccentPink">#FF4FB3</Color>
            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Color x:Key="CardBorder">#E1D6FF</Color>
            <Color x:Key="InputBackground">#F8F5FF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="12,12,12,8"
          RowSpacing="10">

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F8F5FF" Offset="0.0" />
                <GradientStop Color="#F3EDFF" Offset="0.55" />
                <GradientStop Color="#FDFBFF" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Encabezado compacto -->
        <Border Grid.Row="0"
                BackgroundColor="#FFFFFF"
                Stroke="{StaticResource CardBorder}"
                StrokeThickness="1"
                Padding="14,10">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="#2B0B98"
                        Opacity="0.10"
                        Offset="0,4"
                        Radius="12" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                  ColumnSpacing="10">

                <Border Grid.Column="0"
                        BackgroundColor="{StaticResource PrimarySoft}"
                        Stroke="Transparent"
                        HeightRequest="42"
                        WidthRequest="42"
                        VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="21" />
                    </Border.StrokeShape>

                    <Label Text="📋"
                           FontSize="21"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label Grid.Column="1"
                       Text="Mis Reportes"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextMain}"
                       VerticalOptions="Center" />

                <Border Grid.Column="2"
                        BackgroundColor="{StaticResource PrimarySoft}"
                        Stroke="Transparent"
                        Padding="9,5"
                        VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Label x:Name="LblConteoReportes"
                           Text="0 reportes"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryColor}" />
                </Border>

                <Button Grid.Column="3"
                        Text="↻"
                        Clicked="OnActualizarClicked"
                        WidthRequest="38"
                        HeightRequest="38"
                        CornerRadius="19"
                        Padding="0"
                        BackgroundColor="#FFFFFF"
                        BorderColor="{StaticResource CardBorder}"
                        BorderWidth="1"
                        TextColor="{StaticResource PrimaryColor}"
                        FontAttributes="Bold"
                        FontSize="17" />
            </Grid>
        </Border>

        <ActivityIndicator Grid.Row="1"
                           x:Name="LoadingIndicator"
                           IsRunning="False"
                           IsVisible="False"
                           Color="{StaticResource PrimaryColor}"
                           HeightRequest="18" />

        <!-- Lista -->
        <CollectionView Grid.Row="2"
                        x:Name="MisReportesList"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <Border BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="24"
                        Margin="0,10,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="8"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">

                        <Label Text="🐾"
                               FontSize="42"
                               HorizontalOptions="Center" />

                        <Label Text="Sin reportes"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextMain}"
                               HorizontalOptions="Center" />

                        <Label Text="Tus publicaciones aparecerán aquí."
                               FontSize="13"
                               TextColor="{StaticResource TextMuted}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border Stroke="{StaticResource CardBorder}"
                            StrokeThickness="1"
                            BackgroundColor="#FFFFFF"
                            Margin="0,0,0,10"
                            Padding="10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow Brush="#2B0B98"
                                    Opacity="0.09"
                                    Offset="0,4"
                                    Radius="10" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="74,*"
                              ColumnSpacing="10">

                            <!-- Foto -->
                            <Border Grid.Column="0"
                                    Stroke="Transparent"
                                    BackgroundColor="#F1F5F9"
                                    HeightRequest="70"
                                    WidthRequest="70"
                                    VerticalOptions="Start">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Image Source="{Binding FotoMostrar}"
                                       HeightRequest="70"
                                       WidthRequest="70"
                                       Aspect="AspectFill" />
                            </Border>

                            <!-- Información -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="6">

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">

                                    <Label Text="{Binding Titulo}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextMain}"
                                           LineBreakMode="TailTruncation" />

                                    <Border Grid.Column="1"
                                            BackgroundColor="{Binding TipoReporteFondo}"
                                            Stroke="Transparent"
                                            Padding="7,3"
                                            VerticalOptions="Center">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>

                                        <Label Text="{Binding TipoReporte}"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="{Binding TipoReporteTexto}" />
                                    </Border>
                                </Grid>

                                <Label Text="{Binding Descripcion}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextMuted}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />

                                <Label Text="{Binding FechaReporte, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                       FontSize="11"
                                       TextColor="#94A3B8" />

                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="8"
                                      Margin="0,2,0,0">

                                    <Border Grid.Column="0"
                                            BackgroundColor="{Binding EstadoReporteFondo}"
                                            Stroke="Transparent"
                                            Padding="9,4"
                                            VerticalOptions="Center">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>

                                        <Label Text="{Binding EstadoReporte}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{Binding EstadoReporteTexto}" />
                                    </Border>

                                    <Button Grid.Column="2"
                                            Text="Acciones"
                                            BackgroundColor="{StaticResource PrimarySoft}"
                                            TextColor="{StaticResource PrimaryDark}"
                                            BorderColor="{StaticResource CardBorder}"
                                            BorderWidth="1"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            CornerRadius="13"
                                            HeightRequest="34"
                                            Padding="12,0"
                                            Clicked="OnAccionesReporteClicked"
                                            CommandParameter="{Binding .}" />
                                </Grid>

                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>