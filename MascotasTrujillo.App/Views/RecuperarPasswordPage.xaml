<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MascotasTrujillo.App.Views.RecuperarPasswordPage"
    Title="Recuperar contraseña"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F1FF">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Color x:Key="CardBorder">#E1D6FF</Color>
            <Color x:Key="InputBorder">#D8CCFF</Color>
            <Color x:Key="InputBackground">#F8F5FF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="20">

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F8F5FF" Offset="0.0" />
                <GradientStop Color="#F3EDFF" Offset="0.55" />
                <GradientStop Color="#FDFBFF" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Spacing="18">

                <Button Text="← Volver"
                        Clicked="OnVolverClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource PrimaryColor}"
                        FontAttributes="Bold"
                        HorizontalOptions="Start"
                        Padding="0" />

                <VerticalStackLayout Spacing="10"
                                     HorizontalOptions="Center"
                                     Margin="0,0,0,8">

                    <Border HeightRequest="110"
                            WidthRequest="110"
                            BackgroundColor="White"
                            Stroke="{StaticResource CardBorder}"
                            StrokeThickness="1"
                            Padding="16">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="55" />
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow Brush="#5B21E6"
                                    Opacity="0.20"
                                    Offset="0,8"
                                    Radius="18" />
                        </Border.Shadow>

                        <Label Text="🔐"
                               FontSize="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="Recuperar contraseña"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryDark}"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Te enviaremos un código de seguridad a tu correo."
                           FontSize="13"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Paso 1: correo -->
                <Border x:Name="PasoCorreoContainer"
                        BackgroundColor="White"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.12"
                                Offset="0,8"
                                Radius="20" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">

                        <Label Text="Paso 1 de 2"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource PrimaryColor}" />

                        <Label Text="Ingresa tu correo registrado"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextMain}" />

                        <Border Stroke="{StaticResource InputBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource InputBackground}"
                                Padding="12,0"
                                HeightRequest="56">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Entry x:Name="EmailRecuperacionEntry"
                                   Placeholder="Correo electrónico"
                                   PlaceholderColor="#8C84A6"
                                   Keyboard="Email"
                                   TextColor="{StaticResource TextMain}"
                                   BackgroundColor="Transparent"
                                   ClearButtonVisibility="WhileEditing" />
                        </Border>

                        <Button x:Name="BtnEnviarCodigo"
                                Text="Enviar código"
                                Clicked="OnEnviarCodigoClicked"
                                BackgroundColor="{StaticResource PrimaryColor}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="18"
                                HeightRequest="52" />

                    </VerticalStackLayout>
                </Border>

                <!-- Paso 2: código y nueva contraseña -->
                <Border x:Name="PasoCodigoContainer"
                        IsVisible="False"
                        BackgroundColor="White"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.12"
                                Offset="0,8"
                                Radius="20" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">

                        <Label Text="Paso 2 de 2"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource PrimaryColor}" />

                        <Label Text="Ingresa el código recibido"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextMain}" />

                        <Label x:Name="LblCorreoDestino"
                               Text=""
                               FontSize="12"
                               TextColor="{StaticResource TextMuted}"
                               LineBreakMode="WordWrap" />

                        <Border Stroke="{StaticResource InputBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource InputBackground}"
                                Padding="12,0"
                                HeightRequest="56">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Entry x:Name="CodigoEntry"
                                   Placeholder="Código de 6 dígitos"
                                   PlaceholderColor="#8C84A6"
                                   Keyboard="Numeric"
                                   MaxLength="6"
                                   TextColor="{StaticResource TextMain}"
                                   BackgroundColor="Transparent" />
                        </Border>

                        <Border Stroke="{StaticResource InputBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource InputBackground}"
                                Padding="12,0"
                                HeightRequest="56">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Entry x:Name="PasswordNuevoEntry"
                                   Placeholder="Nueva contraseña"
                                   PlaceholderColor="#8C84A6"
                                   IsPassword="True"
                                   TextColor="{StaticResource TextMain}"
                                   BackgroundColor="Transparent" />
                        </Border>

                        <Border Stroke="{StaticResource InputBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource InputBackground}"
                                Padding="12,0"
                                HeightRequest="56">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Entry x:Name="ConfirmarPasswordEntry"
                                   Placeholder="Confirmar nueva contraseña"
                                   PlaceholderColor="#8C84A6"
                                   IsPassword="True"
                                   TextColor="{StaticResource TextMain}"
                                   BackgroundColor="Transparent" />
                        </Border>

                        <Button x:Name="BtnRestablecer"
                                Text="Restablecer contraseña"
                                Clicked="OnRestablecerClicked"
                                BackgroundColor="{StaticResource PrimaryColor}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="18"
                                HeightRequest="52" />

                        <Button Text="Cambiar correo"
                                Clicked="OnCambiarCorreoClicked"
                                BackgroundColor="#F8F5FF"
                                TextColor="{StaticResource PrimaryColor}"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="46" />

                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="{StaticResource PrimaryColor}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>