<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MascotasTrujillo.App.Views.RecuperarPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Recuperar contraseña"
    BackgroundColor="#F5F1FF"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimaryDeep">#4C1D95</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="PrimarySoft2">#F3E8FF</Color>

            <Color x:Key="AccentPink">#FF4FB3</Color>
            <Color x:Key="AccentPinkSoft">#FDF2F8</Color>
            <Color x:Key="AccentPinkBorder">#F9A8D4</Color>
            <Color x:Key="AccentPinkText">#DB2777</Color>

            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextTitle">#1E1B4B</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Color x:Key="TextSecondary">#475569</Color>
            <Color x:Key="TextLight">#8A86A3</Color>

            <Color x:Key="CardBorder">#DCCBFF</Color>
            <Color x:Key="CardBorderStrong">#A855F7</Color>
            <Color x:Key="InputBorder">#D8B4FE</Color>
            <Color x:Key="InputBackground">#F8F5FF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="20">

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="#E1D2FF" />
                <GradientStop Offset="0.45" Color="#EADFFF" />
                <GradientStop Offset="1.0" Color="#F4ECFF" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Spacing="18">

                <Button
                    Padding="14,0"
                    BackgroundColor="#F3E8FF"
                    BorderColor="#A855F7"
                    BorderWidth="1"
                    Clicked="OnVolverClicked"
                    CornerRadius="16"
                    FontAttributes="Bold"
                    HeightRequest="40"
                    HorizontalOptions="Start"
                    Text="← Volver"
                    TextColor="{StaticResource PrimaryDark}" />

                <VerticalStackLayout
                    Margin="0,0,0,8"
                    HorizontalOptions="Center"
                    Spacing="10">

                    <Border
                        Padding="16"
                        BackgroundColor="#FFFFFF"
                        HeightRequest="110"
                        Stroke="#A855F7"
                        StrokeThickness="1.4"
                        WidthRequest="110">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="55" />
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow
                                Brush="#5B21E6"
                                Opacity="0.28"
                                Radius="18"
                                Offset="0,8" />
                        </Border.Shadow>

                        <Label
                            FontSize="48"
                            HorizontalOptions="Center"
                            Text="🔑"
                            VerticalOptions="Center" />
                    </Border>

                    <Label
                        FontAttributes="Bold"
                        FontSize="25"
                        HorizontalTextAlignment="Center"
                        Text="Recuperar contraseña"
                        TextColor="{StaticResource PrimaryDark}" />

                    <Label
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        Text="Te enviaremos un código de seguridad a tu correo."
                        TextColor="{StaticResource TextMuted}" />
                </VerticalStackLayout>

                <!--  Paso 1: correo  -->
                <Border
                    x:Name="PasoCorreoContainer"
                    Padding="18"
                    BackgroundColor="#FCFBFF"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.65" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#7C3AED" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#5B21E6"
                            Opacity="0.24"
                            Radius="26"
                            Offset="0,10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">

                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="Paso 1 de 2"
                            TextColor="{StaticResource PrimaryColor}" />

                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="Ingresa tu correo registrado"
                            TextColor="{StaticResource PrimaryDark}" />

                        <Border
                            Padding="12,0"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="56"
                            Stroke="#A855F7"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Entry
                                x:Name="EmailRecuperacionEntry"
                                BackgroundColor="Transparent"
                                ClearButtonVisibility="WhileEditing"
                                Keyboard="Email"
                                Placeholder="Correo electrónico"
                                PlaceholderColor="#8C84A6"
                                TextColor="{StaticResource TextMain}" />
                        </Border>

                        <Button
                            x:Name="BtnEnviarCodigo"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            Clicked="OnEnviarCodigoClicked"
                            CornerRadius="22"
                            FontAttributes="Bold"
                            HeightRequest="54"
                            Text="Enviar código"
                            TextColor="White">

                            <Button.Shadow>
                                <Shadow
                                    Brush="#5B21E6"
                                    Opacity="0.44"
                                    Radius="14"
                                    Offset="0,6" />
                            </Button.Shadow>
                        </Button>

                    </VerticalStackLayout>
                </Border>

                <!--  Paso 2: código y nueva contraseña  -->
                <Border
                    x:Name="PasoCodigoContainer"
                    Padding="18"
                    BackgroundColor="#FCFBFF"
                    IsVisible="False"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.65" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#7C3AED" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#5B21E6"
                            Opacity="0.24"
                            Radius="26"
                            Offset="0,10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">

                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="Paso 2 de 2"
                            TextColor="{StaticResource PrimaryColor}" />

                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="Ingresa el código recibido"
                            TextColor="{StaticResource PrimaryDark}" />

                        <Label
                            x:Name="LblCorreoDestino"
                            FontSize="12"
                            LineBreakMode="WordWrap"
                            Text=""
                            TextColor="{StaticResource TextMuted}" />

                        <Border
                            Padding="12,0"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="56"
                            Stroke="#A855F7"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Entry
                                x:Name="CodigoEntry"
                                BackgroundColor="Transparent"
                                Keyboard="Numeric"
                                MaxLength="6"
                                Placeholder="Código de 6 dígitos"
                                PlaceholderColor="#8C84A6"
                                TextColor="{StaticResource PrimaryDark}" />
                        </Border>

                        <Border
                            Padding="12,0"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="56"
                            Stroke="#A855F7"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Entry
                                x:Name="PasswordNuevoEntry"
                                BackgroundColor="Transparent"
                                IsPassword="True"
                                Placeholder="Nueva contraseña"
                                PlaceholderColor="#8C84A6"
                                TextColor="{StaticResource PrimaryDark}" />
                        </Border>

                        <Border
                            Padding="12,0"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="56"
                            Stroke="#A855F7"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Entry
                                x:Name="ConfirmarPasswordEntry"
                                BackgroundColor="Transparent"
                                IsPassword="True"
                                Placeholder="Confirmar nueva contraseña"
                                PlaceholderColor="#8C84A6"
                                TextColor="{StaticResource PrimaryDark}" />
                        </Border>

                        <Button
                            x:Name="BtnRestablecer"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            Clicked="OnRestablecerClicked"
                            CornerRadius="22"
                            FontAttributes="Bold"
                            HeightRequest="54"
                            Text="Restablecer contraseña"
                            TextColor="White">

                            <Button.Shadow>
                                <Shadow
                                    Brush="#5B21E6"
                                    Opacity="0.44"
                                    Radius="14"
                                    Offset="0,6" />
                            </Button.Shadow>
                        </Button>

                        <Button
                            BackgroundColor="#EEE7FF"
                            BorderColor="#7C3AED"
                            BorderWidth="1"
                            Clicked="OnCambiarCorreoClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            HeightRequest="46"
                            Text="Cambiar correo"
                            TextColor="#4C1D95" />

                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator
                    x:Name="LoadingIndicator"
                    IsRunning="False"
                    IsVisible="False"
                    Color="{StaticResource PrimaryColor}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>