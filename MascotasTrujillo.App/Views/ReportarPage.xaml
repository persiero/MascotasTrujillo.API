<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MascotasTrujillo.App.Views.ReportarPage"
    Title="Nuevo Reporte"
    BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="16">

            <!-- Encabezado -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="Black"
                            Opacity="0.08"
                            Offset="0,3"
                            Radius="8" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Nuevo Reporte"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#1E1B4B" />

                    <Label Text="Registra una mascota perdida o encontrada para ayudar a la comunidad."
                           FontSize="14"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- Tipo de reporte -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="16">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label Text="Tipo de reporte"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />

                    <Picker x:Name="TipoReportePicker"
                            Title="Selecciona una opción"
                            SelectedIndexChanged="OnTipoReporteChanged"
                            BackgroundColor="#F1F5F9"
                            TextColor="#1E293B">
                        <Picker.Items>
                            <x:String>Mascota perdida</x:String>
                            <x:String>Mascota encontrada</x:String>
                        </Picker.Items>
                    </Picker>

                </VerticalStackLayout>
            </Border>

            <!-- Seleccionar mascota registrada -->
            <Border x:Name="SeleccionMascotaBorder"
                    BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="16"
                    IsVisible="False">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label Text="Seleccionar mi mascota"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />

                    <Label Text="Para reportar una mascota perdida, selecciona una mascota que ya tengas registrada."
                           FontSize="12"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />

                    <Picker x:Name="MisMascotasPicker"
                            Title="Selecciona una mascota"
                            ItemDisplayBinding="{Binding Nombre}"
                            SelectedIndexChanged="OnMascotaRegistradaSeleccionada"
                            BackgroundColor="#F1F5F9"
                            TextColor="#1E293B" />

                    <Border BackgroundColor="#EEF2FF"
                            Stroke="Transparent"
                            Padding="12">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Label x:Name="LblResumenMascotaSeleccionada"
                               Text="Los datos y la foto se cargarán automáticamente desde tu mascota registrada."
                               FontSize="12"
                               TextColor="#2B0B98"
                               FontAttributes="Bold"
                               LineBreakMode="WordWrap" />
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- Datos principales -->
            <Border x:Name="DatosMascotaBorder"
                    BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="16">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label Text="Información del reporte"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />

                    <Entry x:Name="TituloEntry"
                           Placeholder="Ej. Se perdió mi perro / Mascota encontrada"
                           BackgroundColor="#F1F5F9"
                           TextColor="#1E293B" />

                    <Editor x:Name="DescripcionEntry"
                            Placeholder="Describe la situación, características visibles o detalles importantes..."
                            AutoSize="TextChanges"
                            HeightRequest="100"
                            BackgroundColor="#F1F5F9"
                            TextColor="#1E293B" />

                    <Entry x:Name="DireccionReferenciaEntry"
                           Placeholder="Referencia del lugar. Ej. Cerca del parque, avenida, mercado..."
                           BackgroundColor="#F1F5F9"
                           TextColor="#1E293B" />

                </VerticalStackLayout>
            </Border>

            <!-- Datos referenciales de la mascota -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="16">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label Text="Datos de la mascota"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />

                    <Label Text="Completa estos datos si no estás asociando el reporte a una mascota registrada."
                           FontSize="12"
                           TextColor="#64748B" />

                    <Entry x:Name="NombreMascotaEntry"
                           Placeholder="Nombre de la mascota, si se conoce"
                           BackgroundColor="#F1F5F9"
                           TextColor="#1E293B" />

                    <Entry x:Name="EspecieEntry"
                           Placeholder="Especie. Ej. Perro, gato"
                           BackgroundColor="#F1F5F9"
                           TextColor="#1E293B" />

                    <Entry x:Name="RazaEntry"
                           Placeholder="Raza, si se conoce"
                           BackgroundColor="#F1F5F9"
                           TextColor="#1E293B" />

                    <Entry x:Name="ColorEntry"
                           Placeholder="Color principal"
                           BackgroundColor="#F1F5F9"
                           TextColor="#1E293B" />

                    <Picker x:Name="SexoPicker"
                            Title="Sexo, si se conoce"
                            BackgroundColor="#F1F5F9"
                            TextColor="#1E293B">
                        <Picker.Items>
                            <x:String>Macho</x:String>
                            <x:String>Hembra</x:String>
                            <x:String>No identificado</x:String>
                        </Picker.Items>
                    </Picker>

                </VerticalStackLayout>
            </Border>

            <!-- Foto -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="16">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label Text="Fotografía del reporte"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />

                    <Label Text="Agrega una foto para que sea más fácil identificar a la mascota."
                           FontSize="12"
                           TextColor="#64748B" />

                    <Border BackgroundColor="#F1F5F9"
                            HeightRequest="240"
                            Stroke="#CBD5E1"
                            StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Grid>
                            <Image x:Name="FotoPreview"
                                   Aspect="AspectFill" />

                            <VerticalStackLayout x:Name="BotonesCaptura"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center"
                                                 Spacing="10">

                                <Label Text="📷"
                                       FontSize="40"
                                       HorizontalOptions="Center" />

                                <HorizontalStackLayout Spacing="10"
                                                       HorizontalOptions="Center">

                                    <Button Text="Cámara"
                                            Clicked="OnTomarFotoClicked"
                                            BackgroundColor="#2B0B98"
                                            TextColor="White"
                                            CornerRadius="14"
                                            Padding="18,0" />

                                    <Button Text="Galería"
                                            Clicked="OnElegirGaleriaClicked"
                                            BackgroundColor="#EEF2FF"
                                            TextColor="#2B0B98"
                                            CornerRadius="14"
                                            Padding="18,0" />

                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- Botón enviar -->
            <Button x:Name="BtnEnviar"
                    Text="📍 Enviar reporte con GPS"
                    Clicked="OnEnviarClicked"
                    BackgroundColor="#2B0B98"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="18"
                    HeightRequest="54"
                    IsEnabled="False" />

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#2B0B98" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>