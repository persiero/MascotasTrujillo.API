<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MascotasTrujillo.App.Views.ReportarPage"
    Title="Nuevo Reporte"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F1FF">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="AccentPink">#FF4FB3</Color>
            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Color x:Key="CardBorder">#E1D6FF</Color>
            <Color x:Key="InputBorder">#D8CCFF</Color>
            <Color x:Key="InputBackground">#F8F5FF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F8F5FF" Offset="0.0" />
                <GradientStop Color="#F3EDFF" Offset="0.55" />
                <GradientStop Color="#FDFBFF" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="14,12,14,20"
                                 Spacing="10">

                <!-- Encabezado con volver -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="12,10">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.10"
                                Offset="0,4"
                                Radius="12" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto,*"
                            ColumnSpacing="10">

                        <Button Grid.Column="0"
                                Text="←"
                                Clicked="OnVolverClicked"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                TextColor="{StaticResource PrimaryColor}"
                                FontAttributes="Bold"
                                FontSize="22"
                                WidthRequest="42"
                                HeightRequest="42"
                                CornerRadius="21"
                                Padding="0"
                                VerticalOptions="Center" />

                        <VerticalStackLayout Grid.Column="1"
                                     Spacing="1"
                                     VerticalOptions="Center">

                            <Label Text="Nuevo reporte"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextMain}" />

                            <Label Text="Registra una mascota perdida o encontrada"
                                   FontSize="12"
                                   TextColor="{StaticResource TextMuted}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Tipo de reporte -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.10"
                                Offset="0,4"
                                Radius="12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10">

                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource PrimarySoft}"
                                    Stroke="Transparent"
                                    WidthRequest="38"
                                    HeightRequest="38"
                                    VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="19" />
                                </Border.StrokeShape>

                                <Label Text="🐾"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <Label Grid.Column="1"
                                   Text="Tipo de reporte"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextMain}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">

                            <Button x:Name="BtnTipoPerdida"
                                    Grid.Column="0"
                                    Text="🐾 Perdida"
                                    Clicked="OnTipoPerdidaClicked"
                                    BackgroundColor="{StaticResource InputBackground}"
                                    TextColor="{StaticResource PrimaryDark}"
                                    BorderColor="{StaticResource InputBorder}"
                                    BorderWidth="1"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    CornerRadius="16"
                                    HeightRequest="44" />

                            <Button x:Name="BtnTipoEncontrada"
                                    Grid.Column="1"
                                    Text="🏠 Encontrada"
                                    Clicked="OnTipoEncontradaClicked"
                                    BackgroundColor="{StaticResource InputBackground}"
                                    TextColor="{StaticResource PrimaryDark}"
                                    BorderColor="{StaticResource InputBorder}"
                                    BorderWidth="1"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    CornerRadius="16"
                                    HeightRequest="44" />
                        </Grid>

                        <Label x:Name="LblAyudaTipoReporte"
                               Text=""
                               IsVisible="False" />

                    </VerticalStackLayout>
                </Border>

                <!-- Seleccionar mascota registrada -->
                <Border x:Name="SeleccionMascotaBorder"
                        BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="14"
                        IsVisible="False">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.08"
                                Offset="0,3"
                                Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <Label Text="Mi mascota"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextMain}" />

                        <Border Stroke="{StaticResource InputBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource InputBackground}"
                                Padding="12,0"
                                HeightRequest="52">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Picker x:Name="MisMascotasPicker"
                                    Title="Selecciona una mascota"
                                    ItemDisplayBinding="{Binding Nombre}"
                                    SelectedIndexChanged="OnMascotaRegistradaSeleccionada"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource TextMain}" />
                        </Border>

                        <Border BackgroundColor="{StaticResource PrimarySoft}"
                                Stroke="Transparent"
                                Padding="10">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Label x:Name="LblResumenMascotaSeleccionada"
                                   Text="Sus datos se cargarán automáticamente."
                                   FontSize="12"
                                   TextColor="{StaticResource PrimaryDark}"
                                   FontAttributes="Bold"
                                   LineBreakMode="WordWrap" />
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- Información del reporte -->
                <Border x:Name="DatosMascotaBorder"
                        BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.08"
                                Offset="0,3"
                                Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <Label Text="Información"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextMain}" />

                        <Border Stroke="{StaticResource InputBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource InputBackground}"
                                Padding="12,0"
                                HeightRequest="50">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Entry x:Name="TituloEntry"
                                   Placeholder="Título del reporte"
                                   PlaceholderColor="#8C84A6"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource TextMain}" />
                        </Border>

                        <Border Stroke="{StaticResource InputBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource InputBackground}"
                                Padding="12,4"
                                HeightRequest="88">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Editor x:Name="DescripcionEntry"
                                    Placeholder="Descripción breve"
                                    PlaceholderColor="#8C84A6"
                                    AutoSize="TextChanges"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource TextMain}" />
                        </Border>

                        <Border Stroke="{StaticResource InputBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource InputBackground}"
                                Padding="12,0"
                                HeightRequest="50">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Entry x:Name="DireccionReferenciaEntry"
                                   Placeholder="Referencia del lugar"
                                   PlaceholderColor="#8C84A6"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource TextMain}" />
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- Ubicación del reporte -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.08"
                                Offset="0,3"
                                Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <Label Text="Ubicación"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextMain}" />

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">

                            <Button Grid.Column="0"
                                    Text="📍 Usar GPS"
                                    Clicked="OnUsarGpsActualClicked"
                                    BackgroundColor="{StaticResource PrimaryColor}"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="16"
                                    HeightRequest="44" />

                            <Button Grid.Column="1"
                                    Text="🗺️ Mapa"
                                    Clicked="OnSeleccionarMapaClicked"
                                    BackgroundColor="#FFFFFF"
                                    TextColor="{StaticResource PrimaryColor}"
                                    BorderColor="{StaticResource CardBorder}"
                                    BorderWidth="1"
                                    FontAttributes="Bold"
                                    CornerRadius="16"
                                    HeightRequest="44" />

                        </Grid>

                        <Border BackgroundColor="{StaticResource PrimarySoft}"
                                Stroke="Transparent"
                                Padding="10">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Label x:Name="LblUbicacionSeleccionada"
                                   Text="Ubicación pendiente"
                                   FontSize="12"
                                   TextColor="{StaticResource PrimaryDark}"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- Datos referenciales de la mascota -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.08"
                                Offset="0,3"
                                Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <!-- Encabezado plegable -->
                        <Grid ColumnDefinitions="*,Auto"
                                ColumnSpacing="10">

                            <VerticalStackLayout Grid.Column="0"
                                 Spacing="2">

                                <Label x:Name="LblTituloDatosMascota"
                                       Text="Mascota"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextMain}" />

                                <Label x:Name="LblAyudaDatosMascota"
                                       Text="Completa solo lo necesario."
                                       FontSize="12"
                                       TextColor="{StaticResource TextMuted}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <Button x:Name="BtnToggleDatosMascota"
                                    Grid.Column="1"
                                    Text="Mostrar"
                                    Clicked="OnToggleDatosMascotaClicked"
                                    BackgroundColor="{StaticResource PrimarySoft}"
                                    TextColor="{StaticResource PrimaryDark}"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    CornerRadius="14"
                                    HeightRequest="36"
                                    Padding="12,0"
                                    VerticalOptions="Center" />
                        </Grid>

                        <!-- Contenido plegable -->
                        <VerticalStackLayout x:Name="MascotaCamposContainer"
                                             Spacing="10"
                                             IsVisible="False">

                            <Border x:Name="NombreMascotaField"
                                    Stroke="{StaticResource InputBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource InputBackground}"
                                    Padding="12,0"
                                    HeightRequest="50">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Entry x:Name="NombreMascotaEntry"
                                       Placeholder="Nombre"
                                       PlaceholderColor="#8C84A6"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource TextMain}" />
                            </Border>

                            <Border x:Name="EspecieField"
                                    Stroke="{StaticResource InputBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource InputBackground}"
                                    Padding="12,10">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="8">

                                    <Label Text="Especie"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextMuted}" />

                                    <Grid ColumnDefinitions="*,*"
                                        ColumnSpacing="10">

                                        <Button x:Name="BtnEspeciePerro"
                                                Grid.Column="0"
                                                Text="🐶 Perro"
                                                Clicked="OnEspeciePerroClicked"
                                                BackgroundColor="{StaticResource InputBackground}"
                                                TextColor="{StaticResource PrimaryDark}"
                                                BorderColor="{StaticResource InputBorder}"
                                                BorderWidth="1"
                                                FontAttributes="Bold"
                                                FontSize="13"
                                                CornerRadius="16"
                    HeightRequest="42" />

                                        <Button x:Name="BtnEspecieGato"
                                                Grid.Column="1"
                                                Text="🐱 Gato"
                                                Clicked="OnEspecieGatoClicked"
                                                BackgroundColor="{StaticResource InputBackground}"
                                                TextColor="{StaticResource PrimaryDark}"
                                                BorderColor="{StaticResource InputBorder}"
                                                BorderWidth="1"
                                                FontAttributes="Bold"
                                                FontSize="13"
                                                CornerRadius="16"
                                                HeightRequest="42" />

                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Grid ColumnDefinitions="*,*"
                                    ColumnSpacing="10">

                                <Border x:Name="RazaField"
                                        Grid.Column="0"
                                        Stroke="{StaticResource InputBorder}"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource InputBackground}"
                                        Padding="12,0"
                                        HeightRequest="50">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>

                                    <Entry x:Name="RazaEntry"
                                           Placeholder="Raza"
                                           PlaceholderColor="#8C84A6"
                                           BackgroundColor="Transparent"
                                           TextColor="{StaticResource TextMain}" />
                                </Border>

                                <Border x:Name="ColorField"
                                        Grid.Column="1"
                                        Stroke="{StaticResource InputBorder}"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource InputBackground}"
                                        Padding="12,0"
                                        HeightRequest="50">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>

                                    <Entry x:Name="ColorEntry"
                                           Placeholder="Color"
                                           PlaceholderColor="#8C84A6"
                                           BackgroundColor="Transparent"
                                           TextColor="{StaticResource TextMain}" />
                                </Border>
                            </Grid>

                            <Border x:Name="SexoField"
                                    Stroke="{StaticResource InputBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource InputBackground}"
                                    Padding="12,0"
                                    HeightRequest="52">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Button x:Name="BtnSexoSelector"
                                        Text="Seleccionar sexo"
                                        Clicked="OnAbrirSexoSelectorClicked"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextMain}"
                                        FontAttributes="Bold"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Center"
                                        Padding="0"
                                        HeightRequest="48" />
                            </Border>

                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Foto -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.08"
                                Offset="0,3"
                                Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="LblTituloFotoReporte"
                                   Text="Foto"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextMain}"
                                   VerticalOptions="Center" />

                            <Border Grid.Column="1"
                                    BackgroundColor="#FCE7F3"
                                    Stroke="Transparent"
                                    Padding="9,4"
                                    VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Label Text="Opcional"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#BE185D" />
                            </Border>
                        </Grid>

                        <Label x:Name="LblAyudaFotoReporte"
                               Text="Agrega una imagen clara."
                               FontSize="12"
                               TextColor="{StaticResource TextMuted}"
                               LineBreakMode="WordWrap" />

                        <Border BackgroundColor="{StaticResource InputBackground}"
                                HeightRequest="210"
                                Stroke="{StaticResource InputBorder}"
                                StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Grid>
                                <Image x:Name="FotoPreview"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill" />

                                <VerticalStackLayout x:Name="BotonesCaptura"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center"
                                                     Spacing="10">

                                    <Label Text="📷"
                                           FontSize="36"
                                           HorizontalOptions="Center" />

                                    <HorizontalStackLayout Spacing="10"
                                                           HorizontalOptions="Center">

                                        <Button Text="Cámara"
                                                Clicked="OnTomarFotoClicked"
                                                BackgroundColor="{StaticResource PrimaryColor}"
                                                TextColor="White"
                                                FontAttributes="Bold"
                                                CornerRadius="14"
                                                HeightRequest="40"
                                                Padding="18,0" />

                                        <Button Text="Galería"
                                                Clicked="OnElegirGaleriaClicked"
                                                BackgroundColor="#FFFFFF"
                                                TextColor="{StaticResource PrimaryColor}"
                                                BorderColor="{StaticResource CardBorder}"
                                                BorderWidth="1"
                                                FontAttributes="Bold"
                                                CornerRadius="14"
                                                HeightRequest="40"
                                                Padding="18,0" />

                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- Botón enviar -->
                <Button x:Name="BtnEnviar"
                        Text="📌 Publicar reporte"
                        Clicked="OnEnviarClicked"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="18"
                        HeightRequest="54"
                        IsEnabled="True">

                    <Button.Shadow>
                        <Shadow Brush="#5B21E6"
                                Opacity="0.25"
                                Offset="0,5"
                                Radius="12" />
                    </Button.Shadow>
                </Button>

                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="{StaticResource PrimaryColor}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Modal personalizado para seleccionar sexo -->
        <Grid x:Name="SexoOverlay"
      IsVisible="False"
      Opacity="0"
      BackgroundColor="#80000000">

            <Grid RowDefinitions="*,Auto">

                <BoxView Grid.Row="0"
                 BackgroundColor="Transparent">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCerrarSexoOverlayTapped" />
                    </BoxView.GestureRecognizers>
                </BoxView>

                <Border Grid.Row="1"
                BackgroundColor="#FFFFFF"
                Stroke="{StaticResource CardBorder}"
                StrokeThickness="1"
                Padding="18,16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26,26,0,0" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                        Opacity="0.20"
                        Offset="0,-4"
                        Radius="16" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">

                            <VerticalStackLayout Grid.Column="0"
                                         Spacing="2">
                                <Label Text="Seleccionar sexo"
                                       FontSize="19"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextMain}" />

                                <Label Text="Elige una opción para el reporte."
                                       FontSize="12"
                                       TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="✕"
                                    Clicked="OnCerrarSexoOverlayClicked"
                                    BackgroundColor="{StaticResource PrimarySoft}"
                                    TextColor="{StaticResource PrimaryColor}"
                                    FontAttributes="Bold"
                                    CornerRadius="18"
                                    WidthRequest="38"
                                    HeightRequest="38"
                                    Padding="0" />
                        </Grid>

                        <Button Text="♂️ Macho"
                                Clicked="OnSexoMachoClicked"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                TextColor="{StaticResource PrimaryDark}"
                                BorderColor="{StaticResource CardBorder}"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="48" />

                        <Button Text="♀️ Hembra"
                                Clicked="OnSexoHembraClicked"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                TextColor="{StaticResource PrimaryDark}"
                                BorderColor="{StaticResource CardBorder}"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="48" />

                        <Button Text="❔ No identificado"
                                Clicked="OnSexoNoIdentificadoClicked"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                TextColor="{StaticResource PrimaryDark}"
                                BorderColor="{StaticResource CardBorder}"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="48" />

                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
        <!-- Modal personalizado: salir sin guardar -->
        <Grid x:Name="SalirSinGuardarOverlay"
              IsVisible="False"
              Opacity="0"
              BackgroundColor="#90000000"
              Padding="22">

            <BoxView BackgroundColor="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancelarSalirOverlayTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border BackgroundColor="#FFFFFF"
                    Stroke="{StaticResource CardBorder}"
                    StrokeThickness="1"
                    Padding="20"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="#2B0B98"
                            Opacity="0.25"
                            Offset="0,8"
                            Radius="22" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16"
                                    WidthRequest="310">

                    <Border BackgroundColor="{StaticResource PrimarySoft}"
                            Stroke="Transparent"
                            WidthRequest="58"
                            HeightRequest="58"
                            HorizontalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="29" />
                        </Border.StrokeShape>

                        <Label Text="⚠️"
                               FontSize="30"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="6">

                        <Label Text="Salir sin guardar"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextMain}"
                               HorizontalTextAlignment="Center" />

                        <Label Text="¿Deseas volver? Los datos ingresados no se guardarán."
                               FontSize="14"
                               TextColor="{StaticResource TextMuted}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Border BackgroundColor="#FFF7ED"
                            Stroke="#FED7AA"
                            StrokeThickness="1"
                            Padding="12">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Label Text="Si sales ahora, perderás la información que aún no publicaste."
                               FontSize="12"
                               TextColor="#9A3412"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                    </Border>

                    <Grid ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button Grid.Column="0"
                                Text="Cancelar"
                                Clicked="OnCancelarSalirClicked"
                                BackgroundColor="#FFFFFF"
                                TextColor="{StaticResource PrimaryColor}"
                                BorderColor="{StaticResource CardBorder}"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="46" />

                        <Button Grid.Column="1"
                                Text="Sí, volver"
                                Clicked="OnConfirmarSalirClicked"
                                BackgroundColor="{StaticResource PrimaryColor}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="46" />
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>