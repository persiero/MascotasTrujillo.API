<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MascotasTrujillo.App.Views.DetalleAvistamientoPage"
    Title="Detalle del Avistamiento"
    BackgroundColor="#F5F1FF">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="16">

            <!-- Encabezado principal -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="{StaticResource CardBorder}"
                    StrokeThickness="1"
                    Padding="12,10">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="#2B0B98"
                            Opacity="0.10"
                            Offset="0,4"
                            Radius="12" />
                            </Border.Shadow>

                <Grid ColumnDefinitions="Auto,Auto,*"
                    ColumnSpacing="10">

                    <Button Grid.Column="0"
                            Text="←"
                            Clicked="OnVolverClicked"
                            BackgroundColor="{StaticResource PrimarySoft}"
                            TextColor="{StaticResource PrimaryColor}"
                            FontAttributes="Bold"
                            FontSize="22"
                            WidthRequest="42"
                            HeightRequest="42"
                            CornerRadius="21"
                            Padding="0"
                            VerticalOptions="Center" />

                    <Border Grid.Column="1"
                            BackgroundColor="{StaticResource PrimarySoft}"
                            Stroke="Transparent"
                            HeightRequest="42"
                            WidthRequest="42"
                            VerticalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="21" />
                        </Border.StrokeShape>

                        <Label Text="👀"
                               FontSize="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="2"
                                         Spacing="2"
                                         VerticalOptions="Center">

                        <Label Text="Detalle del avistamiento"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextMain}" />

                        <Label x:Name="LblReporteTitulo"
                               Text="Información registrada por la comunidad."
                               FontSize="12"
                               TextColor="{StaticResource TextMuted}"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Foto -->
            <Border BackgroundColor="#F8F5FF"
                    Stroke="{StaticResource CardBorder}"
                    StrokeThickness="1"
                    HeightRequest="270">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="#2B0B98"
                            Opacity="0.10"
                            Offset="0,4"
                            Radius="12" />
                </Border.Shadow>

                <Grid BackgroundColor="#F8F5FF">

                    <Image x:Name="FotoAvistamientoImage"
                           Aspect="AspectFit"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"
                           BackgroundColor="#F8F5FF" />

                    <Border BackgroundColor="#DCFCE7"
                            Stroke="Transparent"
                            Padding="10,5"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            Margin="12">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Label Text="Avistamiento"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#0F766E" />
                    </Border>
                </Grid>
            </Border>

            <!-- Información -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label Text="Información registrada"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />

                    <Label x:Name="LblDescripcion"
                           FontSize="14"
                           TextColor="#475569"
                           LineBreakMode="WordWrap" />

                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="10"
                          Margin="0,6,0,0">

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="📍"
                               FontSize="16" />

                        <Label x:Name="LblDireccion"
                               Grid.Row="0"
                               Grid.Column="1"
                               FontSize="13"
                               TextColor="#64748B"
                               LineBreakMode="WordWrap" />

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Text="📅"
                               FontSize="16" />

                        <Label x:Name="LblFecha"
                               Grid.Row="1"
                               Grid.Column="1"
                               FontSize="13"
                               TextColor="#64748B" />

                        <Label Grid.Row="2"
                               Grid.Column="0"
                               Text="🌎"
                               FontSize="16" />

                        <Label x:Name="LblCoordenadas"
                               Grid.Row="2"
                               Grid.Column="1"
                               FontSize="13"
                               TextColor="#64748B" />

                    </Grid>

                    <Button Text="📍 Ver ubicación en mapa"
                            Clicked="OnVerUbicacionClicked"
                            BackgroundColor="#DCFCE7"
                            TextColor="#0F766E"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="48" />

                </VerticalStackLayout>
            </Border>

            <!-- Contacto -->
            <Border x:Name="SeccionContacto"
                    BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Text="Usuario que registró el avistamiento"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#1E293B"
                               VerticalOptions="Center" />

                        <Border Grid.Column="1"
                                BackgroundColor="#EEF2FF"
                                Stroke="Transparent"
                                Padding="8,3"
                                VerticalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <Label Text="Privado"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#2B0B98" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="8">

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="👤"
                               FontSize="16" />

                        <Label x:Name="LblNombreContacto"
                               Grid.Row="0"
                               Grid.Column="1"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#334155" />

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Text="💬"
                               FontSize="16" />

                        <Label x:Name="LblTelefonoContacto"
                               Grid.Row="1"
                               Grid.Column="1"
                               FontSize="13"
                               TextColor="#64748B" />
                    </Grid>

                    <Button x:Name="BtnWhatsAppAvistamiento"
                            Text="💬 Contactar por WhatsApp"
                            Clicked="OnWhatsAppClicked"
                            BackgroundColor="#22C55E"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="48" />

                    <Label x:Name="LblContactoNoDisponible"
                           Text="Solo el dueño del reporte puede contactar al usuario que registró el avistamiento."
                           FontSize="12"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           IsVisible="False" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>