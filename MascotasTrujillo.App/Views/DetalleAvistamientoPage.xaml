<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MascotasTrujillo.App.Views.DetalleAvistamientoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalle del Avistamiento"
    BackgroundColor="#F5F1FF"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimaryDeep">#4C1D95</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="PrimarySoft2">#F3E8FF</Color>

            <Color x:Key="AccentPink">#FF4FB3</Color>
            <Color x:Key="AccentPinkSoft">#FDF2F8</Color>
            <Color x:Key="AccentPinkBorder">#F9A8D4</Color>
            <Color x:Key="AccentPinkText">#DB2777</Color>

            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextTitle">#1E1B4B</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Color x:Key="TextSecondary">#475569</Color>
            <Color x:Key="TextLight">#8A86A3</Color>

            <Color x:Key="CardBorder">#DCCBFF</Color>
            <Color x:Key="CardBorderStrong">#A855F7</Color>
            <Color x:Key="InputBorder">#D8B4FE</Color>
            <Color x:Key="InputBackground">#F8F5FF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="#E1D2FF" />
                <GradientStop Offset="0.45" Color="#EADFFF" />
                <GradientStop Offset="1.0" Color="#F4ECFF" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="14,12,14,20" Spacing="12">

                <!--  Encabezado principal  -->
                <Border
                    Padding="12,10"
                    BackgroundColor="#FCFBFF"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.55" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#6D28D9" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#6D28D9"
                            Opacity="0.26"
                            Radius="18"
                            Offset="0,7" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                        <Button
                            Grid.Column="0"
                            Padding="0"
                            BackgroundColor="{StaticResource PrimaryDark}"
                            BorderColor="#6D28D9"
                            BorderWidth="1"
                            Clicked="OnVolverClicked"
                            CornerRadius="21"
                            FontAttributes="Bold"
                            FontSize="22"
                            HeightRequest="42"
                            Text="←"
                            TextColor="White"
                            VerticalOptions="Center"
                            WidthRequest="42">

                            <Button.Shadow>
                                <Shadow
                                    Brush="#2B0B98"
                                    Opacity="0.35"
                                    Radius="10"
                                    Offset="0,4" />
                            </Button.Shadow>
                        </Button>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="2"
                            VerticalOptions="Center">

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="Detalle del avistamiento"
                                TextColor="{StaticResource PrimaryDark}" />

                            <Label
                                x:Name="LblReporteTitulo"
                                FontSize="12"
                                LineBreakMode="TailTruncation"
                                Text="Información registrada por la comunidad."
                                TextColor="#475569" />
                        </VerticalStackLayout>

                    </Grid>
                </Border>

                <!--  Foto  -->
                <Border
                    BackgroundColor="#FCFBFF"
                    HeightRequest="290"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.55" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#6D28D9" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#6D28D9"
                            Opacity="0.24"
                            Radius="16"
                            Offset="0,6" />
                    </Border.Shadow>

                    <Grid BackgroundColor="#F8F5FF">

                        <Image
                            x:Name="FotoAvistamientoImage"
                            Aspect="AspectFit"
                            BackgroundColor="#F8F5FF"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill" />

                        <Border
                            Margin="12"
                            Padding="10,5"
                            BackgroundColor="#DCFCE7"
                            HorizontalOptions="Start"
                            Stroke="Transparent"
                            VerticalOptions="Start">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="Avistamiento"
                                TextColor="#0F766E" />
                        </Border>
                    </Grid>
                </Border>

                <!--  Información  -->
                <Border
                    Padding="18"
                    BackgroundColor="#FCFBFF"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.65" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#7C3AED" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#6D28D9"
                            Opacity="0.22"
                            Radius="14"
                            Offset="0,5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <Label
                            FontAttributes="Bold"
                            FontSize="17"
                            Text="Información registrada"
                            TextColor="#1E1B4B" />

                        <Label
                            x:Name="LblDescripcion"
                            FontSize="14"
                            LineBreakMode="WordWrap"
                            TextColor="#475569" />

                        <VerticalStackLayout Margin="0,4,0,0" Spacing="8">

                            <Border
                                Padding="10"
                                BackgroundColor="#FFFFFF"
                                Stroke="#D8B4FE"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">

                                    <Label
                                        Grid.Column="0"
                                        FontSize="16"
                                        Text="📍"
                                        VerticalOptions="Center" />

                                    <Label
                                        x:Name="LblDireccion"
                                        Grid.Column="1"
                                        FontSize="13"
                                        LineBreakMode="WordWrap"
                                        TextColor="#334155" />
                                </Grid>
                            </Border>

                            <Border
                                Padding="10"
                                BackgroundColor="#FFFFFF"
                                Stroke="#D8B4FE"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">

                                    <Label
                                        Grid.Column="0"
                                        FontSize="16"
                                        Text="📅"
                                        VerticalOptions="Center" />

                                    <Label
                                        x:Name="LblFecha"
                                        Grid.Column="1"
                                        FontSize="13"
                                        TextColor="#334155" />
                                </Grid>
                            </Border>

                            <Border
                                Padding="10"
                                BackgroundColor="#FFFFFF"
                                Stroke="#D8B4FE"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">

                                    <Label
                                        Grid.Column="0"
                                        FontSize="16"
                                        Text="🌎"
                                        VerticalOptions="Center" />

                                    <Label
                                        x:Name="LblCoordenadas"
                                        Grid.Column="1"
                                        FontSize="13"
                                        TextColor="#334155" />
                                </Grid>
                            </Border>

                        </VerticalStackLayout>

                        <Button
                            BackgroundColor="{StaticResource PrimaryDark}"
                            BorderColor="#6D28D9"
                            BorderWidth="1"
                            Clicked="OnVerUbicacionClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            HeightRequest="48"
                            Text="📍 Ver ubicación en mapa"
                            TextColor="White">

                            <Button.Shadow>
                                <Shadow
                                    Brush="#2B0B98"
                                    Opacity="0.32"
                                    Radius="12"
                                    Offset="0,5" />
                            </Button.Shadow>
                        </Button>

                    </VerticalStackLayout>
                </Border>

                <!--  Contacto  -->
                <Border
                    x:Name="SeccionContacto"
                    Padding="18"
                    BackgroundColor="#FCFBFF"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.65" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#7C3AED" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#6D28D9"
                            Opacity="0.22"
                            Radius="14"
                            Offset="0,5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="Usuario que registró el avistamiento"
                                TextColor="#1E1B4B"
                                VerticalOptions="Center" />

                            <Border
                                Grid.Column="1"
                                Padding="10,4"
                                BackgroundColor="#F3E8FF"
                                Stroke="#A855F7"
                                StrokeThickness="1"
                                VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="11"
                                    Text="Privado"
                                    TextColor="{StaticResource PrimaryDark}" />
                            </Border>
                        </Grid>

                        <Border
                            Padding="10"
                            BackgroundColor="#FFFFFF"
                            Stroke="#D8B4FE"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="10"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="8">

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontSize="16"
                                    Text="👤" />

                                <Label
                                    x:Name="LblNombreContacto"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    TextColor="#1E1B4B" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    FontSize="16"
                                    Text="💬" />

                                <Label
                                    x:Name="LblTelefonoContacto"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontSize="13"
                                    TextColor="#475569" />
                            </Grid>
                        </Border>

                        <Button
                            x:Name="BtnWhatsAppAvistamiento"
                            BackgroundColor="#16A34A"
                            Clicked="OnWhatsAppClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            HeightRequest="48"
                            Text="💬 Contactar por WhatsApp"
                            TextColor="White">

                            <Button.Shadow>
                                <Shadow
                                    Brush="#22C55E"
                                    Opacity="0.30"
                                    Radius="10"
                                    Offset="0,4" />
                            </Button.Shadow>
                        </Button>

                        <Label
                            x:Name="LblContactoNoDisponible"
                            FontSize="12"
                            HorizontalTextAlignment="Center"
                            IsVisible="False"
                            LineBreakMode="WordWrap"
                            Text="Solo el dueño del reporte puede contactar al usuario que registró el avistamiento."
                            TextColor="#64748B" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>