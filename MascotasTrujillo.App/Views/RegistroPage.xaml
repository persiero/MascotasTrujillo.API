<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MascotasTrujillo.App.Views.RegistroPage"
             Title="Crear Cuenta"
             BackgroundColor="#F4F6FA">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="30" VerticalOptions="Center">

            <Label Text="Crear una cuenta" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#2B0B98" />
            <Label Text="Únete a la comunidad de rescate" FontSize="15" HorizontalOptions="Center" TextColor="#666666" Margin="0,0,0,20" />

            <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" Padding="15,5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Entry x:Name="NombreEntry" 
                       Placeholder="Nombre completo" 
                       TextColor="#333333" 
                       BackgroundColor="Transparent" />
            </Border>

            <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" Padding="15,5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Entry x:Name="EmailEntry" 
                       Placeholder="Correo electrónico" 
                       Keyboard="Email" 
                       TextColor="#333333" 
                       BackgroundColor="Transparent" />
            </Border>

            <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" Padding="15,5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Entry x:Name="TelefonoEntry" 
                       Placeholder="Teléfono (Opcional)" 
                       Keyboard="Telephone" 
                       TextColor="#333333" 
                       BackgroundColor="Transparent" />
            </Border>

            <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" Padding="15,5" Margin="0,0,0,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Entry x:Name="PasswordEntry" 
                       Placeholder="Contraseña (mínimo 6 caracteres)" 
                       IsPassword="True" 
                       TextColor="#333333" 
                       BackgroundColor="Transparent" />
            </Border>

            <Button Text="Registrarme" 
                    Clicked="OnRegistrarClicked" 
                    BackgroundColor="#2B0B98" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12" 
                    HeightRequest="55" />

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" Color="#2B0B98"/>

            <BoxView HeightRequest="1" Color="#D1D1D1" Margin="0,15" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Label Text="¿Ya tienes una cuenta?" FontSize="15" TextColor="#666666" />
                <Label Text="Inicia sesión" FontSize="15" TextColor="#2B0B98" FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVolverAlLoginTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>