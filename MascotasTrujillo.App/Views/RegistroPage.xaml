<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MascotasTrujillo.App.Views.RegistroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Crear cuenta"
    BackgroundColor="#F5F1FF"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="AccentPink">#FF4FB3</Color>
            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextMuted">#7A7F95</Color>
            <Color x:Key="CardBorder">#E1D6FF</Color>
            <Color x:Key="InputBorder">#D8CCFF</Color>
            <Color x:Key="InputBackground">#F8F5FF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="20">

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="#E1D2FF" />
                <GradientStop Offset="0.45" Color="#EADFFF" />
                <GradientStop Offset="1.0" Color="#F4ECFF" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Spacing="18">

                <Button
                    Padding="14,0"
                    BackgroundColor="#F3E8FF"
                    BorderColor="#A855F7"
                    BorderWidth="1"
                    Clicked="OnVolverAlLoginTapped"
                    CornerRadius="16"
                    FontAttributes="Bold"
                    HeightRequest="40"
                    HorizontalOptions="Start"
                    Text="← Volver"
                    TextColor="{StaticResource PrimaryDark}" />

                <!--  Logo y título  -->
                <VerticalStackLayout
                    Margin="0,0,0,4"
                    HorizontalOptions="Center"
                    Spacing="8">

                    <Border
                        Padding="12"
                        BackgroundColor="White"
                        HeightRequest="120"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        WidthRequest="120">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="60" />
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow
                                Brush="#5B21E6"
                                Opacity="0.20"
                                Radius="20"
                                Offset="0,8" />
                        </Border.Shadow>

                        <Image
                            Aspect="AspectFit"
                            HorizontalOptions="Center"
                            Source="logo_petguardian.png"
                            VerticalOptions="Center" />
                    </Border>

                    <Label
                        FontAttributes="Bold"
                        FontSize="27"
                        HorizontalTextAlignment="Center"
                        Text="Crear una cuenta"
                        TextColor="{StaticResource PrimaryDark}" />

                    <Label
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        Text="Únete a la comunidad de rescate"
                        TextColor="{StaticResource TextMuted}" />
                </VerticalStackLayout>

                <!--  Tarjeta de registro  -->
                <Border
                    Padding="18"
                    BackgroundColor="#FCFBFF"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.65" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#7C3AED" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#5B21E6"
                            Opacity="0.24"
                            Radius="26"
                            Offset="0,10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="13">

                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="Datos de acceso"
                            TextColor="{StaticResource PrimaryDark}" />

                        <!--  Nombre  -->
                        <Border
                            Padding="12,0"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="54"
                            Stroke="#A855F7"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="10"
                                VerticalOptions="Center">

                                <Border
                                    BackgroundColor="#F3E8FF"
                                    HeightRequest="30"
                                    Stroke="#D8B4FE"
                                    StrokeThickness="1"
                                    VerticalOptions="Center"
                                    WidthRequest="30">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="15" />
                                    </Border.StrokeShape>

                                    <Label
                                        FontSize="14"
                                        HorizontalOptions="Center"
                                        Text="👤"
                                        VerticalOptions="Center" />
                                </Border>

                                <Entry
                                    x:Name="NombreEntry"
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    ClearButtonVisibility="WhileEditing"
                                    Placeholder="Nombre completo"
                                    PlaceholderColor="#8C84A6"
                                    TextColor="{StaticResource TextMain}" />
                            </Grid>
                        </Border>

                        <!--  Correo  -->
                        <Border
                            Padding="12,0"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="54"
                            Stroke="#A855F7"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="10"
                                VerticalOptions="Center">

                                <Border
                                    BackgroundColor="#F3E8FF"
                                    HeightRequest="30"
                                    Stroke="#D8B4FE"
                                    StrokeThickness="1"
                                    VerticalOptions="Center"
                                    WidthRequest="30">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="15" />
                                    </Border.StrokeShape>

                                    <Label
                                        FontSize="14"
                                        HorizontalOptions="Center"
                                        Text="✉"
                                        TextColor="{StaticResource PrimaryColor}"
                                        VerticalOptions="Center" />
                                </Border>

                                <Entry
                                    x:Name="EmailEntry"
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    ClearButtonVisibility="WhileEditing"
                                    Keyboard="Email"
                                    Placeholder="Correo electrónico"
                                    PlaceholderColor="#8C84A6"
                                    TextColor="{StaticResource TextMain}" />
                            </Grid>
                        </Border>

                        <!--  Teléfono  -->
                        <Border
                            Padding="12,0"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="54"
                            Stroke="#A855F7"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="10"
                                VerticalOptions="Center">

                                <Border
                                    BackgroundColor="#F3E8FF"
                                    HeightRequest="30"
                                    Stroke="#D8B4FE"
                                    StrokeThickness="1"
                                    VerticalOptions="Center"
                                    WidthRequest="30">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="15" />
                                    </Border.StrokeShape>

                                    <Label
                                        FontSize="14"
                                        HorizontalOptions="Center"
                                        Text="💬"
                                        VerticalOptions="Center" />
                                </Border>

                                <Entry
                                    x:Name="TelefonoEntry"
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    ClearButtonVisibility="WhileEditing"
                                    Keyboard="Telephone"
                                    Placeholder="WhatsApp. Ej. 51987654321"
                                    PlaceholderColor="#8C84A6"
                                    TextColor="{StaticResource TextMain}" />
                            </Grid>
                        </Border>

                        <Border
                            Padding="10"
                            BackgroundColor="#F3E8FF"
                            Stroke="#A855F7"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                LineBreakMode="WordWrap"
                                Text="Tu WhatsApp será útil si publicas reportes o necesitas ser contactado por una mascota."
                                TextColor="{StaticResource PrimaryDark}" />
                        </Border>

                        <!--  Contraseña  -->
                        <Border
                            Padding="12,0"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="54"
                            Stroke="#A855F7"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="10"
                                VerticalOptions="Center">

                                <Border
                                    BackgroundColor="#F3E8FF"
                                    HeightRequest="30"
                                    Stroke="#D8B4FE"
                                    StrokeThickness="1"
                                    VerticalOptions="Center"
                                    WidthRequest="30">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="15" />
                                    </Border.StrokeShape>

                                    <Label
                                        FontSize="13"
                                        HorizontalOptions="Center"
                                        Text="🔒"
                                        VerticalOptions="Center" />
                                </Border>

                                <Entry
                                    x:Name="PasswordEntry"
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    IsPassword="True"
                                    Placeholder="Contraseña"
                                    PlaceholderColor="#8C84A6"
                                    TextColor="{StaticResource TextMain}" />

                                <Button
                                    x:Name="BtnTogglePassword"
                                    Grid.Column="2"
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    Clicked="OnTogglePasswordClicked"
                                    FontSize="15"
                                    HeightRequest="34"
                                    Text="👁"
                                    TextColor="{StaticResource TextMuted}"
                                    WidthRequest="34" />
                            </Grid>
                        </Border>

                        <!--  Confirmar contraseña  -->
                        <Border
                            Padding="12,0"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="54"
                            Stroke="#A855F7"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="10"
                                VerticalOptions="Center">

                                <Border
                                    BackgroundColor="#F3E8FF"
                                    HeightRequest="30"
                                    Stroke="#D8B4FE"
                                    StrokeThickness="1"
                                    VerticalOptions="Center"
                                    WidthRequest="30">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="15" />
                                    </Border.StrokeShape>

                                    <Label
                                        FontSize="13"
                                        HorizontalOptions="Center"
                                        Text="✅"
                                        VerticalOptions="Center" />
                                </Border>

                                <Entry
                                    x:Name="ConfirmarPasswordEntry"
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    IsPassword="True"
                                    Placeholder="Confirmar contraseña"
                                    PlaceholderColor="#8C84A6"
                                    TextColor="{StaticResource TextMain}" />

                                <Button
                                    x:Name="BtnToggleConfirmarPassword"
                                    Grid.Column="2"
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    Clicked="OnToggleConfirmarPasswordClicked"
                                    FontSize="15"
                                    HeightRequest="34"
                                    Text="👁"
                                    TextColor="{StaticResource TextMuted}"
                                    WidthRequest="34" />
                            </Grid>
                        </Border>

                        <Border
                            Padding="10"
                            BackgroundColor="#F3E8FF"
                            Stroke="#A855F7"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">

                                <CheckBox
                                    x:Name="AceptaTerminosCheckBox"
                                    Grid.Column="0"
                                    Margin="-6,-6,0,0"
                                    VerticalOptions="Start"
                                    Color="{StaticResource PrimaryColor}" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="12"
                                    LineBreakMode="WordWrap"
                                    Text="Acepto que mis datos de contacto se usen para funciones de rescate y comunicación dentro de Pet Guardian 365."
                                    TextColor="{StaticResource PrimaryDark}"
                                    VerticalOptions="Center" />

                            </Grid>
                        </Border>

                        <Button
                            x:Name="BtnRegistrar"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            Clicked="OnRegistrarClicked"
                            CornerRadius="22"
                            FontAttributes="Bold"
                            FontSize="16"
                            HeightRequest="56"
                            Text="Crear cuenta"
                            TextColor="White">

                            <Button.Shadow>
                                <Shadow
                                    Brush="#5B21E6"
                                    Opacity="0.44"
                                    Radius="12"
                                    Offset="0,5" />
                            </Button.Shadow>
                        </Button>

                        <ActivityIndicator
                            x:Name="LoadingIndicator"
                            IsRunning="False"
                            IsVisible="False"
                            Color="{StaticResource PrimaryColor}" />

                    </VerticalStackLayout>
                </Border>

                <!--  Login  -->
                <HorizontalStackLayout
                    Margin="0,2,0,0"
                    HorizontalOptions="Center"
                    Spacing="5">

                    <Label
                        FontSize="13"
                        Text="¿Ya tienes una cuenta?"
                        TextColor="{StaticResource TextMuted}" />

                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        Text="Inicia sesión"
                        TextColor="{StaticResource PrimaryColor}">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVolverAlLoginTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>