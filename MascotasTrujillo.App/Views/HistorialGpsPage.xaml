<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MascotasTrujillo.App.Views.HistorialGpsPage"
    Title="Historial GPS"
    BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,*"
          Padding="18"
          RowSpacing="14">

        <!-- Encabezado -->
        <Border Grid.Row="0"
                BackgroundColor="#FFFFFF"
                Stroke="Transparent"
                Padding="16">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="Black"
                        Opacity="0.06"
                        Offset="0,3"
                        Radius="8" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="12">

                <Border Grid.Column="0"
                        BackgroundColor="#EEF2FF"
                        Stroke="Transparent"
                        HeightRequest="50"
                        WidthRequest="50"
                        VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="25" />
                    </Border.StrokeShape>

                    <Label Text="📍"
                           FontSize="25"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="3"
                                     VerticalOptions="Center">

                    <Label x:Name="LblTitulo"
                           Text="Historial GPS"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#1E1B4B" />

                    <Label x:Name="LblSubtitulo"
                           Text="Últimas ubicaciones registradas por el collar GPS."
                           FontSize="12"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

            </Grid>
        </Border>

        <!-- Lista -->
        <CollectionView Grid.Row="1"
                        x:Name="HistorialList"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="30"
                                     Spacing="8"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">

                    <Label Text="📡"
                           FontSize="42"
                           HorizontalOptions="Center" />

                    <Label Text="Sin historial GPS"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="#334155"
                           HorizontalOptions="Center" />

                    <Label Text="Cuando el collar GPS envíe ubicaciones, aparecerán aquí."
                           FontSize="13"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border Margin="0,0,0,12"
                            Padding="14"
                            BackgroundColor="#FFFFFF"
                            Stroke="Transparent">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow Brush="Black"
                                    Opacity="0.06"
                                    Offset="0,2"
                                    Radius="7" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="8">

                            <Grid ColumnDefinitions="*,Auto">

                                <Label Text="{Binding CodigoDispositivoTexto}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1E293B" />

                                <Border Grid.Column="1"
                                        BackgroundColor="#DCFCE7"
                                        Stroke="Transparent"
                                        Padding="8,3">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>

                                    <Label Text="Ubicación"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#0F766E" />
                                </Border>
                            </Grid>

                            <Label Text="{Binding FechaTexto}"
                                   FontSize="13"
                                   TextColor="#64748B" />

                            <Label Text="{Binding BateriaTexto}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#0F766E" />

                            <Label Text="{Binding CoordenadasTexto}"
                                   FontSize="12"
                                   TextColor="#94A3B8"
                                   LineBreakMode="TailTruncation" />

                            <Button Text="📍 Ver en mapa"
                                    Clicked="OnVerMapaClicked"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#EEF2FF"
                                    TextColor="#2B0B98"
                                    FontAttributes="Bold"
                                    CornerRadius="14"
                                    HeightRequest="42" />

                        </VerticalStackLayout>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>