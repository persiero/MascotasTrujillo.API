<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MascotasTrujillo.App.Views.LoginPage"
    Title="Iniciar sesión"
    BackgroundColor="#F5F1FF">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- Colores principales del logo -->
            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="AccentPink">#FF4FB3</Color>

            <!-- Neutros -->
            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextMuted">#7A7F95</Color>
            <Color x:Key="CardBorder">#E1D6FF</Color>
            <Color x:Key="InputBorder">#D8CCFF</Color>
            <Color x:Key="InputBackground">#F8F5FF</Color>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="24">

        <!-- Fondo suave con degradado -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F8F5FF" Offset="0.0" />
                <GradientStop Color="#F3EDFF" Offset="0.55" />
                <GradientStop Color="#FDFBFF" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Spacing="22"
                                 VerticalOptions="Center">

                <!-- Logo y marca -->
                <VerticalStackLayout Spacing="10"
                                     HorizontalOptions="Center"
                                     Margin="0,8,0,4">

                    <Border HeightRequest="145"
                            WidthRequest="145"
                            BackgroundColor="White"
                            Stroke="#E9DDFF"
                            StrokeThickness="1"
                            Padding="12">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="73" />
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow Brush="#5B21E6"
                                    Opacity="0.22"
                                    Offset="0,8"
                                    Radius="22" />
                        </Border.Shadow>

                        <Image Source="logo_petguardian.png"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="Pet Guardian 365"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryDark}"
                           HorizontalOptions="Center" />

                    <Label Text="Protege y localiza a tu mascota"
                           FontSize="13"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Tarjeta principal -->
                <Border BackgroundColor="White"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="18"
                        Margin="0,4,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.13"
                                Offset="0,8"
                                Radius="22" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">

                        <!-- Campo correo -->
                        <Border Stroke="{StaticResource InputBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource InputBackground}"
                                Padding="12,0"
                                HeightRequest="56">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10"
                                  VerticalOptions="Center">

                                <Border WidthRequest="30"
                                        HeightRequest="30"
                                        BackgroundColor="{StaticResource PrimarySoft}"
                                        Stroke="Transparent"
                                        VerticalOptions="Center">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="15" />
                                    </Border.StrokeShape>

                                    <Label Text="✉"
                                           FontSize="14"
                                           TextColor="{StaticResource PrimaryColor}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <Entry x:Name="EmailEntry"
                                       Grid.Column="1"
                                       Placeholder="Correo electrónico"
                                       PlaceholderColor="#8C84A6"
                                       Keyboard="Email"
                                       ReturnType="Next"
                                       TextColor="{StaticResource TextMain}"
                                       BackgroundColor="Transparent"
                                       ClearButtonVisibility="WhileEditing" />
                            </Grid>
                        </Border>

                        <!-- Campo contraseña -->
                        <Border Stroke="{StaticResource InputBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource InputBackground}"
                                Padding="12,0"
                                HeightRequest="56">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="10"
                                  VerticalOptions="Center">

                                <Border WidthRequest="30"
                                        HeightRequest="30"
                                        BackgroundColor="{StaticResource PrimarySoft}"
                                        Stroke="Transparent"
                                        VerticalOptions="Center">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="15" />
                                    </Border.StrokeShape>

                                    <Label Text="🔒"
                                           FontSize="13"
                                           TextColor="{StaticResource PrimaryColor}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <Entry x:Name="PasswordEntry"
                                       Grid.Column="1"
                                       Placeholder="Contraseña"
                                       PlaceholderColor="#8C84A6"
                                       IsPassword="True"
                                       ReturnType="Go"
                                       Completed="OnLoginClicked"
                                       TextColor="{StaticResource TextMain}"
                                       BackgroundColor="Transparent" />

                                <Button x:Name="BtnTogglePassword"
                                        Grid.Column="2"
                                        Text="👁"
                                        Clicked="OnTogglePasswordClicked"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextMuted}"
                                        FontSize="15"
                                        Padding="0"
                                        WidthRequest="34"
                                        HeightRequest="34" />
                            </Grid>
                        </Border>

                        <!-- Recuperar contraseña -->
                        <Label Text="¿Olvidaste tu contraseña?"
                               FontSize="13"
                               TextColor="{StaticResource PrimaryColor}"
                               FontAttributes="Bold"
                               HorizontalOptions="End"
                               Margin="0,0,0,4">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOlvidastePasswordTapped" />
                            </Label.GestureRecognizers>
                        </Label>

                        <!-- Botón principal -->
                        <Button x:Name="BtnLogin"
                                Text="Iniciar sesión"
                                Clicked="OnLoginClicked"
                                BackgroundColor="{StaticResource PrimaryColor}"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"
                                CornerRadius="18"
                                HeightRequest="56">

                            <Button.Shadow>
                                <Shadow Brush="#5B21E6"
                                        Opacity="0.28"
                                        Offset="0,5"
                                        Radius="12" />
                            </Button.Shadow>
                        </Button>

                        <ActivityIndicator x:Name="LoadingIndicator"
                                           IsRunning="False"
                                           IsVisible="False"
                                           Color="{StaticResource PrimaryColor}" />

                    </VerticalStackLayout>
                </Border>

                <!-- Registro -->
                <HorizontalStackLayout HorizontalOptions="Center"
                                       Spacing="5"
                                       Margin="0,2,0,0">

                    <Label Text="¿No tienes cuenta?"
                           FontSize="13"
                           TextColor="{StaticResource TextMuted}" />

                    <Label Text="Crear cuenta"
                           FontSize="13"
                           TextColor="{StaticResource PrimaryColor}"
                           FontAttributes="Bold">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegistrarseTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>