<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MascotasTrujillo.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Iniciar sesión"
    BackgroundColor="#E4D6FF">

    <ContentPage.Resources>
        <ResourceDictionary>

            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimaryDeep">#4C1D95</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="PrimarySoft2">#F3E8FF</Color>

            <Color x:Key="PageBackground">#F1E8FF</Color>
            <Color x:Key="PageBackgroundLight">#F5F0FF</Color>

            <Color x:Key="CardBackground">#FCFBFF</Color>
            <Color x:Key="CardBorder">#DCCBFF</Color>
            <Color x:Key="CardBorderStrong">#C084FC</Color>

            <Color x:Key="InputBorder">#D8B4FE</Color>
            <Color x:Key="InputBackground">#FFFFFF</Color>

            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextTitle">#1E1B4B</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Color x:Key="TextSecondary">#475569</Color>
            <Color x:Key="TextLight">#8A86A3</Color>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="24,18,24,18">

        <!--  Fondo principal más morado y con mejor contraste  -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="#E4D6FF" />
                <GradientStop Offset="0.45" Color="#EFE3FF" />
                <GradientStop Offset="1.0" Color="#F8F2FF" />
            </LinearGradientBrush>
        </Grid.Background>

        <!--  Decoración superior izquierda  -->
        <Ellipse
            Fill="#7C3AED"
            HeightRequest="285"
            HorizontalOptions="Start"
            Opacity="0.18"
            TranslationX="-135"
            TranslationY="-120"
            VerticalOptions="Start"
            WidthRequest="285" />

        <!--  Decoración superior derecha  -->
        <Ellipse
            Fill="#FF4FB3"
            HeightRequest="235"
            HorizontalOptions="End"
            Opacity="0.13"
            TranslationX="105"
            TranslationY="-90"
            VerticalOptions="Start"
            WidthRequest="235" />

        <!--  Decoración inferior derecha  -->
        <Ellipse
            Fill="#5B21E6"
            HeightRequest="290"
            HorizontalOptions="End"
            Opacity="0.11"
            TranslationX="135"
            TranslationY="130"
            VerticalOptions="End"
            WidthRequest="290" />

        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Spacing="22" VerticalOptions="Center">

                <!--  Logo y marca  -->
                <VerticalStackLayout
                    Margin="0,8,0,2"
                    HorizontalOptions="Center"
                    Spacing="10">

                    <Border
                        Padding="12"
                        BackgroundColor="#FFFFFF"
                        HeightRequest="155"
                        Stroke="#F3E8FF"
                        StrokeThickness="2"
                        WidthRequest="155">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="78" />
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow
                                Brush="#5B21E6"
                                Opacity="0.36"
                                Radius="30"
                                Offset="0,12" />
                        </Border.Shadow>

                        <Grid>
                            <Ellipse Fill="#F3E8FF" Opacity="0.95" />

                            <Image
                                Aspect="AspectFit"
                                HorizontalOptions="Center"
                                Source="logo_petguardian.png"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label
                        FontAttributes="Bold"
                        FontSize="23"
                        HorizontalOptions="Center"
                        Text="Pet Guardian 365"
                        TextColor="{StaticResource PrimaryDark}" />

                    <Label
                        FontSize="14"
                        HorizontalOptions="Center"
                        Text="Localiza a tu mascota en tiempo real"
                        TextColor="#5F5876" />
                </VerticalStackLayout>

                <!--  Tarjeta principal  -->
                <Border
                    Margin="0,8,0,0"
                    Padding="20,22"
                    BackgroundColor="#FFFCFF"
                    StrokeThickness="1.6">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.55" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#6D28D9" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#5B21E6"
                            Opacity="0.28"
                            Radius="30"
                            Offset="0,12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Margin="0,0,0,6" Spacing="4">

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="Bienvenido de nuevo"
                                TextColor="{StaticResource TextTitle}" />

                            <Label
                                FontSize="12"
                                LineBreakMode="WordWrap"
                                Text="Ingresa para ver tus mascotas, reportes y ubicación GPS."
                                TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>

                        <!--  Campo correo  -->
                        <Border
                            Margin="0,0,0,2"
                            Padding="12,0"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="56"
                            StrokeThickness="1.2">

                            <Border.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0.0" Color="#E9D5FF" />
                                    <GradientStop Offset="0.55" Color="#C084FC" />
                                    <GradientStop Offset="1.0" Color="#9333EA" />
                                </LinearGradientBrush>
                            </Border.Stroke>

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Border.Shadow>
                                <Shadow
                                    Brush="#7C3AED"
                                    Opacity="0.14"
                                    Radius="12"
                                    Offset="0,4" />
                            </Border.Shadow>

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="12"
                                VerticalOptions="Center">

                                <Border
                                    BackgroundColor="#EEE7FF"
                                    HeightRequest="35"
                                    Stroke="#C084FC"
                                    StrokeThickness="1"
                                    VerticalOptions="Center"
                                    WidthRequest="35">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>

                                    <Label
                                        FontSize="17"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Text="✉"
                                        TextColor="#5B21E6"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />
                                </Border>

                                <Entry
                                    x:Name="EmailEntry"
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    ClearButtonVisibility="WhileEditing"
                                    Keyboard="Email"
                                    Placeholder="Correo electrónico"
                                    PlaceholderColor="#6B647F"
                                    ReturnType="Next"
                                    TextColor="{StaticResource TextMain}" />
                            </Grid>
                        </Border>

                        <!--  Campo contraseña  -->
                        <Border
                            Margin="0,0,0,2"
                            Padding="12,0"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="56"
                            StrokeThickness="1.2">

                            <Border.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0.0" Color="#E9D5FF" />
                                    <GradientStop Offset="0.55" Color="#C084FC" />
                                    <GradientStop Offset="1.0" Color="#9333EA" />
                                </LinearGradientBrush>
                            </Border.Stroke>

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Border.Shadow>
                                <Shadow
                                    Brush="#7C3AED"
                                    Opacity="0.14"
                                    Radius="12"
                                    Offset="0,4" />
                            </Border.Shadow>

                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">

                                <Border
                                    BackgroundColor="#EEE7FF"
                                    HeightRequest="35"
                                    Stroke="#C084FC"
                                    StrokeThickness="1"
                                    VerticalOptions="Center"
                                    WidthRequest="35">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>

                                    <Label
                                        FontSize="15"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Text="🔒"
                                        TextColor="#5B21E6"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />
                                </Border>

                                <Entry
                                    x:Name="PasswordEntry"
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    Completed="OnLoginClicked"
                                    IsPassword="True"
                                    Placeholder="Contraseña"
                                    PlaceholderColor="#6B647F"
                                    ReturnType="Go"
                                    TextColor="{StaticResource TextMain}" />

                                <Button
                                    x:Name="BtnTogglePassword"
                                    Grid.Column="2"
                                    Padding="0"
                                    BackgroundColor="#EEE7FF"
                                    BorderColor="#C084FC"
                                    BorderWidth="1"
                                    Clicked="OnTogglePasswordClicked"
                                    CornerRadius="18"
                                    FontSize="14"
                                    HeightRequest="35"
                                    Text="👁"
                                    TextColor="#5B21E6"
                                    VerticalOptions="Center"
                                    WidthRequest="35" />
                            </Grid>
                        </Border>

                        <!--  Recuperar contraseña  -->
                        <Label
                            Margin="0,0,0,4"
                            FontAttributes="Bold"
                            FontSize="13"
                            HorizontalOptions="End"
                            Text="¿Olvidaste tu contraseña?"
                            TextColor="{StaticResource PrimaryColor}">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOlvidastePasswordTapped" />
                            </Label.GestureRecognizers>
                        </Label>

                        <!--  Botón principal  -->
                        <Button
                            x:Name="BtnLogin"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            Clicked="OnLoginClicked"
                            CornerRadius="22"
                            FontAttributes="Bold"
                            FontSize="16"
                            HeightRequest="58"
                            Text="Entrar a mi cuenta"
                            TextColor="White">

                            <Button.Shadow>
                                <Shadow
                                    Brush="{StaticResource PrimaryColor}"
                                    Opacity="0.44"
                                    Radius="18"
                                    Offset="0,8" />
                            </Button.Shadow>
                        </Button>

                        <ActivityIndicator
                            x:Name="LoadingIndicator"
                            IsRunning="False"
                            IsVisible="False"
                            Color="{StaticResource PrimaryColor}" />

                    </VerticalStackLayout>
                </Border>

                <!--  Registro  -->
                <HorizontalStackLayout
                    Margin="0,8,0,0"
                    HorizontalOptions="Center"
                    Spacing="5">

                    <Label
                        FontSize="14"
                        Text="¿No tienes cuenta?"
                        TextColor="#5F5876" />

                    <Label
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="Crear cuenta"
                        TextColor="{StaticResource PrimaryColor}">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegistrarseTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>