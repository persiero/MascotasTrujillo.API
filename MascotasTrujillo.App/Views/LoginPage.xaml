<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MascotasTrujillo.App.Views.LoginPage"
    Title="Iniciar sesión"
    BackgroundColor="#F5F1FF">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- Colores principales del logo -->
            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="AccentPink">#FF4FB3</Color>

            <!-- Neutros -->
            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextMuted">#7A7F95</Color>
            <Color x:Key="CardBorder">#E1D6FF</Color>
            <Color x:Key="InputBorder">#D8CCFF</Color>
            <Color x:Key="InputBackground">#F8F5FF</Color>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="24,18,24,18">

        <!-- Fondo suave con degradado -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E8DEF8" Offset="0.0" />
                <GradientStop Color="#EFE7FB" Offset="0.45" />
                <GradientStop Color="#F5F1FC" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Decoración superior -->
        <Ellipse WidthRequest="260"
                 HeightRequest="260"
                 Fill="#8B5CF6"
                 Opacity="0.14"
                 HorizontalOptions="Start"
                 VerticalOptions="Start"
                 TranslationX="-120"
                 TranslationY="-110" />

        <Ellipse WidthRequest="220"
                 HeightRequest="220"
                 Fill="#F472B6"
                 Opacity="0.10"
                 HorizontalOptions="End"
                 VerticalOptions="Start"
                 TranslationX="95"
                 TranslationY="-80" />

        <Ellipse WidthRequest="260"
                 HeightRequest="260"
                 Fill="#A855F7"
                 Opacity="0.09"
                 HorizontalOptions="End"
                 VerticalOptions="End"
                 TranslationX="120"
                 TranslationY="120" />

        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Spacing="22"
                                 VerticalOptions="Center">

                <!-- Logo y marca -->
                <VerticalStackLayout Spacing="10"
                                     HorizontalOptions="Center"
                                     Margin="0,8,0,4">

                    <Border HeightRequest="155"
                            WidthRequest="155"
                            BackgroundColor="#FFFFFF"
                            Stroke="#FFFFFF"
                            StrokeThickness="2"
                            Padding="12">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="78" />
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow Brush="#5B21E6"
                                    Opacity="0.30"
                                    Offset="0,10"
                                    Radius="28" />
                        </Border.Shadow>

                        <Grid>
                            <Ellipse Fill="#F3EDFF"
                                    Opacity="0.75" />

                            <Image Source="logo_petguardian.png"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label Text="Pet Guardian 365"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#2B0B98"
                           HorizontalOptions="Center" />

                    <Label Text="Localiza a tu mascota en tiempo real"
                           FontSize="14"
                           TextColor="#7A7298"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Tarjeta principal -->
                <Border BackgroundColor="#FCFBFF"
                        StrokeThickness="1"
                        Padding="20,22"
                        Margin="0,8,0,0">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E9D8FD" Offset="0.0" />
                            <GradientStop Color="#C084FC" Offset="0.55" />
                            <GradientStop Color="#A855F7" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#6D28D9"
                                Opacity="0.22"
                                Offset="0,10"
                                Radius="26" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="3"
                                            Margin="0,0,0,6">

                            <Label Text="Bienvenido de nuevo"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextMain}" />

                            <Label Text="Ingresa para ver tus mascotas, reportes y ubicación GPS."
                                   FontSize="12"
                                   TextColor="{StaticResource TextMuted}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <!-- Campo correo -->
                        <Border BackgroundColor="#FFFFFF"
                                StrokeThickness="1"
                                Padding="12,0"
                                HeightRequest="56"
                                Margin="0,0,0,2">

                            <Border.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EEE7FF" Offset="0.0" />
                                    <GradientStop Color="#D8B4FE" Offset="0.55" />
                                    <GradientStop Color="#C084FC" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Stroke>

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Border.Shadow>
                                <Shadow Brush="#8B5CF6"
                                        Opacity="0.10"
                                        Offset="0,4"
                                        Radius="10" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="12"
                                  VerticalOptions="Center">

                                <Border WidthRequest="34"
                                        HeightRequest="34"
                                        BackgroundColor="#F3E8FF"
                                        Stroke="#E9D5FF"
                                        StrokeThickness="1"
                                        VerticalOptions="Center">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="17" />
                                    </Border.StrokeShape>

                                    <Label Text="✉"
                                           FontSize="17"
                                           TextColor="#6D28D9"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>

                                <Entry x:Name="EmailEntry"
                                       Grid.Column="1"
                                       Placeholder="Correo electrónico"
                                       PlaceholderColor="#7B728F"
                                       Keyboard="Email"
                                       ReturnType="Next"
                                       TextColor="{StaticResource TextMain}"
                                       BackgroundColor="Transparent"
                                       ClearButtonVisibility="WhileEditing" />
                            </Grid>
                        </Border>

                        <!-- Campo contraseña -->
                        <Border BackgroundColor="#FFFFFF"
                                StrokeThickness="1"
                                Padding="12,0"
                                HeightRequest="56"
                                Margin="0,0,0,2">

                            <Border.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EEE7FF" Offset="0.0" />
                                    <GradientStop Color="#D8B4FE" Offset="0.55" />
                                    <GradientStop Color="#C084FC" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Stroke>

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Border.Shadow>
                                <Shadow Brush="#8B5CF6"
                                        Opacity="0.10"
                                        Offset="0,4"
                                        Radius="10" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="12"
                                  VerticalOptions="Center">

                                <Border WidthRequest="34"
                                        HeightRequest="34"
                                        BackgroundColor="#F3E8FF"
                                        Stroke="#E9D5FF"
                                        StrokeThickness="1"
                                        VerticalOptions="Center">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="17" />
                                    </Border.StrokeShape>

                                    <Label Text="🔒"
                                           FontSize="15"
                                           TextColor="#6D28D9"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>

                                <Entry x:Name="PasswordEntry"
                                       Grid.Column="1"
                                       Placeholder="Contraseña"
                                       PlaceholderColor="#7B728F"
                                       IsPassword="True"
                                       ReturnType="Go"
                                       Completed="OnLoginClicked"
                                       TextColor="{StaticResource TextMain}"
                                       BackgroundColor="Transparent" />

                                <Button x:Name="BtnTogglePassword"
                                        Grid.Column="2"
                                        Text="👁"
                                        Clicked="OnTogglePasswordClicked"
                                        BackgroundColor="#F3E8FF"
                                        TextColor="#6D28D9"
                                        FontSize="14"
                                        Padding="0"
                                        WidthRequest="34"
                                        HeightRequest="34"
                                        CornerRadius="17"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Recuperar contraseña -->
                        <Label Text="¿Olvidaste tu contraseña?"
                               FontSize="13"
                               TextColor="{StaticResource PrimaryColor}"
                               FontAttributes="Bold"
                               HorizontalOptions="End"
                               Margin="0,0,0,4">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOlvidastePasswordTapped" />
                            </Label.GestureRecognizers>
                        </Label>

                        <!-- Botón principal -->
                        <Button x:Name="BtnLogin"
                                Text="Entrar a mi cuenta"
                                Clicked="OnLoginClicked"
                                BackgroundColor="#5B21E6"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"
                                CornerRadius="22"
                                HeightRequest="58">

                            <Button.Shadow>
                                <Shadow Brush="#5B21E6"
                                        Opacity="0.38"
                                        Offset="0,7"
                                        Radius="16" />
                            </Button.Shadow>
                        </Button>

                        <ActivityIndicator x:Name="LoadingIndicator"
                                           IsRunning="False"
                                           IsVisible="False"
                                           Color="{StaticResource PrimaryColor}" />

                    </VerticalStackLayout>
                </Border>

                <!-- Registro -->
                <HorizontalStackLayout HorizontalOptions="Center"
                                       Spacing="5"
                                       Margin="0,8,0,0">

                    <Label Text="¿No tienes cuenta?"
                           FontSize="14"
                           TextColor="#7B7694" />

                    <Label Text="Crear cuenta"
                           FontSize="14"
                           TextColor="#5B21E6"
                           FontAttributes="Bold">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegistrarseTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>