<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MascotasTrujillo.App.Views.LoginPage"
             Title="Iniciar Sesión"
             BackgroundColor="#F4F6FA">
    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="30" VerticalOptions="Center">

            <Image Source="https://cdn-icons-png.flaticon.com/512/2171/2171990.png"
                   HeightRequest="130"
                   HorizontalOptions="Center"
                   Margin="0,10,0,10" />

            <Label Text="Mascotas Trujillo" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#2B0B98" />
            <Label Text="Ayudando a que regresen a casa" FontSize="15" HorizontalOptions="Center" TextColor="#666666" Margin="0,0,0,20" />

            <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" Padding="15,5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Entry x:Name="EmailEntry" 
                       Placeholder="Correo electrónico" 
                       Keyboard="Email" 
                       Text="percyrojasrod@gmail.com" 
                       TextColor="#333333" 
                       BackgroundColor="Transparent" />
            </Border>

            <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" Padding="15,5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Entry x:Name="PasswordEntry" 
                       Placeholder="Contraseña" 
                       IsPassword="True" 
                       TextColor="#333333" 
                       BackgroundColor="Transparent" />
            </Border>

            <Label Text="¿Olvidaste tu contraseña?" 
                   FontSize="14" 
                   TextColor="#2B0B98" 
                   FontAttributes="Bold" 
                   HorizontalOptions="End" 
                   Margin="0,5,0,20">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOlvidastePasswordTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Button Text="Entrar al Sistema" 
                    Clicked="OnLoginClicked" 
                    BackgroundColor="#2B0B98" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12" 
                    HeightRequest="55" />

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" Color="#2B0B98"/>

            <BoxView HeightRequest="1" Color="#D1D1D1" Margin="0,15" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Label Text="¿No tienes una cuenta?" FontSize="15" TextColor="#666666" />
                <Label Text="Regístrate aquí" FontSize="15" TextColor="#2B0B98" FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRegistrarseTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>