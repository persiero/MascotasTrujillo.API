<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MascotasTrujillo.App.Views.LoginPage"
    Title="Iniciar sesión"
    BackgroundColor="#F7F5FF">

    <ContentPage.Resources>
        <ResourceDictionary>

            <Color x:Key="PrimaryColor">#4B14D1</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="AccentPink">#FF4FB3</Color>
            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextMuted">#7A7F95</Color>
            <Color x:Key="BorderSoft">#E7E2F7</Color>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*"
          Padding="24">

        <ScrollView VerticalOptions="Center">

            <VerticalStackLayout Spacing="22"
                                 VerticalOptions="Center">

                <!-- Logo y nombre -->
                <VerticalStackLayout Spacing="10"
                                     HorizontalOptions="Center"
                                     Margin="0,10,0,6">

                    <Border HeightRequest="150"
                            WidthRequest="150"
                            BackgroundColor="White"
                            Stroke="Transparent"
                            Padding="12">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="75" />
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow Brush="#4B14D1"
                                    Opacity="0.18"
                                    Offset="0,8"
                                    Radius="18" />
                        </Border.Shadow>

                        <Image Source="logo_petguardian.png"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="Pet Guardian 365"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryDark}"
                           HorizontalOptions="Center" />

                    <Label Text="Protege y localiza a tu mascota"
                           FontSize="13"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Tarjeta de login -->
                <Border BackgroundColor="White"
                        Stroke="Transparent"
                        Padding="18"
                        Margin="0,6,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="Black"
                                Opacity="0.08"
                                Offset="0,6"
                                Radius="18" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">

                        <!-- Email -->
                        <Border Stroke="{StaticResource BorderSoft}"
                                StrokeThickness="1"
                                BackgroundColor="#FAFAFF"
                                Padding="14,0"
                                HeightRequest="54">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10"
                                  VerticalOptions="Center">

                                <Label Text="✉"
                                       FontSize="18"
                                       TextColor="{StaticResource PrimaryColor}"
                                       VerticalOptions="Center" />

                                <Entry x:Name="EmailEntry"
                                       Grid.Column="1"
                                       Placeholder="Correo electrónico"
                                       PlaceholderColor="#A3A3B8"
                                       Keyboard="Email"
                                       ReturnType="Next"
                                       TextColor="{StaticResource TextMain}"
                                       BackgroundColor="Transparent"
                                       ClearButtonVisibility="WhileEditing" />
                            </Grid>
                        </Border>

                        <!-- Password -->
                        <Border Stroke="{StaticResource BorderSoft}"
                                StrokeThickness="1"
                                BackgroundColor="#FAFAFF"
                                Padding="14,0"
                                HeightRequest="54">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="10"
                                  VerticalOptions="Center">

                                <Label Text="🔒"
                                       FontSize="18"
                                       TextColor="{StaticResource PrimaryColor}"
                                       VerticalOptions="Center" />

                                <Entry x:Name="PasswordEntry"
                                       Grid.Column="1"
                                       Placeholder="Contraseña"
                                       PlaceholderColor="#A3A3B8"
                                       IsPassword="True"
                                       ReturnType="Go"
                                       Completed="OnLoginClicked"
                                       TextColor="{StaticResource TextMain}"
                                       BackgroundColor="Transparent" />

                                <Button x:Name="BtnTogglePassword"
                                        Grid.Column="2"
                                        Text="👁"
                                        Clicked="OnTogglePasswordClicked"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextMuted}"
                                        FontSize="16"
                                        Padding="0"
                                        WidthRequest="34"
                                        HeightRequest="34" />
                            </Grid>
                        </Border>

                        <!-- Olvidé contraseña -->
                        <Label Text="¿Olvidaste tu contraseña?"
                               FontSize="13"
                               TextColor="{StaticResource PrimaryColor}"
                               FontAttributes="Bold"
                               HorizontalOptions="End"
                               Margin="0,0,0,4">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOlvidastePasswordTapped" />
                            </Label.GestureRecognizers>
                        </Label>

                        <!-- Botón principal -->
                        <Button x:Name="BtnLogin"
                                Text="Iniciar sesión"
                                Clicked="OnLoginClicked"
                                BackgroundColor="{StaticResource PrimaryColor}"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"
                                CornerRadius="18"
                                HeightRequest="54" />

                        <ActivityIndicator x:Name="LoadingIndicator"
                                           IsRunning="False"
                                           IsVisible="False"
                                           Color="{StaticResource PrimaryColor}" />

                    </VerticalStackLayout>
                </Border>

                <!-- Registro -->
                <HorizontalStackLayout HorizontalOptions="Center"
                                       Spacing="5"
                                       Margin="0,4,0,0">

                    <Label Text="¿No tienes cuenta?"
                           FontSize="13"
                           TextColor="{StaticResource TextMuted}" />

                    <Label Text="Crear cuenta"
                           FontSize="13"
                           TextColor="{StaticResource PrimaryColor}"
                           FontAttributes="Bold">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegistrarseTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>