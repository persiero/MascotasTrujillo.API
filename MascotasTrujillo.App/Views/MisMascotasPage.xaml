<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MascotasTrujillo.App.Views.MisMascotasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MascotasTrujillo.App.Views.Controls"
    xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
    Title="Mis Mascotas"
    BackgroundColor="#F5F1FF"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimaryDeep">#4C1D95</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="PrimarySoft2">#F3E8FF</Color>

            <Color x:Key="AccentPink">#FF4FB3</Color>
            <Color x:Key="AccentPinkSoft">#FDF2F8</Color>
            <Color x:Key="AccentPinkBorder">#F9A8D4</Color>
            <Color x:Key="AccentPinkText">#DB2777</Color>

            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextTitle">#1E1B4B</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Color x:Key="TextSecondary">#475569</Color>
            <Color x:Key="TextLight">#8A86A3</Color>

            <Color x:Key="CardBorder">#DCCBFF</Color>
            <Color x:Key="CardBorderStrong">#A855F7</Color>
            <Color x:Key="InputBorder">#D8B4FE</Color>
            <Color x:Key="InputBackground">#F8F5FF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <Grid
            Grid.Row="0"
            Padding="12,12,12,0"
            RowDefinitions="Auto,Auto,*,Auto"
            RowSpacing="10">

            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0.0" Color="#E1D2FF" />
                    <GradientStop Offset="0.45" Color="#EADFFF" />
                    <GradientStop Offset="1.0" Color="#F4ECFF" />
                </LinearGradientBrush>
            </Grid.Background>

            <!--  Encabezado compacto  -->
            <Border
                Grid.Row="0"
                Padding="14,10"
                BackgroundColor="#FCFBFF"
                StrokeThickness="1.2">

                <Border.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0.0" Color="#D8B4FE" />
                        <GradientStop Offset="0.55" Color="#A855F7" />
                        <GradientStop Offset="1.0" Color="#6D28D9" />
                    </LinearGradientBrush>
                </Border.Stroke>

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow
                        Brush="#6D28D9"
                        Opacity="0.26"
                        Radius="18"
                        Offset="0,7" />
                </Border.Shadow>

                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">

                    <Border
                        Grid.Column="0"
                        BackgroundColor="#F3E8FF"
                        HeightRequest="44"
                        Stroke="#D8B4FE"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        WidthRequest="44">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="21" />
                        </Border.StrokeShape>

                        <Label
                            FontSize="22"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="🐾"
                            TextColor="{StaticResource PrimaryColor}"
                            VerticalOptions="Center"
                            VerticalTextAlignment="Center" />
                    </Border>

                    <Label
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="Mis Mascotas"
                        TextColor="{StaticResource PrimaryDark}"
                        VerticalOptions="Center" />

                    <Border
                        Grid.Column="2"
                        Padding="9,5"
                        BackgroundColor="#F3E8FF"
                        Stroke="#A855F7"
                        StrokeThickness="1"
                        VerticalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Label
                            x:Name="LblConteoMascotas"
                            FontAttributes="Bold"
                            FontSize="11"
                            Text="0 mascotas"
                            TextColor="{StaticResource PrimaryDark}" />
                    </Border>

                    <Button
                        Grid.Column="3"
                        Padding="0"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        Clicked="OnAbrirRegistroMascotaClicked"
                        CornerRadius="19"
                        FontAttributes="Bold"
                        FontSize="22"
                        HeightRequest="38"
                        Text="+"
                        TextColor="White"
                        VerticalOptions="Center"
                        WidthRequest="38">

                        <Button.Shadow>
                            <Shadow
                                Brush="#5B21E6"
                                Opacity="0.35"
                                Radius="12"
                                Offset="0,5" />
                        </Button.Shadow>
                    </Button>
                </Grid>
            </Border>

            <!--  Mascotas  -->
            <Border
                Grid.Row="1"
                Padding="12"
                BackgroundColor="#FCFBFF"
                StrokeThickness="1.2">

                <Border.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0.0" Color="#D8B4FE" />
                        <GradientStop Offset="0.65" Color="#A855F7" />
                        <GradientStop Offset="1.0" Color="#7C3AED" />
                    </LinearGradientBrush>
                </Border.Stroke>

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow
                        Brush="#6D28D9"
                        Opacity="0.20"
                        Radius="14"
                        Offset="0,5" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Selecciona una mascota"
                            TextColor="{StaticResource PrimaryDark}"
                            VerticalOptions="Center" />

                        <Button
                            x:Name="BtnAccionesMascota"
                            Grid.Column="1"
                            Padding="12,0"
                            BackgroundColor="#EEE7FF"
                            BorderColor="#7C3AED"
                            BorderWidth="1"
                            Clicked="OnAccionesMascotaClicked"
                            CornerRadius="14"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="36"
                            IsEnabled="False"
                            Text="Acciones"
                            TextColor="#4C1D95">
                            <Button.Shadow>
                                <Shadow
                                    Brush="#5B21E6"
                                    Opacity="0.16"
                                    Radius="8"
                                    Offset="0,3" />
                            </Button.Shadow>
                        </Button>
                    </Grid>

                    <CollectionView
                        x:Name="MascotasCarousel"
                        HeightRequest="145"
                        ItemsLayout="HorizontalList"
                        SelectionChanged="OnMascotaSelected"
                        SelectionMode="Single">

                        <CollectionView.EmptyView>
                            <VerticalStackLayout
                                Padding="20"
                                HorizontalOptions="Center"
                                Spacing="6"
                                VerticalOptions="Center">

                                <Label
                                    FontSize="34"
                                    HorizontalOptions="Center"
                                    Text="🐾" />

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                    Text="Sin mascotas"
                                    TextColor="{StaticResource TextMain}" />

                                <Label
                                    FontSize="12"
                                    HorizontalTextAlignment="Center"
                                    Text="Registra tu primera mascota."
                                    TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    x:Name="CardBorder"
                                    Margin="0,0,10,0"
                                    Padding="10"
                                    BackgroundColor="#FFFCFF"
                                    HeightRequest="140"
                                    Stroke="#CDB7FF"
                                    StrokeThickness="1.2"
                                    WidthRequest="124">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnMascotaCardTapped" />
                                    </Border.GestureRecognizers>

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>

                                    <Border.Shadow>
                                        <Shadow
                                            Brush="#5B21E6"
                                            Opacity="0.16"
                                            Radius="10"
                                            Offset="0,4" />
                                    </Border.Shadow>

                                    <VerticalStackLayout
                                        HorizontalOptions="Center"
                                        Spacing="5"
                                        VerticalOptions="Center">

                                        <Border
                                            BackgroundColor="{StaticResource PrimarySoft}"
                                            HeightRequest="64"
                                            HorizontalOptions="Center"
                                            Stroke="#6D28D9"
                                            StrokeThickness="2.3"
                                            WidthRequest="64">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="32" />
                                            </Border.StrokeShape>

                                            <Image
                                                Aspect="AspectFill"
                                                HeightRequest="64"
                                                Source="{Binding FotoMostrar}"
                                                WidthRequest="64" />
                                        </Border>

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1"
                                            Text="{Binding Nombre}"
                                            TextColor="{StaticResource TextMain}" />

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="10"
                                            HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            LineBreakMode="WordWrap"
                                            MaxLines="1"
                                            Text="{Binding EstadoGpsVisual}"
                                            TextColor="{StaticResource PrimaryColor}" />
                                    </VerticalStackLayout>

                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">

                                            <VisualState Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter TargetName="CardBorder" Property="BackgroundColor" Value="#FFFFFF" />
                                                    <Setter TargetName="CardBorder" Property="Stroke" Value="#E1D6FF" />
                                                    <Setter TargetName="CardBorder" Property="StrokeThickness" Value="1" />
                                                </VisualState.Setters>
                                            </VisualState>

                                            <VisualState Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter TargetName="CardBorder" Property="BackgroundColor" Value="#EEE7FF" />
                                                    <Setter TargetName="CardBorder" Property="Stroke" Value="#4C1D95" />
                                                    <Setter TargetName="CardBorder" Property="StrokeThickness" Value="2.5" />
                                                </VisualState.Setters>
                                            </VisualState>

                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Border>

            <!--  Mapa  -->
            <Border
                Grid.Row="2"
                BackgroundColor="#E2E8F0"
                StrokeThickness="1.2">

                <Border.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0.0" Color="#D8B4FE" />
                        <GradientStop Offset="0.55" Color="#A855F7" />
                        <GradientStop Offset="1.0" Color="#6D28D9" />
                    </LinearGradientBrush>
                </Border.Stroke>

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow
                        Brush="#6D28D9"
                        Opacity="0.24"
                        Radius="16"
                        Offset="0,6" />
                </Border.Shadow>

                <Grid>
                    <maps:Map x:Name="MascotaMap" IsShowingUser="True" />

                    <Border
                        Margin="12"
                        Padding="11,7"
                        BackgroundColor="#F3E8FF"
                        HorizontalOptions="Start"
                        Stroke="#A855F7"
                        StrokeThickness="1"
                        VerticalOptions="Start">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Label
                            x:Name="LblTituloMapa"
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="Última ubicación GPS"
                            TextColor="{StaticResource PrimaryDark}" />
                    </Border>
                </Grid>
            </Border>

            <!--  Nota inferior  -->
            <Border
                Grid.Row="3"
                Padding="12"
                BackgroundColor="#F3E8FF"
                Stroke="#A855F7"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow
                        Brush="#5B21E6"
                        Opacity="0.16"
                        Radius="8"
                        Offset="0,3" />
                </Border.Shadow>

                <Label
                    x:Name="LblNotaSeguimiento"
                    FontAttributes="Bold"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    Text="Seguimiento GPS privado."
                    TextColor="{StaticResource PrimaryDark}" />
            </Border>

            <!--  Modal de acciones  -->
            <Grid
                x:Name="AccionesMascotaOverlay"
                Grid.RowSpan="4"
                Padding="18"
                BackgroundColor="#99000000"
                IsVisible="False"
                Opacity="0">

                <BoxView BackgroundColor="Transparent">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCerrarAccionesMascotaClicked" />
                    </BoxView.GestureRecognizers>
                </BoxView>

                <Border
                    Margin="0,0,0,12"
                    Padding="16"
                    BackgroundColor="#FFFCFF"
                    Stroke="#A855F7"
                    StrokeThickness="1.2"
                    VerticalOptions="End">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#5B21E6"
                            Opacity="0.25"
                            Radius="18"
                            Offset="0,6" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="Acciones de mascota"
                                    TextColor="{StaticResource PrimaryDark}" />

                                <Label
                                    x:Name="LblAccionesMascotaTitulo"
                                    FontSize="12"
                                    LineBreakMode="TailTruncation"
                                    Text="Mascota seleccionada"
                                    TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Padding="0"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                Clicked="OnCerrarAccionesMascotaClicked"
                                CornerRadius="18"
                                FontAttributes="Bold"
                                HeightRequest="36"
                                Text="✕"
                                TextColor="{StaticResource PrimaryDark}"
                                WidthRequest="36" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EEE7FF" />

                        <Button
                            BackgroundColor="#EEE7FF"
                            BorderColor="#A855F7"
                            BorderWidth="1"
                            Clicked="OnAccionEditarMascotaClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            FontSize="14"
                            HeightRequest="46"
                            Text="✏️ Editar mascota"
                            TextColor="#4C1D95" />

                        <Button
                            x:Name="BtnAccionHistorialGps"
                            BackgroundColor="#D1FAE5"
                            BorderColor="#10B981"
                            BorderWidth="1"
                            Clicked="OnAccionHistorialGpsClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            FontSize="14"
                            HeightRequest="46"
                            Text="📍 Historial GPS"
                            TextColor="#047857" />

                        <Button
                            BackgroundColor="#FEE2E2"
                            Clicked="OnAccionDesactivarMascotaClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            FontSize="14"
                            HeightRequest="46"
                            Text="🗑️ Desactivar mascota"
                            TextColor="#B91C1C" />

                        <Button
                            BackgroundColor="#F3E8FF"
                            BorderColor="#D8B4FE"
                            BorderWidth="1"
                            Clicked="OnCerrarAccionesMascotaClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            FontSize="14"
                            HeightRequest="44"
                            Text="Cancelar"
                            TextColor="#4C1D95" />

                    </VerticalStackLayout>
                </Border>
            </Grid>

        </Grid>

        <controls:BottomNavBar Grid.Row="1" CurrentPage="Mascotas" />

    </Grid>
</ContentPage>