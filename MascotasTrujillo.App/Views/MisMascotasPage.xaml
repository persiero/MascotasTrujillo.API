<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
    x:Class="MascotasTrujillo.App.Views.MisMascotasPage"
    Title="Mis Mascotas"
    BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="18"
          RowSpacing="14">

        <!-- Encabezado -->
        <Border Grid.Row="0"
                BackgroundColor="#FFFFFF"
                Stroke="Transparent"
                Padding="18">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="Black"
                        Opacity="0.08"
                        Offset="0,3"
                        Radius="8" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">

                <VerticalStackLayout Spacing="6">
                    <Label Text="Mis Mascotas"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#1E1B4B" />

                    <Label Text="Administra tus mascotas registradas y consulta su última ubicación GPS."
                           FontSize="14"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="+"
                        Clicked="OnAbrirRegistroMascotaClicked"
                        BackgroundColor="#2B0B98"
                        TextColor="White"
                        FontSize="26"
                        FontAttributes="Bold"
                        CornerRadius="18"
                        HeightRequest="52"
                        WidthRequest="52"
                        VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Lista horizontal de mascotas -->
        <Border Grid.Row="1"
                BackgroundColor="#FFFFFF"
                Stroke="Transparent"
                Padding="12">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="Black"
                        Opacity="0.06"
                        Offset="0,2"
                        Radius="7" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="10">

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Mascotas registradas"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#1E293B" />

                        <Label Text="Selecciona una mascota para ver su última ubicación."
                               FontSize="12"
                               TextColor="#64748B" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            BackgroundColor="#EEF2FF"
                            Stroke="Transparent"
                            Padding="10,5"
                            VerticalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Label x:Name="LblConteoMascotas"
                               Text="0 mascotas"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#2B0B98" />
                    </Border>
                </Grid>

                <CollectionView x:Name="MascotasCarousel"
                                SelectionMode="Single"
                                SelectionChanged="OnMascotaSelected"
                                ItemsLayout="HorizontalList"
                                HeightRequest="150">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20"
                                             Spacing="6"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center">

                            <Label Text="🐾"
                                   FontSize="34"
                                   HorizontalOptions="Center" />

                            <Label Text="Aún no tienes mascotas registradas"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#334155"
                                   HorizontalOptions="Center" />

                            <Label Text="Registra tu primera mascota para iniciar el seguimiento."
                                   FontSize="12"
                                   TextColor="#64748B"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="CardBorder"
                                    Margin="0,0,10,0"
                                    Padding="12"
                                    WidthRequest="120"
                                    HeightRequest="140"
                                    BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal">
                                            <VisualState.Setters>
                                                <Setter TargetName="CardBorder" Property="BackgroundColor" Value="White" />
                                                <Setter TargetName="CardBorder" Property="Stroke" Value="#E2E8F0" />
                                                <Setter TargetName="CardBorder" Property="StrokeThickness" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter TargetName="CardBorder" Property="BackgroundColor" Value="#FFF7ED" />
                                                <Setter TargetName="CardBorder" Property="Stroke" Value="#F97316" />
                                                <Setter TargetName="CardBorder" Property="StrokeThickness" Value="2" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <VerticalStackLayout Spacing="6"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center">

                                    <Border Stroke="#4338CA"
                                            StrokeThickness="2"
                                            BackgroundColor="#EEF2FF"
                                            HeightRequest="72"
                                            WidthRequest="72"
                                            HorizontalOptions="Center">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="36" />
                                        </Border.StrokeShape>

                                        <Image Source="{Binding FotoPerfilUrl}"
                                               Aspect="AspectFill"
                                               HeightRequest="72"
                                               WidthRequest="72" />
                                    </Border>

                                    <Label Text="{Binding Nombre}"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           TextColor="#1E293B"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />

                                                        <Label Text="{Binding Especie}"
                                           FontSize="11"
                                           TextColor="#64748B"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Grid ColumnDefinitions="*,*,*"
                      ColumnSpacing="8"
                      Margin="0,4,0,0">

                    <Button x:Name="BtnEditarMascota"
                            Grid.Column="0"
                            Text="✏️ Editar"
                            Clicked="OnEditarMascotaClicked"
                            BackgroundColor="#EEF2FF"
                            TextColor="#2B0B98"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="44"
                            FontSize="12"
                            IsEnabled="False" />

                    <Button x:Name="BtnHistorialGps"
                            Grid.Column="1"
                            Text="📍 GPS"
                            Clicked="OnHistorialGpsClicked"
                            BackgroundColor="#DCFCE7"
                            TextColor="#0F766E"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="44"
                            FontSize="12"
                            IsEnabled="False" />

                    <Button x:Name="BtnDesactivarMascota"
                            Grid.Column="2"
                            Text="🗑️ Desactivar"
                            Clicked="OnDesactivarMascotaClicked"
                            BackgroundColor="#FEE2E2"
                            TextColor="#B91C1C"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="44"
                            FontSize="12"
                            IsEnabled="False" />
                </Grid>

            </VerticalStackLayout>
        </Border>

        <!-- Mapa -->
        <Border Grid.Row="2"
                BackgroundColor="#E2E8F0"
                Stroke="Transparent">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="Black"
                        Opacity="0.10"
                        Offset="0,4"
                        Radius="10" />
            </Border.Shadow>

            <Grid>
                <maps:Map x:Name="MascotaMap"
                          IsShowingUser="True" />

                <Border BackgroundColor="#FFFFFF"
                        Stroke="Transparent"
                        Padding="12,8"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Margin="12">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <Label x:Name="LblTituloMapa"
                           Text="Última ubicación GPS"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#2B0B98" />
                </Border>
            </Grid>
        </Border>

        <!-- Nota inferior -->
        <Border Grid.Row="3"
                BackgroundColor="#EEF2FF"
                Stroke="Transparent"
                Padding="12">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>

            <Label x:Name="LblNotaSeguimiento"
                   Text="El seguimiento GPS es privado y solo es visible para el dueño de la mascota."
                   FontSize="12"
                   TextColor="#2B0B98"
                   HorizontalTextAlignment="Center"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap" />
        </Border>

    </Grid>
</ContentPage>