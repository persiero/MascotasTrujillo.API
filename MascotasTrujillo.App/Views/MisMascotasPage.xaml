<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
    x:Class="MascotasTrujillo.App.Views.MisMascotasPage"
    Title="Mis Mascotas"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F1FF">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="AccentPink">#FF4FB3</Color>
            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Color x:Key="CardBorder">#E1D6FF</Color>
            <Color x:Key="InputBorder">#D8CCFF</Color>
            <Color x:Key="InputBackground">#F8F5FF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="12,12,12,8"
          RowSpacing="10">

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F8F5FF" Offset="0.0" />
                <GradientStop Color="#F3EDFF" Offset="0.55" />
                <GradientStop Color="#FDFBFF" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Encabezado compacto -->
        <Border Grid.Row="0"
                BackgroundColor="#FFFFFF"
                Stroke="{StaticResource CardBorder}"
                StrokeThickness="1"
                Padding="14,10">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="#2B0B98"
                        Opacity="0.10"
                        Offset="0,4"
                        Radius="12" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                  ColumnSpacing="10">

                <Border Grid.Column="0"
                        BackgroundColor="{StaticResource PrimarySoft}"
                        Stroke="Transparent"
                        HeightRequest="42"
                        WidthRequest="42"
                        VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="21" />
                    </Border.StrokeShape>

                    <Label Text="🐾"
                           FontSize="22"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label Grid.Column="1"
                       Text="Mis Mascotas"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextMain}"
                       VerticalOptions="Center" />

                <Border Grid.Column="2"
                        BackgroundColor="{StaticResource PrimarySoft}"
                        Stroke="Transparent"
                        Padding="9,5"
                        VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Label x:Name="LblConteoMascotas"
                           Text="0 mascotas"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryColor}" />
                </Border>

                <Button Grid.Column="3"
                        Text="+"
                        Clicked="OnAbrirRegistroMascotaClicked"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        TextColor="White"
                        FontSize="22"
                        FontAttributes="Bold"
                        CornerRadius="19"
                        HeightRequest="38"
                        WidthRequest="38"
                        Padding="0"
                        VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Mascotas -->
        <Border Grid.Row="1"
                BackgroundColor="#FFFFFF"
                Stroke="{StaticResource CardBorder}"
                StrokeThickness="1"
                Padding="12">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="#2B0B98"
                        Opacity="0.08"
                        Offset="0,3"
                        Radius="10" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="10">

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Selecciona una mascota"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextMain}"
                           VerticalOptions="Center" />

                    <Button x:Name="BtnAccionesMascota"
                            Grid.Column="1"
                            Text="Acciones"
                            Clicked="OnAccionesMascotaClicked"
                            BackgroundColor="{StaticResource PrimarySoft}"
                            TextColor="{StaticResource PrimaryDark}"
                            BorderColor="{StaticResource CardBorder}"
                            BorderWidth="1"
                            FontAttributes="Bold"
                            FontSize="12"
                            CornerRadius="14"
                            HeightRequest="36"
                            Padding="12,0"
                            IsEnabled="False" />
                </Grid>

                <CollectionView x:Name="MascotasCarousel"
                                SelectionMode="Single"
                                SelectionChanged="OnMascotaSelected"
                                ItemsLayout="HorizontalList"
                                HeightRequest="128">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20"
                                             Spacing="6"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center">

                            <Label Text="🐾"
                                   FontSize="34"
                                   HorizontalOptions="Center" />

                            <Label Text="Sin mascotas"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextMain}"
                                   HorizontalOptions="Center" />

                            <Label Text="Registra tu primera mascota."
                                   FontSize="12"
                                   TextColor="{StaticResource TextMuted}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="CardBorder"
                                    Margin="0,0,10,0"
                                    Padding="10"
                                    WidthRequest="112"
                                    HeightRequest="122"
                                    BackgroundColor="#FFFFFF"
                                    Stroke="{StaticResource CardBorder}"
                                    StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">

                                        <VisualState Name="Normal">
                                            <VisualState.Setters>
                                                <Setter TargetName="CardBorder" Property="BackgroundColor" Value="#FFFFFF" />
                                                <Setter TargetName="CardBorder" Property="Stroke" Value="#E1D6FF" />
                                                <Setter TargetName="CardBorder" Property="StrokeThickness" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter TargetName="CardBorder" Property="BackgroundColor" Value="#F3EDFF" />
                                                <Setter TargetName="CardBorder" Property="Stroke" Value="#5B21E6" />
                                                <Setter TargetName="CardBorder" Property="StrokeThickness" Value="2" />
                                            </VisualState.Setters>
                                        </VisualState>

                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <VerticalStackLayout Spacing="5"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center">

                                    <Border Stroke="{StaticResource PrimaryColor}"
                                            StrokeThickness="2"
                                            BackgroundColor="{StaticResource PrimarySoft}"
                                            HeightRequest="64"
                                            WidthRequest="64"
                                            HorizontalOptions="Center">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="32" />
                                        </Border.StrokeShape>

                                        <Image Source="{Binding FotoMostrar}"
                                               Aspect="AspectFill"
                                               HeightRequest="64"
                                               WidthRequest="64" />
                                    </Border>

                                    <Label Text="{Binding Nombre}"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           TextColor="{StaticResource TextMain}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />

                                    <Label Text="{Binding EstadoGpsVisual}"
                                           FontSize="10"
                                           TextColor="{StaticResource PrimaryColor}"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </Border>

        <!-- Mapa -->
        <Border Grid.Row="2"
                BackgroundColor="#E2E8F0"
                Stroke="{StaticResource CardBorder}"
                StrokeThickness="1">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="#2B0B98"
                        Opacity="0.12"
                        Offset="0,4"
                        Radius="12" />
            </Border.Shadow>

            <Grid>
                <maps:Map x:Name="MascotaMap"
                          IsShowingUser="True" />

                <Border BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="11,7"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Margin="12">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <Label x:Name="LblTituloMapa"
                           Text="Última ubicación GPS"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryColor}" />
                </Border>
            </Grid>
        </Border>

        <!-- Nota inferior -->
        <Border Grid.Row="3"
                BackgroundColor="{StaticResource PrimarySoft}"
                Stroke="Transparent"
                Padding="12">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>

            <Label x:Name="LblNotaSeguimiento"
                   Text="Seguimiento GPS privado."
                   FontSize="12"
                   TextColor="{StaticResource PrimaryDark}"
                   HorizontalTextAlignment="Center"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap" />
        </Border>

        <!-- Modal de acciones -->
        <Grid x:Name="AccionesMascotaOverlay"
              Grid.RowSpan="4"
              IsVisible="False"
              Opacity="0"
              BackgroundColor="#99000000"
              Padding="18">

            <BoxView BackgroundColor="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCerrarAccionesMascotaClicked" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border VerticalOptions="End"
                    BackgroundColor="#FFFFFF"
                    Stroke="{StaticResource CardBorder}"
                    StrokeThickness="1"
                    Padding="16"
                    Margin="0,0,0,12">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="Black"
                            Opacity="0.18"
                            Offset="0,6"
                            Radius="18" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Acciones de mascota"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextMain}" />

                            <Label x:Name="LblAccionesMascotaTitulo"
                                   Text="Mascota seleccionada"
                                   FontSize="12"
                                   TextColor="{StaticResource TextMuted}"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="✕"
                                Clicked="OnCerrarAccionesMascotaClicked"
                                WidthRequest="36"
                                HeightRequest="36"
                                CornerRadius="18"
                                Padding="0"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                TextColor="{StaticResource PrimaryDark}"
                                FontAttributes="Bold" />
                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="#EEE7FF" />

                    <Button Text="✏️ Editar mascota"
                            Clicked="OnAccionEditarMascotaClicked"
                            BackgroundColor="{StaticResource PrimarySoft}"
                            TextColor="{StaticResource PrimaryDark}"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="16"
                            HeightRequest="46" />

                    <Button x:Name="BtnAccionHistorialGps"
                            Text="📍 Historial GPS"
                            Clicked="OnAccionHistorialGpsClicked"
                            BackgroundColor="#DCFCE7"
                            TextColor="#0F766E"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="16"
                            HeightRequest="46" />

                    <Button Text="🗑️ Desactivar mascota"
                            Clicked="OnAccionDesactivarMascotaClicked"
                            BackgroundColor="#FEE2E2"
                            TextColor="#B91C1C"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="16"
                            HeightRequest="46" />

                    <Button Text="Cancelar"
                            Clicked="OnCerrarAccionesMascotaClicked"
                            BackgroundColor="#F8F5FF"
                            TextColor="{StaticResource TextMuted}"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="16"
                            HeightRequest="44" />

                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>