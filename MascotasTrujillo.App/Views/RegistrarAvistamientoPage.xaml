<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MascotasTrujillo.App.Views.RegistrarAvistamientoPage"
    Title="Registrar Avistamiento"
    BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="16">

            <!-- Encabezado -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="16">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="Black"
                            Opacity="0.06"
                            Offset="0,3"
                            Radius="8" />
                </Border.Shadow>

                <Grid ColumnDefinitions="Auto,*"
                        ColumnSpacing="12">

                    <Border Grid.Column="0"
                            BackgroundColor="#DCFCE7"
                            Stroke="Transparent"
                            HeightRequest="50"
                            WidthRequest="50"
                            VerticalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="25" />
                        </Border.StrokeShape>

                        <Label Text="👀"
                               FontSize="25"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1"
                             Spacing="3"
                             VerticalOptions="Center">

                        <Label Text="Registrar avistamiento"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#1E1B4B" />

                        <Label x:Name="LblReporteTitulo"
                               Text="Ayuda indicando dónde viste a la mascota reportada."
                               FontSize="12"
                               TextColor="#64748B"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>

                </Grid>
            </Border>

            <!-- Descripción -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label Text="¿Cómo y dónde la viste?"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />

                    <Label Text="Describe la dirección, comportamiento de la mascota o alguna referencia útil."
                           FontSize="12"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />

                    <Editor x:Name="DescripcionEditor"
                            Placeholder="Ej. La vi cerca del parque, caminando hacia la avenida..."
                            AutoSize="TextChanges"
                            HeightRequest="110"
                            BackgroundColor="#F1F5F9"
                            TextColor="#1E293B" />

                    <Entry x:Name="DireccionReferenciaEntry"
                           Placeholder="Referencia del lugar. Ej. Cerca del mercado, parque, avenida..."
                           BackgroundColor="#F1F5F9"
                           TextColor="#1E293B" />

                </VerticalStackLayout>
            </Border>

            <!-- Foto -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Text="Foto del avistamiento"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#1E293B" />

                        <Border Grid.Column="1"
                                BackgroundColor="#DCFCE7"
                                Stroke="Transparent"
                                Padding="8,3"
                                VerticalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <Label Text="Opcional"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#0F766E" />
                        </Border>

                    </Grid>

                    <Label Text="Si tienes una foto, agrégala para que el dueño pueda reconocer mejor el avistamiento."
                           FontSize="12"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />

                    <Border BackgroundColor="#F1F5F9"
                            HeightRequest="240"
                            Stroke="#CBD5E1"
                            StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Grid>
                            <Image x:Name="FotoPreview"
                                   Aspect="AspectFill" />

                            <VerticalStackLayout x:Name="BotonesCaptura"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center"
                                                 Spacing="10">

                                <Label Text="📷"
                                       FontSize="40"
                                       HorizontalOptions="Center" />

                                <HorizontalStackLayout Spacing="10"
                                                       HorizontalOptions="Center">

                                    <Button Text="Cámara"
                                            Clicked="OnTomarFotoClicked"
                                            BackgroundColor="#0F766E"
                                            TextColor="White"
                                            CornerRadius="14"
                                            Padding="18,0" />

                                    <Button Text="Galería"
                                            Clicked="OnElegirGaleriaClicked"
                                            BackgroundColor="#DCFCE7"
                                            TextColor="#0F766E"
                                            CornerRadius="14"
                                            Padding="18,0" />

                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- Ubicación del avistamiento -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label Text="Punto del avistamiento"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />

                    <Label Text="Marca el lugar exacto donde viste a la mascota. Puedes usar tu GPS o elegir el punto en el mapa."
                           FontSize="12"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />

                    <Grid ColumnDefinitions="*,*"
                            ColumnSpacing="10">

                        <Button Grid.Column="0"
                                Text="📍 Usar mi GPS"
                                Clicked="OnUsarGpsActualClicked"
                                BackgroundColor="#0F766E"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="14"
                                HeightRequest="44" />

                        <Button Grid.Column="1"
                                Text="🗺️ Elegir en mapa"
                                Clicked="OnSeleccionarMapaClicked"
                                BackgroundColor="#DCFCE7"
                                TextColor="#0F766E"
                                FontAttributes="Bold"
                                CornerRadius="14"
                                HeightRequest="44" />

                    </Grid>

                    <Border BackgroundColor="#DCFCE7"
                            Stroke="Transparent"
                            Padding="12">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Label x:Name="LblUbicacionSeleccionada"
                               Text="Aún no has seleccionado la ubicación del avistamiento."
                               FontSize="12"
                               TextColor="#0F766E"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- Botón guardar -->
            <Button x:Name="BtnGuardarAvistamiento"
                    Text="📌 Publicar avistamiento"
                    Clicked="OnGuardarAvistamientoClicked"
                    BackgroundColor="#0F766E"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="18"
                    HeightRequest="54" />

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#2B0B98" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>