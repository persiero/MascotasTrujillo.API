<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MascotasTrujillo.App.Views.RegistrarAvistamientoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Registrar Avistamiento"
    BackgroundColor="#F5F1FF"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimaryDeep">#4C1D95</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="PrimarySoft2">#F3E8FF</Color>

            <Color x:Key="AccentPink">#FF4FB3</Color>
            <Color x:Key="AccentPinkSoft">#FDF2F8</Color>
            <Color x:Key="AccentPinkBorder">#F9A8D4</Color>
            <Color x:Key="AccentPinkText">#DB2777</Color>

            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextTitle">#1E1B4B</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Color x:Key="TextSecondary">#475569</Color>
            <Color x:Key="TextLight">#8A86A3</Color>

            <Color x:Key="CardBorder">#DCCBFF</Color>
            <Color x:Key="CardBorderStrong">#A855F7</Color>
            <Color x:Key="InputBorder">#D8B4FE</Color>
            <Color x:Key="InputBackground">#F8F5FF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="#E1D2FF" />
                <GradientStop Offset="0.45" Color="#EADFFF" />
                <GradientStop Offset="1.0" Color="#F4ECFF" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="18" Spacing="16">

                <!--  Encabezado con volver  -->
                <Border
                    Padding="12,10"
                    BackgroundColor="#FCFBFF"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.55" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#6D28D9" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#6D28D9"
                            Opacity="0.26"
                            Radius="18"
                            Offset="0,7" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                        <Button
                            Grid.Column="0"
                            Padding="0"
                            BackgroundColor="{StaticResource PrimaryDark}"
                            BorderColor="#6D28D9"
                            BorderWidth="1"
                            Clicked="OnVolverClicked"
                            CornerRadius="21"
                            FontAttributes="Bold"
                            FontSize="22"
                            HeightRequest="42"
                            Text="←"
                            TextColor="White"
                            VerticalOptions="Center"
                            WidthRequest="42">

                            <Button.Shadow>
                                <Shadow
                                    Brush="#2B0B98"
                                    Opacity="0.35"
                                    Radius="10"
                                    Offset="0,4" />
                            </Button.Shadow>
                        </Button>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="1"
                            VerticalOptions="Center">

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="Registrar avistamiento"
                                TextColor="{StaticResource PrimaryDark}" />

                            <Label
                                x:Name="LblReporteTitulo"
                                FontSize="12"
                                LineBreakMode="TailTruncation"
                                Text="Indica dónde viste a la mascota."
                                TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>

                    </Grid>
                </Border>

                <!--  Descripción  -->
                <Border
                    Padding="18"
                    BackgroundColor="#FCFBFF"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.65" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#7C3AED" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#6D28D9"
                            Opacity="0.22"
                            Radius="14"
                            Offset="0,5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="¿Cómo y dónde la viste?"
                            TextColor="{StaticResource PrimaryDark}" />

                        <Label
                            FontSize="12"
                            LineBreakMode="WordWrap"
                            Text="Describe la dirección, comportamiento de la mascota o alguna referencia útil."
                            TextColor="#64748B" />

                        <Border
                            Padding="12,4"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="120"
                            StrokeThickness="1">

                            <Border.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0.0" Color="#E9D5FF" />
                                    <GradientStop Offset="0.55" Color="#C084FC" />
                                    <GradientStop Offset="1.0" Color="#9333EA" />
                                </LinearGradientBrush>
                            </Border.Stroke>

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Editor
                                x:Name="DescripcionEditor"
                                AutoSize="TextChanges"
                                BackgroundColor="Transparent"
                                Placeholder="Ej. La vi cerca del parque, caminando hacia la avenida..."
                                PlaceholderColor="#8C84A6"
                                TextColor="{StaticResource TextMain}" />
                        </Border>

                        <Border
                            Padding="12,0"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="52"
                            StrokeThickness="1">

                            <Border.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0.0" Color="#E9D5FF" />
                                    <GradientStop Offset="0.55" Color="#C084FC" />
                                    <GradientStop Offset="1.0" Color="#9333EA" />
                                </LinearGradientBrush>
                            </Border.Stroke>

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Entry
                                x:Name="DireccionReferenciaEntry"
                                BackgroundColor="Transparent"
                                Placeholder="Referencia del lugar. Ej. Cerca del mercado, parque, avenida..."
                                PlaceholderColor="#8C84A6"
                                TextColor="{StaticResource TextMain}" />
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!--  Foto  -->
                <Border
                    Padding="18"
                    BackgroundColor="#FCFBFF"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#E9D8FD" />
                            <GradientStop Offset="0.65" Color="#D8B4FE" />
                            <GradientStop Offset="1.0" Color="#C084FC" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#6D28D9"
                            Opacity="0.14"
                            Radius="14"
                            Offset="0,5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Foto del avistamiento"
                                TextColor="{StaticResource PrimaryDark}" />

                            <Border
                                Grid.Column="1"
                                Padding="8,3"
                                BackgroundColor="#EEE7FF"
                                Stroke="Transparent"
                                VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="11"
                                    Text="Opcional"
                                    TextColor="#5B21E6" />
                            </Border>

                        </Grid>

                        <Label
                            FontSize="12"
                            LineBreakMode="WordWrap"
                            Text="Si tienes una foto, agrégala para que el dueño pueda reconocer mejor el avistamiento."
                            TextColor="#64748B" />

                        <Border
                            BackgroundColor="#FFFFFF"
                            HeightRequest="250"
                            StrokeThickness="1">

                            <Border.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0.0" Color="#EEE7FF" />
                                    <GradientStop Offset="0.55" Color="#D8B4FE" />
                                    <GradientStop Offset="1.0" Color="#C084FC" />
                                </LinearGradientBrush>
                            </Border.Stroke>

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>

                            <Grid>
                                <Image
                                    x:Name="FotoPreview"
                                    Aspect="AspectFit"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill" />

                                <VerticalStackLayout
                                    x:Name="BotonesCaptura"
                                    HorizontalOptions="Center"
                                    Spacing="10"
                                    VerticalOptions="Center">

                                    <Label
                                        FontSize="40"
                                        HorizontalOptions="Center"
                                        Text="📷" />

                                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">

                                        <Button
                                            Padding="18,0"
                                            BackgroundColor="{StaticResource PrimaryColor}"
                                            Clicked="OnTomarFotoClicked"
                                            CornerRadius="16"
                                            FontAttributes="Bold"
                                            HeightRequest="42"
                                            Text="📷 Cámara"
                                            TextColor="White">

                                            <Button.Shadow>
                                                <Shadow
                                                    Brush="#5B21E6"
                                                    Opacity="0.28"
                                                    Radius="10"
                                                    Offset="0,4" />
                                            </Button.Shadow>
                                        </Button>

                                        <Button
                                            Padding="18,0"
                                            BackgroundColor="#EEE7FF"
                                            BorderColor="#7C3AED"
                                            BorderWidth="1"
                                            Clicked="OnElegirGaleriaClicked"
                                            CornerRadius="16"
                                            FontAttributes="Bold"
                                            HeightRequest="42"
                                            Text="🖼️ Galería"
                                            TextColor="#4C1D95" />

                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!--  Ubicación del avistamiento  -->
                <Border
                    Padding="18"
                    BackgroundColor="#FCFBFF"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#E9D8FD" />
                            <GradientStop Offset="0.65" Color="#D8B4FE" />
                            <GradientStop Offset="1.0" Color="#C084FC" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#6D28D9"
                            Opacity="0.14"
                            Radius="14"
                            Offset="0,5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Punto del avistamiento"
                            TextColor="{StaticResource PrimaryDark}" />

                        <Label
                            FontSize="12"
                            LineBreakMode="WordWrap"
                            Text="Marca el lugar exacto donde viste a la mascota. Puedes usar tu GPS o elegir el punto en el mapa."
                            TextColor="#64748B" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                            <Button
                                Grid.Column="0"
                                BackgroundColor="{StaticResource PrimaryColor}"
                                Clicked="OnUsarGpsActualClicked"
                                CornerRadius="16"
                                FontAttributes="Bold"
                                HeightRequest="46"
                                Text="📍 Usar mi GPS"
                                TextColor="White">

                                <Button.Shadow>
                                    <Shadow
                                        Brush="#5B21E6"
                                        Opacity="0.28"
                                        Radius="10"
                                        Offset="0,4" />
                                </Button.Shadow>
                            </Button>

                            <Button
                                Grid.Column="1"
                                BackgroundColor="#EEE7FF"
                                BorderColor="#7C3AED"
                                BorderWidth="1"
                                Clicked="OnSeleccionarMapaClicked"
                                CornerRadius="16"
                                FontAttributes="Bold"
                                HeightRequest="46"
                                Text="🗺️ Elegir en mapa"
                                TextColor="#4C1D95" />

                        </Grid>

                        <Border
                            Padding="12"
                            BackgroundColor="#F3E8FF"
                            Stroke="#D8B4FE"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Label
                                x:Name="LblUbicacionSeleccionada"
                                FontAttributes="Bold"
                                FontSize="12"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                Text="Aún no has seleccionado la ubicación del avistamiento."
                                TextColor="#5B21E6" />
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!--  Botón guardar  -->
                <Button
                    x:Name="BtnGuardarAvistamiento"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    Clicked="OnGuardarAvistamientoClicked"
                    CornerRadius="22"
                    FontAttributes="Bold"
                    HeightRequest="56"
                    Text="📌 Publicar avistamiento"
                    TextColor="White">

                    <Button.Shadow>
                        <Shadow
                            Brush="#5B21E6"
                            Opacity="0.44"
                            Radius="14"
                            Offset="0,6" />
                    </Button.Shadow>
                </Button>

                <ActivityIndicator
                    x:Name="LoadingIndicator"
                    IsRunning="False"
                    IsVisible="False"
                    Color="#2B0B98" />

            </VerticalStackLayout>
        </ScrollView>

        <!--  Modal personalizado: salir sin guardar  -->
        <Grid
            x:Name="SalirSinGuardarOverlay"
            Padding="22"
            BackgroundColor="#90000000"
            IsVisible="False"
            Opacity="0">

            <BoxView BackgroundColor="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancelarSalirOverlayTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border
                Padding="20"
                BackgroundColor="#FCFBFF"
                HorizontalOptions="Center"
                StrokeThickness="1.2"
                VerticalOptions="Center">

                <Border.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0.0" Color="#D8B4FE" />
                        <GradientStop Offset="0.65" Color="#A855F7" />
                        <GradientStop Offset="1.0" Color="#7C3AED" />
                    </LinearGradientBrush>
                </Border.Stroke>

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow
                        Brush="#6D28D9"
                        Opacity="0.24"
                        Radius="22"
                        Offset="0,8" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16" WidthRequest="310">

                    <Border
                        BackgroundColor="{StaticResource PrimarySoft}"
                        HeightRequest="58"
                        HorizontalOptions="Center"
                        Stroke="Transparent"
                        WidthRequest="58">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="29" />
                        </Border.StrokeShape>

                        <Label
                            FontSize="30"
                            HorizontalOptions="Center"
                            Text="⚠️"
                            VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="6">

                        <Label
                            FontAttributes="Bold"
                            FontSize="22"
                            HorizontalTextAlignment="Center"
                            Text="Salir sin guardar"
                            TextColor="{StaticResource PrimaryDark}" />

                        <Label
                            FontSize="14"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap"
                            Text="¿Deseas volver? Los datos ingresados no se guardarán."
                            TextColor="{StaticResource TextMuted}" />
                    </VerticalStackLayout>

                    <Border
                        Padding="12"
                        BackgroundColor="#FFF7ED"
                        Stroke="#FED7AA"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Label
                            FontSize="12"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap"
                            Text="Si sales ahora, perderás la información del avistamiento que aún no publicaste."
                            TextColor="#9A3412" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                        <Button
                            Grid.Column="0"
                            BackgroundColor="#FFFFFF"
                            BorderColor="{StaticResource CardBorder}"
                            BorderWidth="1"
                            Clicked="OnCancelarSalirClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            HeightRequest="46"
                            Text="Cancelar"
                            TextColor="{StaticResource PrimaryColor}" />

                        <Button
                            Grid.Column="1"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            Clicked="OnConfirmarSalirClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            HeightRequest="46"
                            Text="Sí, volver"
                            TextColor="White" />
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>