<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MascotasTrujillo.App.Views.RegistrarAvistamientoPage"
    Title="Registrar Avistamiento"
    BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="16">

            <!-- Encabezado -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="Black"
                            Opacity="0.08"
                            Offset="0,3"
                            Radius="8" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Registrar Avistamiento"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#1E1B4B" />

                    <Label x:Name="LblReporteTitulo"
                           Text="Ayuda indicando dónde viste a la mascota reportada."
                           FontSize="14"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- Descripción -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label Text="Detalle del avistamiento"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />

                    <Editor x:Name="DescripcionEditor"
                            Placeholder="Ej. La vi cerca del parque, caminando hacia la avenida..."
                            AutoSize="TextChanges"
                            HeightRequest="110"
                            BackgroundColor="#F1F5F9"
                            TextColor="#1E293B" />

                    <Entry x:Name="DireccionReferenciaEntry"
                           Placeholder="Referencia del lugar. Ej. Cerca del mercado, parque, avenida..."
                           BackgroundColor="#F1F5F9"
                           TextColor="#1E293B" />

                </VerticalStackLayout>
            </Border>

            <!-- Foto -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label Text="Foto del avistamiento"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />

                    <Label Text="Agrega una foto si lograste capturar evidencia del avistamiento."
                           FontSize="12"
                           TextColor="#64748B" />

                    <Border BackgroundColor="#F1F5F9"
                            HeightRequest="240"
                            Stroke="#CBD5E1"
                            StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Grid>
                            <Image x:Name="FotoPreview"
                                   Aspect="AspectFill" />

                            <VerticalStackLayout x:Name="BotonesCaptura"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center"
                                                 Spacing="10">

                                <Label Text="📷"
                                       FontSize="40"
                                       HorizontalOptions="Center" />

                                <HorizontalStackLayout Spacing="10"
                                                       HorizontalOptions="Center">

                                    <Button Text="Cámara"
                                            Clicked="OnTomarFotoClicked"
                                            BackgroundColor="#2B0B98"
                                            TextColor="White"
                                            CornerRadius="14"
                                            Padding="18,0" />

                                    <Button Text="Galería"
                                            Clicked="OnElegirGaleriaClicked"
                                            BackgroundColor="#EEF2FF"
                                            TextColor="#2B0B98"
                                            CornerRadius="14"
                                            Padding="18,0" />

                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- Nota GPS -->
            <Border BackgroundColor="#EEF2FF"
                    Stroke="Transparent"
                    Padding="14">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <Label Text="Se usará tu ubicación GPS actual para registrar el punto del avistamiento."
                       FontSize="12"
                       TextColor="#2B0B98"
                       HorizontalTextAlignment="Center"
                       FontAttributes="Bold" />
            </Border>

            <!-- Botón guardar -->
            <Button x:Name="BtnGuardarAvistamiento"
                    Text="📍 Guardar avistamiento"
                    Clicked="OnGuardarAvistamientoClicked"
                    BackgroundColor="#0F766E"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="18"
                    HeightRequest="54" />

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#2B0B98" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>