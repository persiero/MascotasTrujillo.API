<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MascotasTrujillo.App.Views.RegistrarAvistamientoPage"
    Title="Registrar Avistamiento"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F1FF">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="AccentPink">#FF4FB3</Color>
            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Color x:Key="CardBorder">#E1D6FF</Color>
            <Color x:Key="InputBorder">#D8CCFF</Color>
            <Color x:Key="InputBackground">#F8F5FF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F8F5FF" Offset="0.0" />
                <GradientStop Color="#F3EDFF" Offset="0.55" />
                <GradientStop Color="#FDFBFF" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="18" Spacing="16">

                <!-- Encabezado con volver -->
                <Border BackgroundColor="#FFFFFF"
                    Stroke="{StaticResource CardBorder}"
                    StrokeThickness="1"
                    Padding="12,10">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                            Opacity="0.10"
                            Offset="0,4"
                            Radius="12" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto,Auto,*"
                    ColumnSpacing="10">

                        <Button Grid.Column="0"
                            Text="←"
                            Clicked="OnVolverClicked"
                            BackgroundColor="{StaticResource PrimarySoft}"
                            TextColor="{StaticResource PrimaryColor}"
                            FontAttributes="Bold"
                            FontSize="22"
                            WidthRequest="42"
                            HeightRequest="42"
                            CornerRadius="21"
                            Padding="0"
                            VerticalOptions="Center" />

                        <Border Grid.Column="1"
                            BackgroundColor="{StaticResource PrimarySoft}"
                            Stroke="Transparent"
                            HeightRequest="42"
                            WidthRequest="42"
                            VerticalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="21" />
                            </Border.StrokeShape>

                            <Label Text="👀"
                               FontSize="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="2"
                                         Spacing="1"
                                         VerticalOptions="Center">

                            <Label Text="Registrar avistamiento"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextMain}" />

                            <Label x:Name="LblReporteTitulo"
                               Text="Indica dónde viste a la mascota."
                               FontSize="12"
                               TextColor="{StaticResource TextMuted}"
                               LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                    </Grid>
                </Border>

                <!-- Descripción -->
                <Border BackgroundColor="#FFFFFF"
                    Stroke="{StaticResource CardBorder}"
                    StrokeThickness="1"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">

                        <Label Text="¿Cómo y dónde la viste?"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1F2340" />

                        <Label Text="Describe la dirección, comportamiento de la mascota o alguna referencia útil."
                           FontSize="12"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />

                        <Editor x:Name="DescripcionEditor"
                            Placeholder="Ej. La vi cerca del parque, caminando hacia la avenida..."
                            AutoSize="TextChanges"
                            HeightRequest="110"
                            BackgroundColor="#F8F5FF"
                            TextColor="#1F2340" />

                        <Entry x:Name="DireccionReferenciaEntry"
                           Placeholder="Referencia del lugar. Ej. Cerca del mercado, parque, avenida..."
                           BackgroundColor="#F8F5FF"
                           TextColor="#1F2340" />

                    </VerticalStackLayout>
                </Border>

                <!-- Foto -->
                <Border BackgroundColor="#FFFFFF"
                    Stroke="{StaticResource CardBorder}"
                    StrokeThickness="1"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label Text="Foto del avistamiento"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#1F2340" />

                            <Border Grid.Column="1"
                                BackgroundColor="#EEE7FF"
                                Stroke="Transparent"
                                Padding="8,3"
                                VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Label Text="Opcional"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#5B21E6" />
                            </Border>

                        </Grid>

                        <Label Text="Si tienes una foto, agrégala para que el dueño pueda reconocer mejor el avistamiento."
                           FontSize="12"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />

                        <Border BackgroundColor="#F8F5FF"
                            HeightRequest="240"
                            Stroke="#D8CCFF"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Grid>
                                <Image x:Name="FotoPreview"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill" />

                                <VerticalStackLayout x:Name="BotonesCaptura"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center"
                                                 Spacing="10">

                                    <Label Text="📷"
                                       FontSize="40"
                                       HorizontalOptions="Center" />

                                    <HorizontalStackLayout Spacing="10"
                                                       HorizontalOptions="Center">

                                        <Button Text="Cámara"
                                            Clicked="OnTomarFotoClicked"
                                            BackgroundColor="#5B21E6"
                                            TextColor="White"
                                            CornerRadius="14"
                                            Padding="18,0" />

                                        <Button Text="Galería"
                                            Clicked="OnElegirGaleriaClicked"
                                            BackgroundColor="#EEE7FF"
                                            TextColor="#5B21E6"
                                            CornerRadius="14"
                                            Padding="18,0" />

                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- Ubicación del avistamiento -->
                <Border BackgroundColor="#FFFFFF"
                    Stroke="{StaticResource CardBorder}"
                    StrokeThickness="1"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">

                        <Label Text="Punto del avistamiento"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1F2340" />

                        <Label Text="Marca el lugar exacto donde viste a la mascota. Puedes usar tu GPS o elegir el punto en el mapa."
                           FontSize="12"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />

                        <Grid ColumnDefinitions="*,*"
                            ColumnSpacing="10">

                            <Button Grid.Column="0"
                                Text="📍 Usar mi GPS"
                                Clicked="OnUsarGpsActualClicked"
                                BackgroundColor="#5B21E6"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="14"
                                HeightRequest="44" />

                            <Button Grid.Column="1"
                                Text="🗺️ Elegir en mapa"
                                Clicked="OnSeleccionarMapaClicked"
                                BackgroundColor="#EEE7FF"
                                TextColor="#5B21E6"
                                FontAttributes="Bold"
                                CornerRadius="14"
                                HeightRequest="44" />

                        </Grid>

                        <Border BackgroundColor="#EEE7FF"
                            Stroke="Transparent"
                            Padding="12">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Label x:Name="LblUbicacionSeleccionada"
                               Text="Aún no has seleccionado la ubicación del avistamiento."
                               FontSize="12"
                               TextColor="#5B21E6"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- Botón guardar -->
                <Button x:Name="BtnGuardarAvistamiento"
                    Text="📌 Publicar avistamiento"
                    Clicked="OnGuardarAvistamientoClicked"
                    BackgroundColor="#5B21E6"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="18"
                    HeightRequest="54" />

                <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#2B0B98" />

            </VerticalStackLayout>
        </ScrollView>
        <!-- Modal personalizado: salir sin guardar -->
        <Grid x:Name="SalirSinGuardarOverlay"
      IsVisible="False"
      Opacity="0"
      BackgroundColor="#90000000"
      Padding="22">

            <BoxView BackgroundColor="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancelarSalirOverlayTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border BackgroundColor="#FFFFFF"
            Stroke="{StaticResource CardBorder}"
            StrokeThickness="1"
            Padding="20"
            HorizontalOptions="Center"
            VerticalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="#2B0B98"
                    Opacity="0.25"
                    Offset="0,8"
                    Radius="22" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16"
                             WidthRequest="310">

                    <Border BackgroundColor="{StaticResource PrimarySoft}"
                    Stroke="Transparent"
                    WidthRequest="58"
                    HeightRequest="58"
                    HorizontalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="29" />
                        </Border.StrokeShape>

                        <Label Text="⚠️"
                       FontSize="30"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="6">

                        <Label Text="Salir sin guardar"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextMain}"
                       HorizontalTextAlignment="Center" />

                        <Label Text="¿Deseas volver? Los datos ingresados no se guardarán."
                       FontSize="14"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Border BackgroundColor="#FFF7ED"
                    Stroke="#FED7AA"
                    StrokeThickness="1"
                    Padding="12">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Label Text="Si sales ahora, perderás la información del avistamiento que aún no publicaste."
                       FontSize="12"
                       TextColor="#9A3412"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
                    </Border>

                    <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="10">

                        <Button Grid.Column="0"
                        Text="Cancelar"
                        Clicked="OnCancelarSalirClicked"
                        BackgroundColor="#FFFFFF"
                        TextColor="{StaticResource PrimaryColor}"
                        BorderColor="{StaticResource CardBorder}"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        HeightRequest="46" />

                        <Button Grid.Column="1"
                        Text="Sí, volver"
                        Clicked="OnConfirmarSalirClicked"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        HeightRequest="46" />
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>