<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MascotasTrujillo.App.Views.MascotaDetailPage"
             Title="Detalle del Reporte">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Border Stroke="Transparent" BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.2" Offset="0,5" Radius="10" />
                </Border.Shadow>

                <Image x:Name="FotoGrande" 
                       HeightRequest="300" 
                       Aspect="AspectFill" />
            </Border>

            <Label x:Name="LblDescripcion" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   TextColor="#2B0B98" 
                   Margin="0,10,0,0"/>

            <HorizontalStackLayout Spacing="5">
                <Label Text="📍" FontSize="18"/>
                <Label x:Name="LblDistancia" 
                       FontSize="16" 
                       TextColor="DimGray" 
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <Button Text="💬 Contactar por WhatsApp" 
                    Clicked="OnWhatsAppClicked"
                    BackgroundColor="#25D366" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12" 
                    HeightRequest="55" 
                    Margin="0,20,0,0">
                <Button.ImageSource>
                    <FontImageSource FontFamily="OpenSansRegular" Glyph="📞" Size="20" Color="White"/>
                </Button.ImageSource>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>