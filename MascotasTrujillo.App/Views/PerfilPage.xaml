<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MascotasTrujillo.App.Views.PerfilPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MascotasTrujillo.App.Views.Controls"
    Title="Mi Perfil"
    BackgroundColor="#F5F1FF"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimaryDeep">#4C1D95</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="PrimarySoft2">#F3E8FF</Color>

            <Color x:Key="AccentPink">#FF4FB3</Color>
            <Color x:Key="AccentPinkSoft">#FDF2F8</Color>
            <Color x:Key="AccentPinkBorder">#F9A8D4</Color>
            <Color x:Key="AccentPinkText">#DB2777</Color>

            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextTitle">#1E1B4B</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Color x:Key="TextSecondary">#475569</Color>
            <Color x:Key="TextLight">#8A86A3</Color>

            <Color x:Key="CardBorder">#DCCBFF</Color>
            <Color x:Key="CardBorderStrong">#A855F7</Color>
            <Color x:Key="InputBorder">#D8B4FE</Color>
            <Color x:Key="InputBackground">#F8F5FF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <Grid
            Grid.Row="0"
            Padding="12,12,12,0"
            RowDefinitions="Auto,*"
            RowSpacing="10">

            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0.0" Color="#E1D2FF" />
                    <GradientStop Offset="0.45" Color="#EADFFF" />
                    <GradientStop Offset="1.0" Color="#F4ECFF" />
                </LinearGradientBrush>
            </Grid.Background>

            <!--  Encabezado compacto  -->
            <Border
                Grid.Row="0"
                Padding="14,10"
                BackgroundColor="#FCFBFF"
                StrokeThickness="1.2">

                <Border.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0.0" Color="#D8B4FE" />
                        <GradientStop Offset="0.55" Color="#A855F7" />
                        <GradientStop Offset="1.0" Color="#6D28D9" />
                    </LinearGradientBrush>
                </Border.Stroke>

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow
                        Brush="#6D28D9"
                        Opacity="0.26"
                        Radius="18"
                        Offset="0,7" />
                </Border.Shadow>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">

                    <Border
                        Grid.Column="0"
                        BackgroundColor="#F3E8FF"
                        HeightRequest="44"
                        Stroke="#D8B4FE"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        WidthRequest="44">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="21" />
                        </Border.StrokeShape>

                        <Label
                            FontSize="22"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="👤"
                            TextColor="{StaticResource PrimaryColor}"
                            VerticalOptions="Center"
                            VerticalTextAlignment="Center" />
                    </Border>

                    <Label
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="Mi Perfil"
                        TextColor="{StaticResource PrimaryDark}"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="10">

                    <!--  Tarjeta de usuario  -->
                    <Border
                        Padding="18"
                        BackgroundColor="#FCFBFF"
                        StrokeThickness="1.2">

                        <Border.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0.0" Color="#D8B4FE" />
                                <GradientStop Offset="0.65" Color="#A855F7" />
                                <GradientStop Offset="1.0" Color="#7C3AED" />
                            </LinearGradientBrush>
                        </Border.Stroke>

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow
                                Brush="#6D28D9"
                                Opacity="0.22"
                                Radius="16"
                                Offset="0,6" />
                        </Border.Shadow>

                        <VerticalStackLayout HorizontalOptions="Center" Spacing="12">

                            <Border
                                BackgroundColor="#F3E8FF"
                                HeightRequest="112"
                                Stroke="#4C1D95"
                                StrokeThickness="2.8"
                                WidthRequest="112">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="56" />
                                </Border.StrokeShape>

                                <Border.Shadow>
                                    <Shadow
                                        Brush="#5B21E6"
                                        Opacity="0.22"
                                        Radius="12"
                                        Offset="0,5" />
                                </Border.Shadow>

                                <Image
                                    x:Name="FotoPerfilImage"
                                    Aspect="AspectFill"
                                    HeightRequest="112"
                                    Source="https://cdn-icons-png.flaticon.com/512/149/149071.png"
                                    WidthRequest="112" />
                            </Border>

                            <VerticalStackLayout HorizontalOptions="Center" Spacing="2">

                                <Label
                                    x:Name="LblNombrePerfil"
                                    FontAttributes="Bold"
                                    FontSize="21"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="TailTruncation"
                                    Text="Cargando..."
                                    TextColor="{StaticResource PrimaryDark}" />

                                <Label
                                    x:Name="LblEmailPerfil"
                                    FontSize="13"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="TailTruncation"
                                    Text=""
                                    TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">

                                <Button
                                    Padding="15,0"
                                    BackgroundColor="{StaticResource PrimaryColor}"
                                    Clicked="OnTomarFotoPerfilClicked"
                                    CornerRadius="16"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    HeightRequest="42"
                                    Text="📷 Cámara"
                                    TextColor="White">

                                    <Button.Shadow>
                                        <Shadow
                                            Brush="#5B21E6"
                                            Opacity="0.36"
                                            Radius="10"
                                            Offset="0,4" />
                                    </Button.Shadow>
                                </Button>

                                <Button
                                    Padding="15,0"
                                    BackgroundColor="#EEE7FF"
                                    BorderColor="#7C3AED"
                                    BorderWidth="1"
                                    Clicked="OnSeleccionarFotoPerfilClicked"
                                    CornerRadius="16"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    HeightRequest="42"
                                    Text="🖼️ Galería"
                                    TextColor="#4C1D95" />
                            </HorizontalStackLayout>

                            <Border
                                Padding="9,4"
                                BackgroundColor="#F3E8FF"
                                Stroke="#A855F7"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="11"
                                    Text="Cuenta activa"
                                    TextColor="{StaticResource PrimaryDark}" />
                            </Border>

                        </VerticalStackLayout>
                    </Border>

                    <!--  Información personal  -->
                    <Border
                        Padding="16"
                        BackgroundColor="#FCFBFF"
                        StrokeThickness="1.2">

                        <Border.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0.0" Color="#D8B4FE" />
                                <GradientStop Offset="0.65" Color="#A855F7" />
                                <GradientStop Offset="1.0" Color="#7C3AED" />
                            </LinearGradientBrush>
                        </Border.Stroke>

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow
                                Brush="#6D28D9"
                                Opacity="0.20"
                                Radius="14"
                                Offset="0,5" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="10">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="Información personal"
                                    TextColor="{StaticResource PrimaryDark}"
                                    VerticalOptions="Center" />

                                <Border
                                    Grid.Column="1"
                                    Padding="8,3"
                                    BackgroundColor="#F3E8FF"
                                    Stroke="#A855F7"
                                    StrokeThickness="1"
                                    VerticalOptions="Center">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        Text="Editable"
                                        TextColor="{StaticResource PrimaryDark}" />
                                </Border>
                            </Grid>

                            <Border
                                Padding="12,0"
                                BackgroundColor="#FFFFFF"
                                HeightRequest="52"
                                StrokeThickness="1">

                                <Border.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0.0" Color="#E9D5FF" />
                                        <GradientStop Offset="0.55" Color="#C084FC" />
                                        <GradientStop Offset="1.0" Color="#9333EA" />
                                    </LinearGradientBrush>
                                </Border.Stroke>

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Entry
                                    x:Name="NombreEntry"
                                    BackgroundColor="Transparent"
                                    Placeholder="Nombre completo"
                                    PlaceholderColor="#8C84A6"
                                    TextColor="{StaticResource TextMain}" />
                            </Border>

                            <Border
                                Padding="12,0"
                                BackgroundColor="#EEE7FF"
                                HeightRequest="52"
                                Stroke="#A855F7"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Entry
                                    x:Name="EmailEntry"
                                    BackgroundColor="Transparent"
                                    IsEnabled="False"
                                    Placeholder="Correo electrónico"
                                    TextColor="#475569" />
                            </Border>

                            <Border
                                Padding="12,0"
                                BackgroundColor="#FFFFFF"
                                HeightRequest="52"
                                StrokeThickness="1">

                                <Border.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0.0" Color="#EEE7FF" />
                                        <GradientStop Offset="0.55" Color="#D8B4FE" />
                                        <GradientStop Offset="1.0" Color="#C084FC" />
                                    </LinearGradientBrush>
                                </Border.Stroke>

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Entry
                                    x:Name="TelefonoEntry"
                                    BackgroundColor="Transparent"
                                    Keyboard="Telephone"
                                    Placeholder="WhatsApp. Ej. 51987654321"
                                    PlaceholderColor="#8C84A6"
                                    TextColor="{StaticResource TextMain}" />
                            </Border>

                            <Border
                                Padding="10"
                                BackgroundColor="#F3E8FF"
                                Stroke="#A855F7"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    HorizontalTextAlignment="Center"
                                    Text="Usa código de país. Para Perú: 51 + número."
                                    TextColor="{StaticResource PrimaryDark}" />
                            </Border>

                            <Button
                                x:Name="BtnGuardarPerfil"
                                BackgroundColor="{StaticResource PrimaryColor}"
                                Clicked="OnGuardarPerfilClicked"
                                CornerRadius="20"
                                FontAttributes="Bold"
                                HeightRequest="54"
                                Text="💾 Guardar cambios"
                                TextColor="White">

                                <Button.Shadow>
                                    <Shadow
                                        Brush="#5B21E6"
                                        Opacity="0.44"
                                        Radius="14"
                                        Offset="0,6" />
                                </Button.Shadow>
                            </Button>

                            <ActivityIndicator
                                x:Name="LoadingIndicator"
                                IsRunning="False"
                                IsVisible="False"
                                Color="{StaticResource PrimaryColor}" />

                        </VerticalStackLayout>
                    </Border>

                    <!--  Seguridad  -->
                    <Border
                        Padding="0"
                        BackgroundColor="#FFFCFF"
                        Stroke="#A855F7"
                        StrokeThickness="1.2">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow
                                Brush="#5B21E6"
                                Opacity="0.16"
                                Radius="12"
                                Offset="0,4" />
                        </Border.Shadow>

                        <Grid Padding="15" ColumnDefinitions="50,*,30">

                            <Border
                                Grid.Column="0"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                HeightRequest="36"
                                HorizontalOptions="Center"
                                Stroke="Transparent"
                                VerticalOptions="Center"
                                WidthRequest="36">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>

                                <Border.Shadow>
                                    <Shadow
                                        Brush="#5B21E6"
                                        Opacity="0.08"
                                        Radius="10"
                                        Offset="0,3" />
                                </Border.Shadow>

                                <Label
                                    FontSize="18"
                                    HorizontalOptions="Center"
                                    Text="🔐"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    Text="Cambiar contraseña"
                                    TextColor="{StaticResource PrimaryDark}" />

                                <Label
                                    FontSize="12"
                                    Text="Actualiza tu clave de acceso"
                                    TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                FontSize="24"
                                HorizontalOptions="End"
                                Text="›"
                                TextColor="#CBD5E1"
                                VerticalOptions="Center" />

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCambiarPasswordTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>

                    <!--  Cerrar sesión  -->
                    <Border
                        Padding="0"
                        BackgroundColor="#FCFBFF"
                        Stroke="#E1D6FF"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow
                                Brush="#5B21E6"
                                Opacity="0.16"
                                Radius="10"
                                Offset="0,3" />
                        </Border.Shadow>

                        <Grid Padding="15" ColumnDefinitions="50,*,30">

                            <Border
                                Grid.Column="0"
                                BackgroundColor="#FEE2E2"
                                HeightRequest="36"
                                HorizontalOptions="Center"
                                Stroke="Transparent"
                                VerticalOptions="Center"
                                WidthRequest="36">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>

                                <Label
                                    FontSize="18"
                                    HorizontalOptions="Center"
                                    Text="🚪"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    Text="Cerrar sesión"
                                    TextColor="#B91C1C" />

                                <Label
                                    FontSize="12"
                                    Text="Salir de este dispositivo"
                                    TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                FontSize="24"
                                HorizontalOptions="End"
                                Text="›"
                                TextColor="#CBD5E1"
                                VerticalOptions="Center" />

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCerrarSesionTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!--  Modal cambiar contraseña  -->
            <Grid
                x:Name="PasswordOverlay"
                Grid.RowSpan="2"
                Padding="18"
                BackgroundColor="#99000000"
                IsVisible="False"
                Opacity="0">

                <BoxView BackgroundColor="Transparent">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCerrarPasswordClicked" />
                    </BoxView.GestureRecognizers>
                </BoxView>

                <Border
                    Margin="0,0,0,12"
                    Padding="16"
                    BackgroundColor="#FFFCFF"
                    Stroke="#A855F7"
                    StrokeThickness="1.2"
                    VerticalOptions="End">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#5B21E6"
                            Opacity="0.25"
                            Radius="18"
                            Offset="0,6" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="Cambiar contraseña"
                                    TextColor="{StaticResource PrimaryDark}" />

                                <Label
                                    FontSize="12"
                                    Text="Actualiza tu clave de acceso"
                                    TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Padding="0"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                Clicked="OnCerrarPasswordClicked"
                                CornerRadius="18"
                                FontAttributes="Bold"
                                HeightRequest="36"
                                Text="✕"
                                TextColor="{StaticResource PrimaryDark}"
                                WidthRequest="36" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EEE7FF" />

                        <Border
                            Padding="12,0"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="50"
                            Stroke="#A855F7"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Entry
                                x:Name="PasswordActualEntry"
                                BackgroundColor="Transparent"
                                IsPassword="True"
                                Placeholder="Contraseña actual"
                                PlaceholderColor="#8C84A6"
                                TextColor="{StaticResource TextMain}" />
                        </Border>

                        <Border
                            Padding="12,0"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="50"
                            Stroke="#A855F7"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Entry
                                x:Name="PasswordNuevoEntry"
                                BackgroundColor="Transparent"
                                IsPassword="True"
                                Placeholder="Nueva contraseña"
                                PlaceholderColor="#8C84A6"
                                TextColor="{StaticResource TextMain}" />
                        </Border>

                        <Border
                            Padding="12,0"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="50"
                            Stroke="#A855F7"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Entry
                                x:Name="ConfirmarPasswordNuevoEntry"
                                BackgroundColor="Transparent"
                                IsPassword="True"
                                Placeholder="Confirmar nueva contraseña"
                                PlaceholderColor="#8C84A6"
                                TextColor="{StaticResource TextMain}" />
                        </Border>

                        <Button
                            x:Name="BtnGuardarPassword"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            Clicked="OnGuardarPasswordClicked"
                            CornerRadius="18"
                            FontAttributes="Bold"
                            FontSize="14"
                            HeightRequest="48"
                            Text="Actualizar contraseña"
                            TextColor="White" />

                        <Button
                            BackgroundColor="#F3E8FF"
                            BorderColor="#D8B4FE"
                            BorderWidth="1"
                            Clicked="OnCerrarPasswordClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            FontSize="14"
                            HeightRequest="44"
                            Text="Cancelar"
                            TextColor="#4C1D95" />

                    </VerticalStackLayout>
                </Border>
            </Grid>

        </Grid>

        <controls:BottomNavBar Grid.Row="1" CurrentPage="Perfil" />

    </Grid>
</ContentPage>