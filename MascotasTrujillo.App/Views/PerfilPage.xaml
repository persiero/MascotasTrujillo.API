<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MascotasTrujillo.App.Views.PerfilPage"
             Title="Mi Perfil"
             BackgroundColor="#F4F6FA">

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="20">

            <VerticalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,20,0,10">
                <Border Stroke="#2B0B98" StrokeThickness="3" HeightRequest="120" WidthRequest="120">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="60" />
                    </Border.StrokeShape>
                    <Image Source="https://cdn-icons-png.flaticon.com/512/3135/3135715.png" Aspect="AspectFill" />
                </Border>
                <Label Text="Percy Rojas" FontSize="24" FontAttributes="Bold" TextColor="#2B0B98" HorizontalOptions="Center" />
                <Label Text="percy.rojas@email.com" FontSize="14" TextColor="Gray" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Label Text="Ajustes de Cuenta" FontSize="14" FontAttributes="Bold" TextColor="#888888" Margin="5,0,0,-15" />
            <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <VerticalStackLayout>

                    <Grid ColumnDefinitions="50, *, 30" Padding="15" BackgroundColor="Transparent">
                        <Label Grid.Column="0" Text="👤" FontSize="20" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <Label Grid.Column="1" Text="Información Personal" FontSize="16" TextColor="#333" VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="›" FontSize="24" TextColor="#CCCCCC" VerticalOptions="Center" HorizontalOptions="End"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEditarDatosTapped" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#F0F0F0" />
                    <Grid ColumnDefinitions="50, *, 30" Padding="15" BackgroundColor="Transparent">
                        <Label Grid.Column="0" Text="🔒" FontSize="20" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <Label Grid.Column="1" Text="Seguridad y Contraseña" FontSize="16" TextColor="#333" VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="›" FontSize="24" TextColor="#CCCCCC" VerticalOptions="Center" HorizontalOptions="End"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Label Text="Sistema" FontSize="14" FontAttributes="Bold" TextColor="#888888" Margin="5,10,0,-15" />
            <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <VerticalStackLayout>

                    <Grid ColumnDefinitions="50, *, 30" Padding="15" BackgroundColor="Transparent">
                        <Label Grid.Column="0" Text="🚪" FontSize="20" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <Label Grid.Column="1" Text="Cerrar Sesión" FontSize="16" TextColor="#E63946" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="›" FontSize="24" TextColor="#CCCCCC" VerticalOptions="Center" HorizontalOptions="End"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCerrarSesionTapped" />
                        </Grid.GestureRecognizers>
                    </Grid>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>