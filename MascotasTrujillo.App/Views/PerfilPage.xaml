<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MascotasTrujillo.App.Views.PerfilPage"
             Title="Mi Perfil"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="20">

            <!-- Encabezado -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="Black"
                            Opacity="0.06"
                            Offset="0,3"
                            Radius="8" />
                </Border.Shadow>

                <Grid ColumnDefinitions="Auto,*"
                        ColumnSpacing="14">

                    <Border Grid.Column="0"
                            Stroke="#2B0B98"
                            StrokeThickness="2"
                            BackgroundColor="#EEF2FF"
                            HeightRequest="76"
                            WidthRequest="76"
                            VerticalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="38" />
                        </Border.StrokeShape>

                        <Label Text="👤"
                               FontSize="34"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1"
                             Spacing="4"
                             VerticalOptions="Center">

                        <Label Text="Mi perfil"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#64748B" />

                        <Label x:Name="LblNombrePerfil"
                               Text="Cargando..."
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#1E1B4B"
                               LineBreakMode="TailTruncation" />

                        <Label x:Name="LblEmailPerfil"
                               Text=""
                               FontSize="13"
                               TextColor="#64748B"
                               LineBreakMode="TailTruncation" />

                        <Border BackgroundColor="#EEF2FF"
                                Stroke="Transparent"
                                Padding="8,3"
                                HorizontalOptions="Start">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <Label Text="Cuenta activa"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#2B0B98" />
                        </Border>

                    </VerticalStackLayout>

                </Grid>
            </Border>

            <!-- Datos personales -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Text="Información personal"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#1E293B"
                               VerticalOptions="Center" />

                        <Border Grid.Column="1"
                                BackgroundColor="#EEF2FF"
                                Stroke="Transparent"
                                Padding="8,3"
                                VerticalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <Label Text="Editable"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#2B0B98" />
                        </Border>

                    </Grid>

                    <Label Text="Estos datos se usarán para identificar tu cuenta y permitir que otros usuarios puedan contactarte por WhatsApp si publicas un reporte."
                           FontSize="12"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />

                    <Entry x:Name="NombreEntry"
                           Placeholder="Nombre completo"
                           BackgroundColor="#F1F5F9"
                           TextColor="#1E293B" />

                    <Entry x:Name="EmailEntry"
                           Placeholder="Correo electrónico"
                           IsEnabled="False"
                           BackgroundColor="#E2E8F0"
                           TextColor="#64748B" />

                    <Entry x:Name="TelefonoEntry"
                           Placeholder="WhatsApp. Ej. 51987654321"
                           Keyboard="Telephone"
                           BackgroundColor="#F1F5F9"
                           TextColor="#1E293B" />

                    <Border BackgroundColor="#EEF2FF"
                            Stroke="Transparent"
                            Padding="12">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*"
                                ColumnSpacing="10">

                            <Label Grid.Column="0"
                                   Text="💬"
                                   FontSize="18"
                                   VerticalOptions="Center" />

                            <Label Grid.Column="1"
                                   Text="Recomendación: guarda tu número con código de país. Para Perú usa 51 + tu número. Ejemplo: 51987654321."
                                   FontSize="12"
                                   TextColor="#2B0B98"
                                   FontAttributes="Bold"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <Button x:Name="BtnGuardarPerfil"
                            Text="💾 Guardar cambios"
                            Clicked="OnGuardarPerfilClicked"
                            BackgroundColor="#2B0B98"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="50" />

                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="#2B0B98" />

                </VerticalStackLayout>
            </Border>

            <!-- Sistema -->
            <Border BackgroundColor="#FFFFFF"
        Stroke="Transparent"
        Padding="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="Black"
                Opacity="0.04"
                Offset="0,2"
                Radius="6" />
                </Border.Shadow>

                <VerticalStackLayout>

                    <Grid ColumnDefinitions="50, *, 30"
                          Padding="15"
                          BackgroundColor="Transparent">

                        <Border Grid.Column="0"
                                BackgroundColor="#FEE2E2"
                                Stroke="Transparent"
                                HeightRequest="36"
                                WidthRequest="36"
                                VerticalOptions="Center"
                                HorizontalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Label Text="🚪"
                                   FontSize="18"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                 Spacing="2"
                                 VerticalOptions="Center">

                            <Label Text="Cerrar sesión"
                                   FontSize="16"
                                   TextColor="#B91C1C"
                                   FontAttributes="Bold" />

                            <Label Text="Salir de tu cuenta en este dispositivo"
                                   FontSize="12"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>

                        <Label Grid.Column="2"
                               Text="›"
                               FontSize="24"
                               TextColor="#CBD5E1"
                               VerticalOptions="Center"
                               HorizontalOptions="End"/>

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCerrarSesionTapped" />
                        </Grid.GestureRecognizers>
                    </Grid>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>