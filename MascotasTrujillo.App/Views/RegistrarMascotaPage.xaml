<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MascotasTrujillo.App.Views.RegistrarMascotaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Registrar Mascota"
    BackgroundColor="#F5F1FF"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimaryDeep">#4C1D95</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="PrimarySoft2">#F3E8FF</Color>

            <Color x:Key="AccentPink">#FF4FB3</Color>
            <Color x:Key="AccentPinkSoft">#FDF2F8</Color>
            <Color x:Key="AccentPinkBorder">#F9A8D4</Color>
            <Color x:Key="AccentPinkText">#DB2777</Color>

            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextTitle">#1E1B4B</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Color x:Key="TextSecondary">#475569</Color>
            <Color x:Key="TextLight">#8A86A3</Color>

            <Color x:Key="CardBorder">#DCCBFF</Color>
            <Color x:Key="CardBorderStrong">#A855F7</Color>
            <Color x:Key="InputBorder">#D8B4FE</Color>
            <Color x:Key="InputBackground">#F8F5FF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="#E1D2FF" />
                <GradientStop Offset="0.45" Color="#EADFFF" />
                <GradientStop Offset="1.0" Color="#F4ECFF" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="14,12,14,22" Spacing="10">

                <!--  Encabezado con volver  -->
                <Border
                    Padding="12,10"
                    BackgroundColor="#FCFBFF"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.55" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#6D28D9" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#6D28D9"
                            Opacity="0.26"
                            Radius="18"
                            Offset="0,7" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                        <Button
                            Grid.Column="0"
                            Padding="0"
                            BackgroundColor="{StaticResource PrimaryDark}"
                            BorderColor="#6D28D9"
                            BorderWidth="1"
                            Clicked="OnVolverClicked"
                            CornerRadius="21"
                            FontAttributes="Bold"
                            FontSize="22"
                            HeightRequest="42"
                            Text="←"
                            TextColor="White"
                            VerticalOptions="Center"
                            WidthRequest="42">

                            <Button.Shadow>
                                <Shadow
                                    Brush="#2B0B98"
                                    Opacity="0.35"
                                    Radius="10"
                                    Offset="0,4" />
                            </Button.Shadow>
                        </Button>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="1"
                            VerticalOptions="Center">

                            <Label
                                x:Name="LblTituloHeader"
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="Registrar mascota"
                                TextColor="{StaticResource PrimaryDark}" />

                            <Label
                                x:Name="LblSubtituloHeader"
                                FontSize="12"
                                Text="Completa los datos de tu mascota"
                                TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!--  Encabezado compacto  -->
                <Border
                    Padding="14"
                    BackgroundColor="#FFFFFF"
                    IsVisible="False"
                    Stroke="{StaticResource CardBorder}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#2B0B98"
                            Opacity="0.10"
                            Radius="12"
                            Offset="0,4" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">

                        <Border
                            Grid.Column="0"
                            BackgroundColor="{StaticResource PrimarySoft}"
                            HeightRequest="42"
                            Stroke="Transparent"
                            VerticalOptions="Center"
                            WidthRequest="42">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="21" />
                            </Border.StrokeShape>

                            <Label
                                x:Name="LblIconoFormulario"
                                FontSize="22"
                                HorizontalOptions="Center"
                                Text="🐾"
                                VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="1"
                            VerticalOptions="Center">

                            <Label
                                x:Name="LblTituloFormulario"
                                FontAttributes="Bold"
                                FontSize="20"
                                Text="Registrar mascota"
                                TextColor="{StaticResource TextMain}" />

                            <Label
                                x:Name="LblSubtituloFormulario"
                                FontSize="12"
                                LineBreakMode="TailTruncation"
                                Text="Datos básicos y seguimiento GPS."
                                TextColor="{StaticResource TextMuted}" />
                        </VerticalStackLayout>

                    </Grid>
                </Border>

                <!--  Foto  -->
                <Border
                    Padding="14"
                    BackgroundColor="#FCFBFF"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.65" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#7C3AED" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#2B0B98"
                            Opacity="0.22"
                            Radius="10"
                            Offset="0,3" />
                    </Border.Shadow>

                    <VerticalStackLayout HorizontalOptions="Center" Spacing="10">

                        <Grid ColumnDefinitions="*,Auto" WidthRequest="260">

                            <Label
                                FontAttributes="Bold"
                                FontSize="17"
                                Text="Foto"
                                TextColor="{StaticResource PrimaryDark}"
                                VerticalOptions="Center" />

                            <Border
                                Grid.Column="1"
                                Padding="8,3"
                                BackgroundColor="#F3E8FF"
                                Stroke="#A855F7"
                                StrokeThickness="1"
                                VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="11"
                                    Text="Opcional"
                                    TextColor="{StaticResource PrimaryDark}" />
                            </Border>
                        </Grid>

                        <Border
                            BackgroundColor="{StaticResource PrimarySoft2}"
                            HeightRequest="128"
                            Stroke="{StaticResource PrimaryDark}"
                            StrokeThickness="2.8"
                            WidthRequest="128">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="64" />
                            </Border.StrokeShape>

                            <Border.Shadow>
                                <Shadow
                                    Brush="#5B21E6"
                                    Opacity="0.24"
                                    Radius="12"
                                    Offset="0,5" />
                            </Border.Shadow>

                            <Image
                                x:Name="FotoMascotaImage"
                                Aspect="AspectFill"
                                HeightRequest="128"
                                Source="https://cdn-icons-png.flaticon.com/512/616/616408.png"
                                WidthRequest="128" />
                        </Border>

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">

                            <Button
                                Padding="16,0"
                                BackgroundColor="{StaticResource PrimaryColor}"
                                Clicked="OnTomarFotoClicked"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                FontSize="13"
                                HeightRequest="40"
                                Text="📷 Cámara"
                                TextColor="White">

                                <Button.Shadow>
                                    <Shadow
                                        Brush="#5B21E6"
                                        Opacity="0.36"
                                        Radius="10"
                                        Offset="0,4" />
                                </Button.Shadow>
                            </Button>

                            <Button
                                Padding="16,0"
                                BackgroundColor="#EEE7FF"
                                BorderColor="#7C3AED"
                                BorderWidth="1"
                                Clicked="OnSeleccionarFotoClicked"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                FontSize="13"
                                HeightRequest="40"
                                Text="🖼️ Galería"
                                TextColor="#4C1D95" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!--  Datos principales  -->
                <Border
                    Padding="14"
                    BackgroundColor="#FCFBFF"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.65" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#7C3AED" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#2B0B98"
                            Opacity="0.20"
                            Radius="10"
                            Offset="0,3" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                FontAttributes="Bold"
                                FontSize="17"
                                Text="Datos principales"
                                TextColor="{StaticResource PrimaryDark}"
                                VerticalOptions="Center" />

                            <Border
                                Grid.Column="1"
                                Padding="8,3"
                                BackgroundColor="#FDF2F8"
                                Stroke="#FF4FB3"
                                StrokeThickness="1"
                                VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="11"
                                    Text="Obligatorio"
                                    TextColor="#BE185D" />
                            </Border>
                        </Grid>

                        <Border
                            Padding="12,0"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="50"
                            Stroke="#A855F7"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Entry
                                x:Name="NombreEntry"
                                BackgroundColor="Transparent"
                                Placeholder="Nombre de la mascota *"
                                PlaceholderColor="#8C84A6"
                                TextColor="{StaticResource PrimaryDark}" />
                        </Border>

                        <Border
                            x:Name="EspecieField"
                            Padding="12,10"
                            BackgroundColor="#FFFFFF"
                            Stroke="#A855F7"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="Especie *"
                                    TextColor="{StaticResource TextMuted}" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                                    <Button
                                        x:Name="BtnEspeciePerro"
                                        Grid.Column="0"
                                        BackgroundColor="#EEE7FF"
                                        BorderColor="#7C3AED"
                                        BorderWidth="1"
                                        Clicked="OnEspeciePerroClicked"
                                        CornerRadius="16"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        HeightRequest="42"
                                        Text="🐶 Perro"
                                        TextColor="#4C1D95" />

                                    <Button
                                        x:Name="BtnEspecieGato"
                                        Grid.Column="1"
                                        BackgroundColor="#EEE7FF"
                                        BorderColor="#7C3AED"
                                        BorderWidth="1"
                                        Clicked="OnEspecieGatoClicked"
                                        CornerRadius="16"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        HeightRequest="42"
                                        Text="🐱 Gato"
                                        TextColor="#4C1D95" />

                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!--  Detalles adicionales plegables  -->
                <Border
                    Padding="14"
                    BackgroundColor="#FCFBFF"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.65" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#7C3AED" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#2B0B98"
                            Opacity="0.20"
                            Radius="10"
                            Offset="0,3" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="1">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="17"
                                    Text="Detalles"
                                    TextColor="{StaticResource PrimaryDark}" />

                                <Label
                                    FontSize="12"
                                    Text="Raza, color, edad y rasgos."
                                    TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>

                            <Button
                                x:Name="BtnToggleDetalles"
                                Grid.Column="1"
                                Padding="12,0"
                                BackgroundColor="#EEE7FF"
                                BorderColor="#7C3AED"
                                BorderWidth="1"
                                Clicked="OnToggleDetallesClicked"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                FontSize="12"
                                HeightRequest="36"
                                Text="Mostrar"
                                TextColor="#4C1D95"
                                VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout
                            x:Name="DetallesContainer"
                            IsVisible="False"
                            Spacing="10">

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                                <Border
                                    Grid.Column="0"
                                    Padding="12,0"
                                    BackgroundColor="#FFFFFF"
                                    HeightRequest="50"
                                    Stroke="#A855F7"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>

                                    <Entry
                                        x:Name="RazaEntry"
                                        BackgroundColor="Transparent"
                                        Placeholder="Raza"
                                        PlaceholderColor="#8C84A6"
                                        TextColor="{StaticResource TextMain}" />
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="12,0"
                                    BackgroundColor="#FFFFFF"
                                    HeightRequest="50"
                                    Stroke="#A855F7"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>

                                    <Entry
                                        x:Name="ColorEntry"
                                        BackgroundColor="Transparent"
                                        Placeholder="Color"
                                        PlaceholderColor="#8C84A6"
                                        TextColor="{StaticResource PrimaryDark}" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                                <Border
                                    x:Name="SexoField"
                                    Grid.Column="0"
                                    Padding="12,0"
                                    BackgroundColor="#FFFFFF"
                                    HeightRequest="52"
                                    Stroke="#A855F7"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>

                                    <Button
                                        x:Name="BtnSexoSelector"
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        Clicked="OnAbrirSexoSelectorClicked"
                                        FontAttributes="Bold"
                                        HeightRequest="48"
                                        HorizontalOptions="Fill"
                                        Text="Seleccionar sexo"
                                        TextColor="{StaticResource PrimaryDark}"
                                        VerticalOptions="Center" />
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="12,0"
                                    BackgroundColor="#FFFFFF"
                                    HeightRequest="50"
                                    Stroke="#A855F7"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>

                                    <Entry
                                        x:Name="EdadEntry"
                                        BackgroundColor="Transparent"
                                        Placeholder="Edad aprox."
                                        PlaceholderColor="#8C84A6"
                                        TextColor="{StaticResource PrimaryDark}" />
                                </Border>
                            </Grid>

                            <Border
                                Padding="12,4"
                                BackgroundColor="#FFFFFF"
                                HeightRequest="86"
                                Stroke="#A855F7"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Editor
                                    x:Name="RasgosEditor"
                                    AutoSize="TextChanges"
                                    BackgroundColor="Transparent"
                                    Placeholder="Rasgos particulares"
                                    PlaceholderColor="#8C84A6"
                                    TextColor="{StaticResource PrimaryDark}" />
                            </Border>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!--  Información de salud plegable  -->
                <Border
                    Padding="14"
                    BackgroundColor="#FCFBFF"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.65" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#7C3AED" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#2B0B98"
                            Opacity="0.20"
                            Radius="10"
                            Offset="0,3" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="1">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="17"
                                    Text="Salud"
                                    TextColor="{StaticResource PrimaryDark}" />

                                <Label
                                    FontSize="12"
                                    Text="Cuidados especiales."
                                    TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>

                            <Button
                                x:Name="BtnToggleSalud"
                                Grid.Column="1"
                                Padding="12,0"
                                BackgroundColor="#EEE7FF"
                                BorderColor="#7C3AED"
                                BorderWidth="1"
                                Clicked="OnToggleSaludClicked"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                FontSize="12"
                                HeightRequest="36"
                                Text="Mostrar"
                                TextColor="#4C1D95"
                                VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout
                            x:Name="SaludContainer"
                            IsVisible="False"
                            Spacing="10">

                            <Border
                                Padding="12,4"
                                BackgroundColor="#FFFFFF"
                                HeightRequest="72"
                                Stroke="#A855F7"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Editor
                                    x:Name="EnfermedadesEditor"
                                    AutoSize="TextChanges"
                                    BackgroundColor="Transparent"
                                    Placeholder="Enfermedades"
                                    PlaceholderColor="#8C84A6"
                                    TextColor="{StaticResource PrimaryDark}" />
                            </Border>

                            <Border
                                Padding="12,4"
                                BackgroundColor="#FFFFFF"
                                HeightRequest="72"
                                Stroke="#A855F7"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Editor
                                    x:Name="DiscapacidadesEditor"
                                    AutoSize="TextChanges"
                                    BackgroundColor="Transparent"
                                    Placeholder="Discapacidades"
                                    PlaceholderColor="#8C84A6"
                                    TextColor="{StaticResource PrimaryDark}" />
                            </Border>

                            <Border
                                Padding="12,4"
                                BackgroundColor="#FFFFFF"
                                HeightRequest="72"
                                Stroke="#A855F7"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Editor
                                    x:Name="TratamientosEditor"
                                    AutoSize="TextChanges"
                                    BackgroundColor="Transparent"
                                    Placeholder="Tratamientos"
                                    PlaceholderColor="#8C84A6"
                                    TextColor="{StaticResource PrimaryDark}" />
                            </Border>

                            <Border
                                Padding="12,4"
                                BackgroundColor="#FFFFFF"
                                HeightRequest="72"
                                Stroke="#A855F7"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Editor
                                    x:Name="NecesidadesEspecialesEditor"
                                    AutoSize="TextChanges"
                                    BackgroundColor="Transparent"
                                    Placeholder="Necesidades especiales"
                                    PlaceholderColor="#8C84A6"
                                    TextColor="{StaticResource PrimaryDark}" />
                            </Border>

                            <Border
                                Padding="12,4"
                                BackgroundColor="#FFFFFF"
                                HeightRequest="72"
                                Stroke="#A855F7"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Editor
                                    x:Name="ObservacionesSaludEditor"
                                    AutoSize="TextChanges"
                                    BackgroundColor="Transparent"
                                    Placeholder="Observaciones de salud"
                                    PlaceholderColor="#8C84A6"
                                    TextColor="{StaticResource PrimaryDark}" />
                            </Border>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!--  GPS plegable  -->
                <Border
                    Padding="14"
                    BackgroundColor="#FCFBFF"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.65" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#7C3AED" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#2B0B98"
                            Opacity="0.20"
                            Radius="10"
                            Offset="0,3" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="1">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="17"
                                    Text="Collar GPS"
                                    TextColor="{StaticResource PrimaryDark}" />

                                <Label
                                    FontSize="12"
                                    Text="Código del dispositivo."
                                    TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>

                            <Button
                                x:Name="BtnToggleGps"
                                Grid.Column="1"
                                Padding="12,0"
                                BackgroundColor="#EEE7FF"
                                BorderColor="#7C3AED"
                                BorderWidth="1"
                                Clicked="OnToggleGpsClicked"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                FontSize="12"
                                HeightRequest="36"
                                Text="Mostrar"
                                TextColor="#4C1D95"
                                VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout
                            x:Name="GpsContainer"
                            IsVisible="False"
                            Spacing="10">

                            <Border
                                Padding="12,0"
                                BackgroundColor="#FFFFFF"
                                HeightRequest="50"
                                Stroke="#A855F7"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Entry
                                    x:Name="DispositivoIdEntry"
                                    BackgroundColor="Transparent"
                                    Placeholder="Código o IMEI del GPS"
                                    PlaceholderColor="#8C84A6"
                                    TextColor="{StaticResource PrimaryDark}" />
                            </Border>

                            <Border
                                Padding="10"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                Stroke="Transparent">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    HorizontalTextAlignment="Center"
                                    Text="Solo el dueño puede ver la ubicación GPS."
                                    TextColor="{StaticResource PrimaryDark}" />
                            </Border>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!--  Guardar  -->
                <Button
                    x:Name="BtnGuardar"
                    Margin="0,4,0,0"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    Clicked="OnGuardarMascotaClicked"
                    CornerRadius="22"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="56"
                    Text="💾 Guardar mascota"
                    TextColor="White">

                    <Button.Shadow>
                        <Shadow
                            Brush="#5B21E6"
                            Opacity="0.44"
                            Radius="12"
                            Offset="0,5" />
                    </Button.Shadow>
                </Button>

                <ActivityIndicator
                    x:Name="LoadingIndicator"
                    IsRunning="False"
                    IsVisible="False"
                    Color="{StaticResource PrimaryColor}" />

            </VerticalStackLayout>
        </ScrollView>

        <!--  Modal personalizado para seleccionar sexo  -->
        <Grid
            x:Name="SexoOverlay"
            BackgroundColor="#80000000"
            IsVisible="False"
            Opacity="0">

            <Grid RowDefinitions="*,Auto">

                <BoxView Grid.Row="0" BackgroundColor="Transparent">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCerrarSexoOverlayTapped" />
                    </BoxView.GestureRecognizers>
                </BoxView>

                <Border
                    Grid.Row="1"
                    Padding="18,16"
                    BackgroundColor="#FCFBFF"
                    Stroke="#A855F7"
                    StrokeThickness="1.2">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26,26,0,0" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#2B0B98"
                            Opacity="0.20"
                            Radius="16"
                            Offset="0,-4" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                            <VerticalStackLayout Grid.Column="0" Spacing="2">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="19"
                                    Text="Seleccionar sexo"
                                    TextColor="{StaticResource PrimaryDark}" />

                                <Label
                                    FontSize="12"
                                    Text="Elige una opción para la mascota."
                                    TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Padding="0"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                Clicked="OnCerrarSexoOverlayClicked"
                                CornerRadius="18"
                                FontAttributes="Bold"
                                HeightRequest="38"
                                Text="✕"
                                TextColor="{StaticResource PrimaryColor}"
                                WidthRequest="38" />
                        </Grid>

                        <Button
                            BackgroundColor="#EEE7FF"
                            BorderColor="#7C3AED"
                            BorderWidth="1"
                            Clicked="OnSexoMachoClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            HeightRequest="48"
                            Text="♂️ Macho"
                            TextColor="#4C1D95" />

                        <Button
                            BackgroundColor="#EEE7FF"
                            BorderColor="#7C3AED"
                            BorderWidth="1"
                            Clicked="OnSexoHembraClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            HeightRequest="48"
                            Text="♀️ Hembra"
                            TextColor="#4C1D95" />

                        <Button
                            BackgroundColor="#EEE7FF"
                            BorderColor="#7C3AED"
                            BorderWidth="1"
                            Clicked="OnSexoNoEspecificadoClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            HeightRequest="48"
                            Text="❔ No especificado"
                            TextColor="#4C1D95" />

                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>


        <!--  Modal personalizado: salir sin guardar  -->
        <Grid
            x:Name="SalirSinGuardarOverlay"
            Padding="22"
            BackgroundColor="#90000000"
            IsVisible="False"
            Opacity="0">

            <BoxView BackgroundColor="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancelarSalirOverlayTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border
                Padding="20"
                BackgroundColor="#FCFBFF"
                HorizontalOptions="Center"
                StrokeThickness="1.2"
                VerticalOptions="Center">

                <Border.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0.0" Color="#D8B4FE" />
                        <GradientStop Offset="0.65" Color="#A855F7" />
                        <GradientStop Offset="1.0" Color="#7C3AED" />
                    </LinearGradientBrush>
                </Border.Stroke>

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow
                        Brush="#2B0B98"
                        Opacity="0.25"
                        Radius="22"
                        Offset="0,8" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16" WidthRequest="310">

                    <Border
                        BackgroundColor="{StaticResource PrimarySoft}"
                        HeightRequest="58"
                        HorizontalOptions="Center"
                        Stroke="Transparent"
                        WidthRequest="58">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="29" />
                        </Border.StrokeShape>

                        <Label
                            FontSize="30"
                            HorizontalOptions="Center"
                            Text="⚠️"
                            VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="6">

                        <Label
                            FontAttributes="Bold"
                            FontSize="22"
                            HorizontalTextAlignment="Center"
                            Text="Salir sin guardar"
                            TextColor="{StaticResource PrimaryDark}" />

                        <Label
                            x:Name="LblMensajeSalirSinGuardar"
                            FontSize="14"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap"
                            Text="¿Deseas volver? Los datos ingresados no se guardarán."
                            TextColor="{StaticResource TextMuted}" />
                    </VerticalStackLayout>

                    <Border
                        Padding="12"
                        BackgroundColor="#FFF7ED"
                        Stroke="#FED7AA"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Label
                            FontSize="12"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap"
                            Text="Si sales ahora, perderás la información que aún no guardaste."
                            TextColor="#9A3412" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                        <Button
                            Grid.Column="0"
                            BackgroundColor="#EEE7FF"
                            BorderColor="#7C3AED"
                            BorderWidth="1"
                            Clicked="OnCancelarSalirClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            HeightRequest="46"
                            Text="Cancelar"
                            TextColor="#4C1D95" />

                        <Button
                            Grid.Column="1"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            Clicked="OnConfirmarSalirClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            HeightRequest="46"
                            Text="Sí, volver"
                            TextColor="White" />
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>