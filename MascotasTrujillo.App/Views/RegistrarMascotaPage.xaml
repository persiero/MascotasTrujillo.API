<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MascotasTrujillo.App.Views.RegistrarMascotaPage"
    Title="Registrar Mascota"
    BackgroundColor="#F5F1FF">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="AccentPink">#FF4FB3</Color>
            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Color x:Key="CardBorder">#E1D6FF</Color>
            <Color x:Key="InputBorder">#D8CCFF</Color>
            <Color x:Key="InputBackground">#F8F5FF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F8F5FF" Offset="0.0" />
                <GradientStop Color="#F3EDFF" Offset="0.55" />
                <GradientStop Color="#FDFBFF" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Spacing="10"
                                 Padding="14,12,14,22">

                <!-- Encabezado compacto -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="14"
                        IsVisible="False">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.10"
                                Offset="0,4"
                                Radius="12" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="10">

                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                Stroke="Transparent"
                                HeightRequest="42"
                                WidthRequest="42"
                                VerticalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="21" />
                            </Border.StrokeShape>

                            <Label x:Name="LblIconoFormulario"
                                   Text="🐾"
                                   FontSize="22"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="1"
                                             VerticalOptions="Center">

                            <Label x:Name="LblTituloFormulario"
                                   Text="Registrar mascota"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextMain}" />

                            <Label x:Name="LblSubtituloFormulario"
                                   Text="Datos básicos y seguimiento GPS."
                                   FontSize="12"
                                   TextColor="{StaticResource TextMuted}"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                    </Grid>
                </Border>

                <!-- Foto -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.08"
                                Offset="0,3"
                                Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10"
                                         HorizontalOptions="Center">

                        <Grid ColumnDefinitions="*,Auto"
                              WidthRequest="260">

                            <Label Text="Foto"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextMain}"
                                   VerticalOptions="Center" />

                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource PrimarySoft}"
                                    Stroke="Transparent"
                                    Padding="8,3"
                                    VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Label Text="Opcional"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource PrimaryColor}" />
                            </Border>
                        </Grid>

                        <Border Stroke="{StaticResource PrimaryColor}"
                                StrokeThickness="2"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                HeightRequest="128"
                                WidthRequest="128">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="64" />
                            </Border.StrokeShape>

                            <Image x:Name="FotoMascotaImage"
                                   Source="https://cdn-icons-png.flaticon.com/512/616/616408.png"
                                   Aspect="AspectFill"
                                   HeightRequest="128"
                                   WidthRequest="128" />
                        </Border>

                        <HorizontalStackLayout Spacing="10"
                                               HorizontalOptions="Center">

                            <Button Text="📷 Cámara"
                                    Clicked="OnTomarFotoClicked"
                                    BackgroundColor="{StaticResource PrimaryColor}"
                                    TextColor="White"
                                    CornerRadius="14"
                                    HeightRequest="40"
                                    Padding="16,0"
                                    FontAttributes="Bold"
                                    FontSize="13" />

                            <Button Text="🖼️ Galería"
                                    Clicked="OnSeleccionarFotoClicked"
                                    BackgroundColor="#FFFFFF"
                                    BorderColor="{StaticResource CardBorder}"
                                    BorderWidth="1"
                                    TextColor="{StaticResource PrimaryColor}"
                                    CornerRadius="14"
                                    HeightRequest="40"
                                    Padding="16,0"
                                    FontAttributes="Bold"
                                    FontSize="13" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Datos principales -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.08"
                                Offset="0,3"
                                Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label Text="Datos principales"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextMain}"
                                   VerticalOptions="Center" />

                            <Border Grid.Column="1"
                                    BackgroundColor="#FCE7F3"
                                    Stroke="Transparent"
                                    Padding="8,3"
                                    VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Label Text="Obligatorio"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#BE185D" />
                            </Border>
                        </Grid>

                        <Border Stroke="{StaticResource InputBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource InputBackground}"
                                Padding="12,0"
                                HeightRequest="50">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Entry x:Name="NombreEntry"
                                   Placeholder="Nombre de la mascota *"
                                   PlaceholderColor="#8C84A6"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource TextMain}" />
                        </Border>

                        <Border Stroke="{StaticResource InputBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource InputBackground}"
                                Padding="12,0"
                                HeightRequest="50">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Entry x:Name="EspecieEntry"
                                   Placeholder="Especie. Ej. Perro, gato *"
                                   PlaceholderColor="#8C84A6"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource TextMain}" />
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- Detalles adicionales plegables -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.08"
                                Offset="0,3"
                                Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="1">
                                <Label Text="Detalles"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextMain}" />

                                <Label Text="Raza, color, edad y rasgos."
                                       FontSize="12"
                                       TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>

                            <Button x:Name="BtnToggleDetalles"
                                    Grid.Column="1"
                                    Text="Mostrar"
                                    Clicked="OnToggleDetallesClicked"
                                    BackgroundColor="{StaticResource PrimarySoft}"
                                    TextColor="{StaticResource PrimaryDark}"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    CornerRadius="14"
                                    HeightRequest="36"
                                    Padding="12,0"
                                    VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout x:Name="DetallesContainer"
                                             Spacing="10"
                                             IsVisible="False">

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="10">

                                <Border Grid.Column="0"
                                        Stroke="{StaticResource InputBorder}"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource InputBackground}"
                                        Padding="12,0"
                                        HeightRequest="50">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>

                                    <Entry x:Name="RazaEntry"
                                           Placeholder="Raza"
                                           PlaceholderColor="#8C84A6"
                                           BackgroundColor="Transparent"
                                           TextColor="{StaticResource TextMain}" />
                                </Border>

                                <Border Grid.Column="1"
                                        Stroke="{StaticResource InputBorder}"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource InputBackground}"
                                        Padding="12,0"
                                        HeightRequest="50">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>

                                    <Entry x:Name="ColorEntry"
                                           Placeholder="Color"
                                           PlaceholderColor="#8C84A6"
                                           BackgroundColor="Transparent"
                                           TextColor="{StaticResource TextMain}" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="10">

                                <Border Grid.Column="0"
                                        Stroke="{StaticResource InputBorder}"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource InputBackground}"
                                        Padding="12,0"
                                        HeightRequest="52">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>

                                    <Picker x:Name="SexoPicker"
                                            Title="Sexo"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource TextMain}">
                                        <Picker.Items>
                                            <x:String>Macho</x:String>
                                            <x:String>Hembra</x:String>
                                            <x:String>No especificado</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </Border>

                                <Border Grid.Column="1"
                                        Stroke="{StaticResource InputBorder}"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource InputBackground}"
                                        Padding="12,0"
                                        HeightRequest="50">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>

                                    <Entry x:Name="EdadEntry"
                                           Placeholder="Edad aprox."
                                           PlaceholderColor="#8C84A6"
                                           BackgroundColor="Transparent"
                                           TextColor="{StaticResource TextMain}" />
                                </Border>
                            </Grid>

                            <Border Stroke="{StaticResource InputBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource InputBackground}"
                                    Padding="12,4"
                                    HeightRequest="86">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Editor x:Name="RasgosEditor"
                                        Placeholder="Rasgos particulares"
                                        PlaceholderColor="#8C84A6"
                                        AutoSize="TextChanges"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextMain}" />
                            </Border>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Información de salud plegable -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.08"
                                Offset="0,3"
                                Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="1">
                                <Label Text="Salud"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextMain}" />

                                <Label Text="Cuidados especiales."
                                       FontSize="12"
                                       TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>

                            <Button x:Name="BtnToggleSalud"
                                    Grid.Column="1"
                                    Text="Mostrar"
                                    Clicked="OnToggleSaludClicked"
                                    BackgroundColor="{StaticResource PrimarySoft}"
                                    TextColor="{StaticResource PrimaryDark}"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    CornerRadius="14"
                                    HeightRequest="36"
                                    Padding="12,0"
                                    VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout x:Name="SaludContainer"
                                             Spacing="10"
                                             IsVisible="False">

                            <Border Stroke="{StaticResource InputBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource InputBackground}"
                                    Padding="12,4"
                                    HeightRequest="72">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Editor x:Name="EnfermedadesEditor"
                                        Placeholder="Enfermedades"
                                        PlaceholderColor="#8C84A6"
                                        AutoSize="TextChanges"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextMain}" />
                            </Border>

                            <Border Stroke="{StaticResource InputBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource InputBackground}"
                                    Padding="12,4"
                                    HeightRequest="72">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Editor x:Name="DiscapacidadesEditor"
                                        Placeholder="Discapacidades"
                                        PlaceholderColor="#8C84A6"
                                        AutoSize="TextChanges"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextMain}" />
                            </Border>

                            <Border Stroke="{StaticResource InputBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource InputBackground}"
                                    Padding="12,4"
                                    HeightRequest="72">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Editor x:Name="TratamientosEditor"
                                        Placeholder="Tratamientos"
                                        PlaceholderColor="#8C84A6"
                                        AutoSize="TextChanges"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextMain}" />
                            </Border>

                            <Border Stroke="{StaticResource InputBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource InputBackground}"
                                    Padding="12,4"
                                    HeightRequest="72">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Editor x:Name="NecesidadesEspecialesEditor"
                                        Placeholder="Necesidades especiales"
                                        PlaceholderColor="#8C84A6"
                                        AutoSize="TextChanges"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextMain}" />
                            </Border>

                            <Border Stroke="{StaticResource InputBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource InputBackground}"
                                    Padding="12,4"
                                    HeightRequest="72">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Editor x:Name="ObservacionesSaludEditor"
                                        Placeholder="Observaciones de salud"
                                        PlaceholderColor="#8C84A6"
                                        AutoSize="TextChanges"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextMain}" />
                            </Border>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- GPS plegable -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.08"
                                Offset="0,3"
                                Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="1">
                                <Label Text="Collar GPS"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextMain}" />

                                <Label Text="Código del dispositivo."
                                       FontSize="12"
                                       TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>

                            <Button x:Name="BtnToggleGps"
                                    Grid.Column="1"
                                    Text="Mostrar"
                                    Clicked="OnToggleGpsClicked"
                                    BackgroundColor="{StaticResource PrimarySoft}"
                                    TextColor="{StaticResource PrimaryDark}"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    CornerRadius="14"
                                    HeightRequest="36"
                                    Padding="12,0"
                                    VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout x:Name="GpsContainer"
                                             Spacing="10"
                                             IsVisible="False">

                            <Border Stroke="{StaticResource InputBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource InputBackground}"
                                    Padding="12,0"
                                    HeightRequest="50">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Entry x:Name="DispositivoIdEntry"
                                       Placeholder="Código o IMEI del GPS"
                                       PlaceholderColor="#8C84A6"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource TextMain}" />
                            </Border>

                            <Border BackgroundColor="{StaticResource PrimarySoft}"
                                    Stroke="Transparent"
                                    Padding="10">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <Label Text="Solo el dueño puede ver la ubicación GPS."
                                       FontSize="12"
                                       TextColor="{StaticResource PrimaryDark}"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" />
                            </Border>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Guardar -->
                <Button x:Name="BtnGuardar"
                        Text="💾 Guardar mascota"
                        Clicked="OnGuardarMascotaClicked"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="18"
                        HeightRequest="54"
                        Margin="0,4,0,0">

                    <Button.Shadow>
                        <Shadow Brush="#5B21E6"
                                Opacity="0.25"
                                Offset="0,5"
                                Radius="12" />
                    </Button.Shadow>
                </Button>

                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="{StaticResource PrimaryColor}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>