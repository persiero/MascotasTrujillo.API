<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
    x:Class="MascotasTrujillo.App.Views.RadarPage"
    Title="Radar"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F1FF">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="AccentPink">#FF4FB3</Color>
            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Color x:Key="CardBorder">#E1D6FF</Color>
            <Color x:Key="InputBorder">#D8CCFF</Color>
            <Color x:Key="InputBackground">#F8F5FF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,170,Auto,Auto,*"
          Padding="12,12,12,8"
          RowSpacing="8">

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F8F5FF" Offset="0.0" />
                <GradientStop Color="#F3EDFF" Offset="0.55" />
                <GradientStop Color="#FDFBFF" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Encabezado compacto -->
        <Border Grid.Row="0"
                BackgroundColor="#FFFFFF"
                Stroke="{StaticResource CardBorder}"
                StrokeThickness="1"
                Padding="14,10">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="#2B0B98"
                        Opacity="0.10"
                        Offset="0,4"
                        Radius="12" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="10">

                <Border Grid.Column="0"
                        BackgroundColor="{StaticResource PrimarySoft}"
                        Stroke="Transparent"
                        HeightRequest="42"
                        WidthRequest="42"
                        VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="21" />
                    </Border.StrokeShape>

                    <Label Text="📡"
                           FontSize="22"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label Grid.Column="1"
                       Text="Reportes cerca de ti"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextMain}"
                       VerticalOptions="Center" />

                <Border Grid.Column="2"
                        BackgroundColor="#FCE7F3"
                        Stroke="Transparent"
                        Padding="9,5"
                        VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Label x:Name="LblResumenFiltroSuperior"
                           Text="Radar"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#BE185D" />
                </Border>
            </Grid>
        </Border>

        <!-- Mapa -->
        <Border Grid.Row="1"
                Stroke="{StaticResource CardBorder}"
                StrokeThickness="1"
                BackgroundColor="#E2E8F0">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="#2B0B98"
                        Opacity="0.13"
                        Offset="0,5"
                        Radius="14" />
            </Border.Shadow>

            <maps:Map x:Name="MapaMascotas"
                      IsShowingUser="True" />
        </Border>

        <!-- Filtros rápidos -->
        <Border Grid.Row="2"
                Padding="12"
                Stroke="{StaticResource CardBorder}"
                StrokeThickness="1"
                BackgroundColor="#FFFFFF">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="#2B0B98"
                        Opacity="0.08"
                        Offset="0,3"
                        Radius="10" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="10">

                <!-- Tipo -->
                <Grid ColumnDefinitions="Auto,*,*,*"
                      ColumnSpacing="6">

                    <Label Text="Tipo"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextMuted}"
                           VerticalOptions="Center" />

                    <Button x:Name="BtnTipoTodos"
                            Grid.Column="1"
                            Text="Todos"
                            Clicked="OnTipoTodosClicked"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="11"
                            HeightRequest="34"
                            CornerRadius="14"
                            Padding="6,0" />

                    <Button x:Name="BtnTipoPerdidas"
                            Grid.Column="2"
                            Text="Perdidas"
                            Clicked="OnTipoPerdidasClicked"
                            BackgroundColor="{StaticResource InputBackground}"
                            TextColor="{StaticResource PrimaryDark}"
                            FontAttributes="Bold"
                            FontSize="11"
                            HeightRequest="34"
                            CornerRadius="14"
                            Padding="6,0" />

                    <Button x:Name="BtnTipoEncontradas"
                            Grid.Column="3"
                            Text="Encontradas"
                            Clicked="OnTipoEncontradasClicked"
                            BackgroundColor="{StaticResource InputBackground}"
                            TextColor="{StaticResource PrimaryDark}"
                            FontAttributes="Bold"
                            FontSize="11"
                            HeightRequest="34"
                            CornerRadius="14"
                            Padding="6,0" />
                </Grid>

                <!-- Radio -->
                <Grid ColumnDefinitions="Auto,*,*,*,*"
                      ColumnSpacing="6">

                    <Label Text="Radio"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextMuted}"
                           VerticalOptions="Center" />

                    <Button x:Name="BtnRadio1"
                            Grid.Column="1"
                            Text="1 km"
                            Clicked="OnRadio1Clicked"
                            BackgroundColor="{StaticResource InputBackground}"
                            TextColor="{StaticResource PrimaryDark}"
                            FontAttributes="Bold"
                            FontSize="11"
                            HeightRequest="34"
                            CornerRadius="14"
                            Padding="6,0" />

                    <Button x:Name="BtnRadio3"
                            Grid.Column="2"
                            Text="3 km"
                            Clicked="OnRadio3Clicked"
                            BackgroundColor="{StaticResource InputBackground}"
                            TextColor="{StaticResource PrimaryDark}"
                            FontAttributes="Bold"
                            FontSize="11"
                            HeightRequest="34"
                            CornerRadius="14"
                            Padding="6,0" />

                    <Button x:Name="BtnRadio5"
                            Grid.Column="3"
                            Text="5 km"
                            Clicked="OnRadio5Clicked"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="11"
                            HeightRequest="34"
                            CornerRadius="14"
                            Padding="6,0" />

                    <Button x:Name="BtnRadio10"
                            Grid.Column="4"
                            Text="10 km"
                            Clicked="OnRadio10Clicked"
                            BackgroundColor="{StaticResource InputBackground}"
                            TextColor="{StaticResource PrimaryDark}"
                            FontAttributes="Bold"
                            FontSize="11"
                            HeightRequest="34"
                            CornerRadius="14"
                            Padding="6,0" />
                </Grid>

            </VerticalStackLayout>
        </Border>

        <!-- Botones de acción -->
        <Grid Grid.Row="3"
              ColumnDefinitions="*,*"
              ColumnSpacing="10">

            <Button x:Name="BtnActualizar"
                    Grid.Column="0"
                    Text="🔄 Actualizar"
                    Clicked="OnActualizarClicked"
                    HeightRequest="46"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="14"
                    CornerRadius="16">

                <Button.Shadow>
                    <Shadow Brush="#5B21E6"
                            Opacity="0.25"
                            Offset="0,4"
                            Radius="10" />
                </Button.Shadow>
            </Button>

            <Button Grid.Column="1"
                    Text="➕ Reportar"
                    Clicked="OnIrAReportarClicked"
                    HeightRequest="46"
                    BackgroundColor="#FFFFFF"
                    TextColor="{StaticResource PrimaryColor}"
                    BorderColor="{StaticResource CardBorder}"
                    BorderWidth="1"
                    FontAttributes="Bold"
                    FontSize="14"
                    CornerRadius="16" />
        </Grid>

        <!-- Lista de reportes -->
        <Border Grid.Row="4"
                Padding="12"
                Stroke="{StaticResource CardBorder}"
                StrokeThickness="1"
                BackgroundColor="#FFFFFF">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="#2B0B98"
                        Opacity="0.10"
                        Offset="0,4"
                        Radius="12" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,*">

                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="0,0,0,8">

                    <Label Text="Reportes cercanos"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextMain}"
                           VerticalOptions="Center" />

                    <Border Grid.Column="1"
                            BackgroundColor="{StaticResource PrimarySoft}"
                            Stroke="Transparent"
                            Padding="10,5"
                            VerticalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Label x:Name="LblResumenFiltro"
                               Text="0 reportes"
                               TextColor="{StaticResource PrimaryColor}"
                               FontSize="12"
                               FontAttributes="Bold" />
                    </Border>
                </Grid>

                <CollectionView x:Name="MascotasList"
                                Grid.Row="1"
                                SelectionMode="Single"
                                SelectionChanged="OnMascotaSeleccionada">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20"
                                             Spacing="8"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center">

                            <Label Text="🐾"
                                   FontSize="38"
                                   HorizontalOptions="Center" />

                            <Label Text="No hay reportes cercanos"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#334155"
                                   HorizontalOptions="Center" />

                            <Label Text="Actualiza el radar o registra un nuevo reporte."
                                   FontSize="13"
                                   TextColor="{StaticResource TextMuted}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border Margin="0,0,0,10"
                                    Padding="9"
                                    Stroke="#E6E0F8"
                                    StrokeThickness="1"
                                    BackgroundColor="#FFFFFF">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="74,*"
                                      ColumnSpacing="10">

                                    <Border Grid.Column="0"
                                            Stroke="Transparent"
                                            BackgroundColor="#F1F5F9"
                                            HeightRequest="68"
                                            WidthRequest="68"
                                            VerticalOptions="Center">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>

                                        <Image Source="{Binding FotoMostrar}"
                                               HeightRequest="68"
                                               WidthRequest="68"
                                               Aspect="AspectFill" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="3"
                                                         VerticalOptions="Center">

                                        <Grid ColumnDefinitions="*,Auto">

                                            <Label Text="{Binding Titulo}"
                                                   FontAttributes="Bold"
                                                   FontSize="14"
                                                   TextColor="{StaticResource TextMain}"
                                                   LineBreakMode="TailTruncation" />

                                            <Border Grid.Column="1"
                                                    BackgroundColor="{Binding TipoReporteFondo}"
                                                    Stroke="Transparent"
                                                    Padding="7,3"
                                                    Margin="6,0,0,0">

                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>

                                                <Label Text="{Binding TipoReporte}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding TipoReporteTexto}" />
                                            </Border>
                                        </Grid>

                                        <Label Text="{Binding Descripcion}"
                                               FontSize="12"
                                               TextColor="{StaticResource TextMuted}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />

                                        <Grid ColumnDefinitions="*,Auto"
                                              Margin="0,3,0,0">

                                            <Label Text="{Binding DistanciaMetros, StringFormat='📍 A {0:N0} metros de ti'}"
                                                   TextColor="{StaticResource PrimaryColor}"
                                                   FontSize="12"
                                                   FontAttributes="Bold" />

                                            <Label Grid.Column="1"
                                                   Text="Ver detalle"
                                                   TextColor="#0F766E"
                                                   FontSize="11"
                                                   FontAttributes="Bold" />
                                        </Grid>

                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>
        </Border>

    </Grid>
</ContentPage>