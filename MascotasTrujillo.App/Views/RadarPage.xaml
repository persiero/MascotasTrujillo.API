<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
    x:Class="MascotasTrujillo.App.Views.RadarPage"
    Title="Radar Comunitario"
    BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,*,Auto,Auto,260">

        <!-- Encabezado -->
        <Border Grid.Row="0"
                BackgroundColor="#FFFFFF"
                Stroke="Transparent"
                Padding="16,12">

            <Border.Shadow>
                <Shadow Brush="Black"
                        Opacity="0.06"
                        Offset="0,2"
                        Radius="6" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*"
                    ColumnSpacing="12">

                <Border Grid.Column="0"
                        BackgroundColor="#EEF2FF"
                        Stroke="Transparent"
                        HeightRequest="46"
                        WidthRequest="46"
                        VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="23" />
                    </Border.StrokeShape>

                    <Label Text="📡"
                           FontSize="24"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">

                    <Label Text="Reportes cerca de ti"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1E1B4B" />

                    <Label Text="Mascotas perdidas o encontradas según tu ubicación."
                           FontSize="12"
                           TextColor="#64748B"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

            </Grid>
        </Border>

        <!-- Mapa -->
        <Border Grid.Row="1"
                Margin="14,14,14,8"
                Stroke="Transparent"
                BackgroundColor="#E2E8F0">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="Black"
                        Opacity="0.12"
                        Offset="0,4"
                        Radius="10" />
            </Border.Shadow>

            <maps:Map x:Name="MapaMascotas"
                      IsShowingUser="True" />
        </Border>

        <!-- Filtros -->
        <Border Grid.Row="2"
                Margin="14,0,14,6"
                Padding="12"
                Stroke="Transparent"
                BackgroundColor="#FFFFFF">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="*,*"
                    ColumnSpacing="10">

                <Border Grid.Column="0"
                        BackgroundColor="#F8FAFC"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="10,6">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="2">

                        <Label Text="Tipo"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#64748B" />

                        <Picker x:Name="FiltroTipoPicker"
                                Title="Todos"
                                SelectedIndexChanged="OnFiltroTipoChanged"
                                BackgroundColor="Transparent"
                                TextColor="#1E293B"
                                FontAttributes="Bold">

                            <Picker.Items>
                                <x:String>Todos</x:String>
                                <x:String>Perdidas</x:String>
                                <x:String>Encontradas</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        BackgroundColor="#F8FAFC"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="10,6">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="2">

                        <Label Text="Radio"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#64748B" />

                        <Picker x:Name="RadioPicker"
                                Title="5 km"
                                BackgroundColor="Transparent"
                                TextColor="#1E293B"
                                FontAttributes="Bold">

                            <Picker.Items>
                                <x:String>1 km</x:String>
                                <x:String>3 km</x:String>
                                <x:String>5 km</x:String>
                                <x:String>10 km</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>
                </Border>

            </Grid>
        </Border>

        <!-- Botones de acción -->
        <Grid Grid.Row="3"
              Padding="14,6,14,8"
              ColumnDefinitions="*,*"
              ColumnSpacing="10">

            <Button x:Name="BtnActualizar"
                    Grid.Column="0"
                    Text="🔄 Buscar cerca"
                    Clicked="OnActualizarClicked"
                    HeightRequest="48"
                    BackgroundColor="#2B0B98"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="16" />

            <Button Grid.Column="1"
                    Text="➕ Reportar"
                    Clicked="OnIrAReportarClicked"
                    HeightRequest="48"
                    BackgroundColor="#EEF2FF"
                    TextColor="#2B0B98"
                    FontAttributes="Bold"
                    CornerRadius="16" />

        </Grid>

        <!-- Lista de reportes -->
        <Border Grid.Row="4"
                Margin="14,0,14,14"
                Padding="12"
                Stroke="Transparent"
                BackgroundColor="#FFFFFF">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="Black"
                        Opacity="0.08"
                        Offset="0,3"
                        Radius="8" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,*">

                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="0,0,0,8">

                    <VerticalStackLayout>
                        <Label Text="Reportes cercanos"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#1E293B" />

                        <Label Text="Selecciona un reporte para ver más detalles."
                               FontSize="12"
                               TextColor="#64748B" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            BackgroundColor="#EEF2FF"
                            Stroke="Transparent"
                            Padding="10,5"
                            VerticalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Label x:Name="LblResumenFiltro"
                               Text="0 reportes"
                               TextColor="#2B0B98"
                               FontSize="12"
                               FontAttributes="Bold" />
                    </Border>
                </Grid>

                <CollectionView x:Name="MascotasList"
                                Grid.Row="1"
                                SelectionMode="Single"
                                SelectionChanged="OnMascotaSeleccionada">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20"
                                             Spacing="8"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center">
                            <Label Text="🐾"
                                   FontSize="38"
                                   HorizontalOptions="Center" />

                            <Label Text="No hay reportes cercanos"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#334155"
                                   HorizontalOptions="Center" />

                            <Label Text="Actualiza el radar o registra un nuevo reporte."
                                   FontSize="13"
                                   TextColor="#64748B"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border Margin="0,0,0,10"
                                    Padding="10"
                                    Stroke="#E2E8F0"
                                    BackgroundColor="#FFFFFF">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="86,*"
                                      ColumnSpacing="12">

                                    <Border Grid.Column="0"
                                            Stroke="Transparent"
                                            BackgroundColor="#F1F5F9"
                                            HeightRequest="78"
                                            WidthRequest="78">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>

                                        <Image Source="{Binding FotoUrl}"
                                               HeightRequest="78"
                                               WidthRequest="78"
                                               Aspect="AspectFill" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="4"
                                                         VerticalOptions="Center">

                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Titulo}"
                                                   FontAttributes="Bold"
                                                   FontSize="15"
                                                   TextColor="#1E293B"
                                                   LineBreakMode="TailTruncation" />

                                            <Border Grid.Column="1"
                                                    BackgroundColor="{Binding TipoReporteFondo}"
                                                    Stroke="Transparent"
                                                    Padding="8,3"
                                                    Margin="6,0,0,0">

                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>

                                                <Label Text="{Binding TipoReporte}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding TipoReporteTexto}" />
                                            </Border>
                                        </Grid>

                                        <Label Text="{Binding Descripcion}"
                                               FontSize="13"
                                               TextColor="#64748B"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />

                                        <Grid ColumnDefinitions="*,Auto"
                                              Margin="0,4,0,0">

                                            <Label Text="{Binding DistanciaMetros, StringFormat='📍 A {0:N0} metros de ti'}"
                                                   TextColor="#2B0B98"
                                                   FontSize="13"
                                                   FontAttributes="Bold" />

                                            <Label Grid.Column="1"
                                                   Text="Ver detalle"
                                                   TextColor="#0F766E"
                                                   FontSize="12"
                                                   FontAttributes="Bold" />
                                        </Grid>

                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>
        </Border>

    </Grid>
</ContentPage>