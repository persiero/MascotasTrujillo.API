<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
    x:Class="MascotasTrujillo.App.Views.RadarPage"
    Title="Radar"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F1FF">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="AccentPink">#FF4FB3</Color>
            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Color x:Key="CardBorder">#E1D6FF</Color>
            <Color x:Key="InputBorder">#D8CCFF</Color>
            <Color x:Key="InputBackground">#F8F5FF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,300,Auto,*"
      Padding="12,12,12,8"
      RowSpacing="8">

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F8F5FF" Offset="0.0" />
                <GradientStop Color="#F3EDFF" Offset="0.55" />
                <GradientStop Color="#FDFBFF" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Encabezado compacto -->
        <Border Grid.Row="0"
                BackgroundColor="#FFFFFF"
                Stroke="{StaticResource CardBorder}"
                StrokeThickness="1"
                Padding="14,10">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="#2B0B98"
                        Opacity="0.10"
                        Offset="0,4"
                        Radius="12" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="10">

                <Border Grid.Column="0"
                        BackgroundColor="{StaticResource PrimarySoft}"
                        Stroke="Transparent"
                        HeightRequest="42"
                        WidthRequest="42"
                        VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="21" />
                    </Border.StrokeShape>

                    <Label Text="📡"
                           FontSize="22"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label Grid.Column="1"
                       Text="Reportes cerca de ti"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextMain}"
                       VerticalOptions="Center" />

                <Border Grid.Column="2"
                        BackgroundColor="#FCE7F3"
                        Stroke="Transparent"
                        Padding="9,5"
                        VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Label x:Name="LblResumenFiltroSuperior"
                           Text="Radar"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#BE185D" />
                </Border>
            </Grid>
        </Border>

        <!-- Mapa -->
        <Border Grid.Row="1"
                Stroke="{StaticResource CardBorder}"
                StrokeThickness="1"
                BackgroundColor="#E2E8F0">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="#2B0B98"
                        Opacity="0.13"
                        Offset="0,5"
                        Radius="14" />
            </Border.Shadow>

            <maps:Map x:Name="MapaMascotas"
                    IsShowingUser="True" />
            
        </Border>

        <!-- Acciones rápidas -->
        <Grid Grid.Row="2"
      ColumnDefinitions="*,Auto,*"
      ColumnSpacing="8">

            <Button x:Name="BtnActualizar"
            Grid.Column="0"
            Text="🔄 Actualizar"
            Clicked="OnActualizarClicked"
            HeightRequest="46"
            BackgroundColor="{StaticResource PrimaryColor}"
            TextColor="White"
            FontAttributes="Bold"
            FontSize="13"
            CornerRadius="16" />

            <Button Grid.Column="1"
            Text="⚙️ Filtros"
            Clicked="OnAbrirFiltrosClicked"
            HeightRequest="46"
            BackgroundColor="#FFFFFF"
            TextColor="{StaticResource PrimaryColor}"
            BorderColor="{StaticResource CardBorder}"
            BorderWidth="1"
            FontAttributes="Bold"
            FontSize="13"
            CornerRadius="16"
            Padding="14,0" />

            <Button Grid.Column="2"
            Text="➕ Reportar"
            Clicked="OnIrAReportarClicked"
            HeightRequest="46"
            BackgroundColor="#FFFFFF"
            TextColor="{StaticResource PrimaryColor}"
            BorderColor="{StaticResource CardBorder}"
            BorderWidth="1"
            FontAttributes="Bold"
            FontSize="13"
            CornerRadius="16" />
        </Grid>

        <!-- Lista de reportes -->
        <Border Grid.Row="3"
                Padding="12"
                Stroke="{StaticResource CardBorder}"
                StrokeThickness="1"
                BackgroundColor="#FFFFFF">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="#2B0B98"
                        Opacity="0.10"
                        Offset="0,4"
                        Radius="12" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,*">

                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="0,0,0,8">

                    <Label Text="Reportes cercanos"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextMain}"
                           VerticalOptions="Center" />

                    <Border Grid.Column="1"
                            BackgroundColor="{StaticResource PrimarySoft}"
                            Stroke="Transparent"
                            Padding="10,5"
                            VerticalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Label x:Name="LblResumenFiltro"
                               Text="0 reportes"
                               TextColor="{StaticResource PrimaryColor}"
                               FontSize="12"
                               FontAttributes="Bold" />
                    </Border>
                </Grid>

                <CollectionView x:Name="MascotasList"
                                Grid.Row="1"
                                SelectionMode="Single"
                                SelectionChanged="OnMascotaSeleccionada">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20"
                                             Spacing="8"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center">

                            <Label Text="🐾"
                                   FontSize="38"
                                   HorizontalOptions="Center" />

                            <Label Text="No hay reportes cercanos"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#334155"
                                   HorizontalOptions="Center" />

                            <Label Text="Actualiza el radar o registra un nuevo reporte."
                                   FontSize="13"
                                   TextColor="{StaticResource TextMuted}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border Margin="0,0,0,10"
                                    Padding="9"
                                    Stroke="#E6E0F8"
                                    StrokeThickness="1"
                                    BackgroundColor="#FFFFFF">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="74,*"
                                      ColumnSpacing="10">

                                    <Border Grid.Column="0"
                                            Stroke="Transparent"
                                            BackgroundColor="#F1F5F9"
                                            HeightRequest="68"
                                            WidthRequest="68"
                                            VerticalOptions="Center">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>

                                        <Image Source="{Binding FotoMostrar}"
                                               HeightRequest="68"
                                               WidthRequest="68"
                                               Aspect="AspectFill" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="3"
                                                         VerticalOptions="Center">

                                        <Grid ColumnDefinitions="*,Auto">

                                            <Label Text="{Binding Titulo}"
                                                   FontAttributes="Bold"
                                                   FontSize="14"
                                                   TextColor="{StaticResource TextMain}"
                                                   LineBreakMode="TailTruncation" />

                                            <Border Grid.Column="1"
                                                    BackgroundColor="{Binding TipoReporteFondo}"
                                                    Stroke="Transparent"
                                                    Padding="7,3"
                                                    Margin="6,0,0,0">

                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>

                                                <Label Text="{Binding TipoReporte}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding TipoReporteTexto}" />
                                            </Border>
                                        </Grid>

                                        <Label Text="{Binding Descripcion}"
                                               FontSize="12"
                                               TextColor="{StaticResource TextMuted}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />

                                        <Grid ColumnDefinitions="*,Auto"
                                              Margin="0,3,0,0">

                                            <Label Text="{Binding DistanciaMetros, StringFormat='📍 A {0:N0} metros de ti'}"
                                                   TextColor="{StaticResource PrimaryColor}"
                                                   FontSize="12"
                                                   FontAttributes="Bold" />

                                            <Label Grid.Column="1"
                                                   Text="Ver detalle"
                                                   TextColor="#0F766E"
                                                   FontSize="11"
                                                   FontAttributes="Bold" />
                                        </Grid>

                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>
        </Border>

        <!-- Modal de filtros -->
        <Grid x:Name="FiltrosOverlay"
      Grid.RowSpan="4"
      IsVisible="False"
      Opacity="0"
      BackgroundColor="#99000000"
      Padding="18">

            <BoxView BackgroundColor="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCerrarFiltrosClicked" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border VerticalOptions="End"
            BackgroundColor="#FFFFFF"
            Stroke="{StaticResource CardBorder}"
            StrokeThickness="1"
            Padding="16"
            Margin="0,0,0,12">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="Black"
                    Opacity="0.18"
                    Offset="0,6"
                    Radius="18" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Filtros del radar"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextMain}" />

                            <Label x:Name="LblFiltroActual"
                           Text="Todos · 10 km"
                           FontSize="12"
                           TextColor="{StaticResource TextMuted}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                        Text="✕"
                        Clicked="OnCerrarFiltrosClicked"
                        WidthRequest="36"
                        HeightRequest="36"
                        CornerRadius="18"
                        Padding="0"
                        BackgroundColor="{StaticResource PrimarySoft}"
                        TextColor="{StaticResource PrimaryDark}"
                        FontAttributes="Bold" />
                    </Grid>

                    <BoxView HeightRequest="1"
                     Color="#EEE7FF" />

                    <Label Text="Tipo de reporte"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextMuted}" />

                    <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="8">

                        <Button x:Name="BtnTipoTodos"
                        Grid.Column="0"
                        Text="Todos"
                        Clicked="OnTipoTodosClicked"
                        HeightRequest="42"
                        CornerRadius="16"
                        FontSize="12"
                        FontAttributes="Bold" />

                        <Button x:Name="BtnTipoPerdidas"
                        Grid.Column="1"
                        Text="Perdidas"
                        Clicked="OnTipoPerdidasClicked"
                        HeightRequest="42"
                        CornerRadius="16"
                        FontSize="12"
                        FontAttributes="Bold" />

                        <Button x:Name="BtnTipoEncontradas"
                        Grid.Column="2"
                        Text="Encontradas"
                        Clicked="OnTipoEncontradasClicked"
                        HeightRequest="42"
                        CornerRadius="16"
                        FontSize="12"
                        FontAttributes="Bold" />
                    </Grid>

                    <Label Text="Radio de búsqueda"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextMuted}" />

                    <Grid ColumnDefinitions="*,*,*,*"
                        ColumnSpacing="8">

                        <Button x:Name="BtnRadio5"
                                Grid.Column="0"
                                Text="5 km"
                                Clicked="OnRadio5Clicked"
                                HeightRequest="42"
                                CornerRadius="16"
                                FontSize="12"
                                FontAttributes="Bold" />

                        <Button x:Name="BtnRadio10"
                                Grid.Column="1"
                                Text="10 km"
                                Clicked="OnRadio10Clicked"
                                HeightRequest="42"
                                CornerRadius="16"
                                FontSize="12"
                                FontAttributes="Bold" />

                        <Button x:Name="BtnRadio15"
                                Grid.Column="2"
                                Text="15 km"
                                Clicked="OnRadio15Clicked"
                                HeightRequest="42"
                                CornerRadius="16"
                                FontSize="12"
                                FontAttributes="Bold" />

                        <Button x:Name="BtnRadio20"
                                Grid.Column="3"
                                Text="20 km"
                                Clicked="OnRadio20Clicked"
                                HeightRequest="42"
                                CornerRadius="16"
                                FontSize="12"
                                FontAttributes="Bold" />
                    </Grid>

                    <Button Text="Listo"
                    Clicked="OnCerrarFiltrosClicked"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="14"
                    CornerRadius="18"
                    HeightRequest="48" />

                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>