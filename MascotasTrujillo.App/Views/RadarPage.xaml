<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             x:Class="MascotasTrujillo.App.Views.RadarPage"
             Title="Radar Activo">

    <Grid RowDefinitions="*,Auto,250">

        <maps:Map x:Name="MapaMascotas" 
                  Grid.Row="0"
                  IsShowingUser="True" />

        <HorizontalStackLayout Grid.Row="1" Padding="10" Spacing="15" HorizontalOptions="Center">
            <Button x:Name="BtnActualizar"
                    Text="🔄 Actualizar Radar" 
                    Clicked="OnActualizarClicked" 
                    HeightRequest="45" 
                    BackgroundColor="#2B0B98" 
                    TextColor="White" 
                    CornerRadius="10" 
                    Padding="15,0"/>

            <Button Text="➕ Reportar Mascota" 
                    Clicked="OnIrAReportarClicked" 
                    HeightRequest="45" 
                    BackgroundColor="#E0E0E0" 
                    TextColor="#2B0B98" 
                    CornerRadius="10" 
                    Padding="15,0"/>
        </HorizontalStackLayout>

        <CollectionView x:Name="MascotasList" 
                        Grid.Row="2" 
                        Margin="10" 
                        SelectionMode="Single"
                        SelectionChanged="OnMascotaSeleccionada">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10" 
                            Padding="10" 
                            Stroke="Transparent" 
                            BackgroundColor="White">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.15" Offset="0,3" Radius="5" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="100,*">
                            <Image Grid.Column="0" Source="{Binding FotoUrl}" HeightRequest="80" WidthRequest="80" Aspect="AspectFill" />

                            <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                                <Label Text="{Binding Descripcion}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding DistanciaMetros, StringFormat='A {0:N0} metros de ti'}" TextColor="#2B0B98" FontSize="14" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>