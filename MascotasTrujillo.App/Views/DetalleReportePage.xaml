<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MascotasTrujillo.App.Views.DetalleReportePage"
    Title="Detalle del Reporte"
    BackgroundColor="#F5F1FF">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="AccentPink">#FF4FB3</Color>
            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Color x:Key="CardBorder">#E1D6FF</Color>
            <Color x:Key="InputBackground">#F8F5FF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F8F5FF" Offset="0.0" />
                <GradientStop Color="#F3EDFF" Offset="0.55" />
                <GradientStop Color="#FDFBFF" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="12,12,12,20"
                                 Spacing="10">

                <!-- Imagen principal -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        HeightRequest="220">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.13"
                                Offset="0,5"
                                Radius="14" />
                    </Border.Shadow>

                    <Grid BackgroundColor="#F8F5FF">

                        <Image x:Name="FotoReporteImage"
                               Source="{Binding FotoUrl}"
                               Aspect="AspectFit"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill" />

                        <Border BackgroundColor="{Binding TipoReporteFondo}"
                                Stroke="Transparent"
                                Padding="10,5"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                Margin="12">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Label Text="{Binding TipoReporte}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{Binding TipoReporteTexto}" />
                        </Border>

                    </Grid>
                </Border>

                <!-- Información principal -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.10"
                                Offset="0,4"
                                Radius="12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <Label Text="{Binding Titulo}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextMain}"
                               LineBreakMode="WordWrap" />

                        <Label Text="{Binding Descripcion}"
                               FontSize="14"
                               TextColor="{StaticResource TextMuted}"
                               LineBreakMode="WordWrap" />

                        <Grid ColumnDefinitions="Auto,*"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="8"
                              Margin="0,4,0,0">

                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   Text="📍"
                                   FontSize="15" />

                            <Label x:Name="LblDistancia"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   FontSize="13"
                                   TextColor="{StaticResource PrimaryColor}"
                                   FontAttributes="Bold" />

                            <Label Grid.Row="1"
                                   Grid.Column="0"
                                   Text="📅"
                                   FontSize="15" />

                            <Label Text="{Binding FechaReporte, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   FontSize="13"
                                   TextColor="{StaticResource TextMuted}" />

                            <Label Grid.Row="2"
                                   Grid.Column="0"
                                   Text="📌"
                                   FontSize="15" />

                            <Border Grid.Row="2"
                                    Grid.Column="1"
                                    BackgroundColor="{Binding EstadoReporteFondo}"
                                    Stroke="Transparent"
                                    Padding="10,4"
                                    HorizontalOptions="Start">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Label Text="{Binding EstadoReporte}"
                                       FontSize="12"
                                       TextColor="{Binding EstadoReporteTexto}"
                                       FontAttributes="Bold" />
                            </Border>

                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Datos referenciales de la mascota -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.08"
                                Offset="0,3"
                                Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <Label Text="Mascota"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextMain}" />

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="10">

                            <Border Grid.Row="0"
                                    Grid.Column="0"
                                    BackgroundColor="{StaticResource InputBackground}"
                                    Stroke="Transparent"
                                    Padding="10">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Nombre"
                                           FontSize="11"
                                           TextColor="#94A3B8" />
                                    <Label x:Name="LblNombreMascota"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextMain}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    BackgroundColor="{StaticResource InputBackground}"
                                    Stroke="Transparent"
                                    Padding="10">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Especie"
                                           FontSize="11"
                                           TextColor="#94A3B8" />
                                    <Label x:Name="LblEspecie"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextMain}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1"
                                    Grid.Column="0"
                                    BackgroundColor="{StaticResource InputBackground}"
                                    Stroke="Transparent"
                                    Padding="10">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Raza"
                                           FontSize="11"
                                           TextColor="#94A3B8" />
                                    <Label x:Name="LblRaza"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextMain}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    BackgroundColor="{StaticResource InputBackground}"
                                    Stroke="Transparent"
                                    Padding="10">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Color"
                                           FontSize="11"
                                           TextColor="#94A3B8" />
                                    <Label x:Name="LblColor"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextMain}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="2"
                                    Grid.Column="0"
                                    BackgroundColor="{StaticResource InputBackground}"
                                    Stroke="Transparent"
                                    Padding="10">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Sexo"
                                           FontSize="11"
                                           TextColor="#94A3B8" />
                                    <Label x:Name="LblSexo"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextMain}" />
                                </VerticalStackLayout>
                            </Border>

                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Información de salud -->
                <Border x:Name="SeccionSalud"
                        BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="16"
                        IsVisible="False">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.08"
                                Offset="0,3"
                                Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10">

                            <Border BackgroundColor="#FEF3C7"
                                    Stroke="Transparent"
                                    WidthRequest="38"
                                    HeightRequest="38"
                                    VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="19" />
                                </Border.StrokeShape>

                                <Label Text="🩺"
                                       FontSize="19"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="1"
                                                 VerticalOptions="Center">

                                <Label Text="Salud"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextMain}" />

                                <Label Text="Cuidados importantes"
                                       FontSize="12"
                                       TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="10">

                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   Text="🩺"
                                   FontSize="15" />

                            <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                                <Label Text="Enfermedades"
                                       FontSize="11"
                                       TextColor="#94A3B8" />
                                <Label x:Name="LblEnfermedades"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextMain}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <Label Grid.Row="1"
                                   Grid.Column="0"
                                   Text="♿"
                                   FontSize="15" />

                            <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                <Label Text="Discapacidades"
                                       FontSize="11"
                                       TextColor="#94A3B8" />
                                <Label x:Name="LblDiscapacidades"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextMain}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <Label Grid.Row="2"
                                   Grid.Column="0"
                                   Text="💊"
                                   FontSize="15" />

                            <VerticalStackLayout Grid.Row="2" Grid.Column="1">
                                <Label Text="Tratamientos"
                                       FontSize="11"
                                       TextColor="#94A3B8" />
                                <Label x:Name="LblTratamientos"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextMain}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <Label Grid.Row="3"
                                   Grid.Column="0"
                                   Text="⚠️"
                                   FontSize="15" />

                            <VerticalStackLayout Grid.Row="3" Grid.Column="1">
                                <Label Text="Necesidades especiales"
                                       FontSize="11"
                                       TextColor="#94A3B8" />
                                <Label x:Name="LblNecesidadesEspeciales"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextMain}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <Label Grid.Row="4"
                                   Grid.Column="0"
                                   Text="📝"
                                   FontSize="15" />

                            <VerticalStackLayout Grid.Row="4" Grid.Column="1">
                                <Label Text="Observaciones"
                                       FontSize="11"
                                       TextColor="#94A3B8" />
                                <Label x:Name="LblObservacionesSalud"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextMain}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Avistamientos registrados -->
                <Border x:Name="SeccionAvistamientos"
                        BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.08"
                                Offset="0,3"
                                Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Avistamientos"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextMain}" />

                                <Label x:Name="LblAvistamientosResumen"
                                       Text="Sin avistamientos registrados."
                                       FontSize="12"
                                       TextColor="{StaticResource TextMuted}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="↻"
                                    Clicked="OnActualizarAvistamientosClicked"
                                    BackgroundColor="{StaticResource PrimarySoft}"
                                    TextColor="{StaticResource PrimaryColor}"
                                    BorderColor="{StaticResource CardBorder}"
                                    BorderWidth="1"
                                    CornerRadius="14"
                                    FontAttributes="Bold"
                                    HeightRequest="38"
                                    WidthRequest="42"
                                    Padding="0"
                                    VerticalOptions="Center" />
                        </Grid>

                        <CollectionView x:Name="AvistamientosList"
                                        SelectionMode="None"
                                        HeightRequest="210">

                            <CollectionView.EmptyView>
                                <VerticalStackLayout Padding="20"
                                                     Spacing="8"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center">

                                    <Label Text="👀"
                                           FontSize="34"
                                           HorizontalOptions="Center" />

                                    <Label Text="Sin avistamientos"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextMain}"
                                           HorizontalOptions="Center" />

                                    <Label Text="Aparecerán aquí cuando alguien reporte una pista."
                                           FontSize="12"
                                           TextColor="{StaticResource TextMuted}"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>

                                    <Border Margin="0,0,0,10"
                                            Padding="10"
                                            BackgroundColor="{StaticResource InputBackground}"
                                            Stroke="{StaticResource CardBorder}"
                                            StrokeThickness="1">

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnAvistamientoTapped"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="18" />
                                        </Border.StrokeShape>

                                        <Grid ColumnDefinitions="70,*"
                                              ColumnSpacing="10">

                                            <Border Grid.Column="0"
                                                    BackgroundColor="#E2E8F0"
                                                    Stroke="Transparent"
                                                    HeightRequest="64"
                                                    WidthRequest="64"
                                                    VerticalOptions="Center">

                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="14" />
                                                </Border.StrokeShape>

                                                <Image Source="{Binding FotoMostrar}"
                                                       Aspect="AspectFill"
                                                       HeightRequest="64"
                                                       WidthRequest="64" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="4"
                                                                 VerticalOptions="Center">

                                                <Label Text="{Binding Descripcion}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextMain}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="2" />

                                                <Label Text="{Binding ResumenUbicacion}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource TextMuted}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />

                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="{Binding FechaResumen}"
                                                           FontSize="11"
                                                           TextColor="#94A3B8"
                                                           LineBreakMode="TailTruncation" />

                                                    <Border Grid.Column="1"
                                                            BackgroundColor="{Binding DetalleChipFondo}"
                                                            Stroke="Transparent"
                                                            Padding="7,3"
                                                            HorizontalOptions="End">

                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="10" />
                                                        </Border.StrokeShape>

                                                        <Label Text="{Binding DetalleChipTexto}"
                                                               FontSize="10"
                                                               FontAttributes="Bold"
                                                               TextColor="{Binding DetalleChipColor}" />
                                                    </Border>
                                                </Grid>

                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>

                <!-- Acciones -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="{StaticResource CardBorder}"
                        StrokeThickness="1"
                        Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2B0B98"
                                Opacity="0.08"
                                Offset="0,3"
                                Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <Label Text="Acciones"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextMain}" />

                        <Button Text="📍 Ver ubicación"
                                Clicked="OnVerUbicacionClicked"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                TextColor="{StaticResource PrimaryDark}"
                                BorderColor="{StaticResource CardBorder}"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="46" />

                        <Button x:Name="BtnRegistrarAvistamiento"
                                Text="👀 Registrar avistamiento"
                                Clicked="OnRegistrarAvistamientoClicked"
                                BackgroundColor="#0F766E"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="46" />

                        <Label x:Name="LblAvistamientoNoDisponible"
                               Text="Acción no disponible para este reporte."
                               FontSize="12"
                               TextColor="{StaticResource TextMuted}"
                               HorizontalTextAlignment="Center"
                               IsVisible="False" />

                        <Button x:Name="BtnWhatsApp"
                                Text="💬 Contactar por WhatsApp"
                                Clicked="OnWhatsAppClicked"
                                BackgroundColor="#22C55E"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="46" />

                        <Label x:Name="LblReportePropio"
                               Text="Este reporte fue creado por ti."
                               FontSize="12"
                               TextColor="{StaticResource TextMuted}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               IsVisible="False" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>