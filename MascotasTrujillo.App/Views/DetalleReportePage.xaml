<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MascotasTrujillo.App.Views.DetalleReportePage"
    Title="Detalle del Reporte"
    BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="16">

            <!-- Imagen principal -->
            <Border BackgroundColor="#E2E8F0"
                    Stroke="Transparent"
                    HeightRequest="250">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="Black"
                            Opacity="0.12"
                            Offset="0,4"
                            Radius="10" />
                </Border.Shadow>

                <Grid>
                    <Image x:Name="FotoReporteImage"
                           Source="{Binding FotoUrl}"
                           Aspect="AspectFill" />

                    <Border BackgroundColor="{Binding TipoReporteFondo}"
                            Stroke="Transparent"
                            Padding="10,5"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            Margin="12">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Label Text="{Binding TipoReporte}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{Binding TipoReporteTexto}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Información principal -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="Black"
                            Opacity="0.08"
                            Offset="0,3"
                            Radius="8" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">

                    <Label Text="{Binding Titulo}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#1E1B4B" />

                    <Label Text="{Binding Descripcion}"
                           FontSize="14"
                           TextColor="#475569"
                           LineBreakMode="WordWrap" />

                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="8"
                          Margin="0,8,0,0">

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="📍"
                               FontSize="16" />

                        <Label x:Name="LblDistancia"
                               Grid.Row="0"
                               Grid.Column="1"
                               FontSize="13"
                               TextColor="#2B0B98"
                               FontAttributes="Bold" />

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Text="📅"
                               FontSize="16" />

                        <Label Text="{Binding FechaReporte, StringFormat='Registrado el {0:dd/MM/yyyy HH:mm}'}"
                               Grid.Row="1"
                               Grid.Column="1"
                               FontSize="13"
                               TextColor="#64748B" />

                        <Label Grid.Row="2"
                               Grid.Column="0"
                               Text="📌"
                               FontSize="16" />

                        <Border Grid.Row="2"
                                Grid.Column="1"
                                BackgroundColor="{Binding EstadoReporteFondo}"
                                Stroke="Transparent"
                                Padding="10,4"
                                HorizontalOptions="Start">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Label Text="{Binding EstadoReporte}"
                                   FontSize="12"
                                   TextColor="{Binding EstadoReporteTexto}"
                                   FontAttributes="Bold" />
                        </Border>

                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Datos referenciales de la mascota -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label Text="Datos de la mascota"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="8">

                        <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                            <Label Text="Nombre"
                                   FontSize="11"
                                   TextColor="#94A3B8" />
                            <Label x:Name="LblNombreMascota"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#334155" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                            <Label Text="Especie"
                                   FontSize="11"
                                   TextColor="#94A3B8" />
                            <Label x:Name="LblEspecie"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#334155" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                            <Label Text="Raza"
                                   FontSize="11"
                                   TextColor="#94A3B8" />
                            <Label x:Name="LblRaza"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#334155" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                            <Label Text="Color"
                                   FontSize="11"
                                   TextColor="#94A3B8" />
                            <Label x:Name="LblColor"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#334155" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="2" Grid.Column="0">
                            <Label Text="Sexo"
                                   FontSize="11"
                                   TextColor="#94A3B8" />
                            <Label x:Name="LblSexo"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#334155" />
                        </VerticalStackLayout>

                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Información de salud -->
            <Border x:Name="SeccionSalud"
                    BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="18"
                    IsVisible="False">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label Text="Información importante de salud"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />

                    <Label Text="Estos datos ayudan a cuidar mejor a la mascota en caso sea encontrada."
                           FontSize="12"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />

                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="10">

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="🩺"
                               FontSize="16" />

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                            <Label Text="Enfermedades"
                                   FontSize="11"
                                   TextColor="#94A3B8" />
                            <Label x:Name="LblEnfermedades"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#334155"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Text="♿"
                               FontSize="16" />

                        <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                            <Label Text="Discapacidades"
                                   FontSize="11"
                                   TextColor="#94A3B8" />
                            <Label x:Name="LblDiscapacidades"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#334155"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <Label Grid.Row="2"
                               Grid.Column="0"
                               Text="💊"
                               FontSize="16" />

                        <VerticalStackLayout Grid.Row="2" Grid.Column="1">
                            <Label Text="Tratamientos"
                                   FontSize="11"
                                   TextColor="#94A3B8" />
                            <Label x:Name="LblTratamientos"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#334155"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <Label Grid.Row="3"
                               Grid.Column="0"
                               Text="⚠️"
                               FontSize="16" />

                        <VerticalStackLayout Grid.Row="3" Grid.Column="1">
                            <Label Text="Necesidades especiales"
                                   FontSize="11"
                                   TextColor="#94A3B8" />
                            <Label x:Name="LblNecesidadesEspeciales"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#334155"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <Label Grid.Row="4"
                               Grid.Column="0"
                               Text="📝"
                               FontSize="16" />

                        <VerticalStackLayout Grid.Row="4" Grid.Column="1">
                            <Label Text="Observaciones"
                                   FontSize="11"
                                   TextColor="#94A3B8" />
                            <Label x:Name="LblObservacionesSalud"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#334155"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                    </Grid>

                    <Border BackgroundColor="#FEF3C7"
                            Stroke="Transparent"
                            Padding="12">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Label Text="Si encuentras esta mascota, revisa estos cuidados antes de manipularla o alimentarla."
                               FontSize="12"
                               TextColor="#92400E"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- Avistamientos registrados -->
            <Border x:Name="SeccionAvistamientos"
                    BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Avistamientos registrados"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B" />

                            <Label x:Name="LblAvistamientosResumen"
                                   Text="Consulta los puntos reportados por la comunidad."
                                   FontSize="12"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="🔄"
                                Clicked="OnActualizarAvistamientosClicked"
                                BackgroundColor="#EEF2FF"
                                TextColor="#2B0B98"
                                CornerRadius="14"
                                HeightRequest="40"
                                WidthRequest="44"
                                VerticalOptions="Center" />
                    </Grid>

                    <CollectionView x:Name="AvistamientosList"
                                    SelectionMode="None"
                                    HeightRequest="220">

                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="20"
                                                 Spacing="8"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center">

                                <Label Text="👀"
                                       FontSize="36"
                                       HorizontalOptions="Center" />

                                <Label Text="Aún no hay avistamientos"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#334155"
                                       HorizontalOptions="Center" />

                                <Label Text="Cuando alguien vea a la mascota, su aviso aparecerá aquí."
                                       FontSize="12"
                                       TextColor="#64748B"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Border Margin="0,0,0,10"
                                        Padding="10"
                                        BackgroundColor="#F8FAFC"
                                        Stroke="#E2E8F0">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>

                                    <Grid ColumnDefinitions="76,*"
                                            ColumnSpacing="12">

                                        <Border Grid.Column="0"
                                                BackgroundColor="#E2E8F0"
                                                Stroke="Transparent"
                                                HeightRequest="70"
                                                WidthRequest="70">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>

                                            <Image Source="{Binding FotoMostrar}"
                                                   Aspect="AspectFill"
                                                   HeightRequest="70"
                                                   WidthRequest="70" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="4"
                                                             VerticalOptions="Center">

                                            <Label Text="{Binding Descripcion}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#1E293B"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2" />

                                            <Label Text="{Binding DireccionReferencia}"
                                                   FontSize="12"
                                                   TextColor="#64748B"
                                                   LineBreakMode="TailTruncation" />

                                            <Label Text="{Binding FechaAvistamiento, StringFormat='📅 {0:dd/MM/yyyy HH:mm}'}"
                                                   FontSize="12"
                                                   TextColor="#94A3B8" />

                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Border>

            <!-- Acciones -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="Transparent"
                    Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label Text="Acciones"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />

                    <Button Text="📍 Ver ubicación del reporte"
                            Clicked="OnVerUbicacionClicked"
                            BackgroundColor="#EEF2FF"
                            TextColor="#2B0B98"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="48" />

                    <Button x:Name="BtnRegistrarAvistamiento"
                            Text="👀 Registrar avistamiento"
                            Clicked="OnRegistrarAvistamientoClicked"
                            BackgroundColor="#0F766E"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="48" />

                    <Label x:Name="LblAvistamientoNoDisponible"
                           Text="Los avistamientos solo pueden registrarse en reportes activos de mascotas perdidas."
                           FontSize="12"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center"
                           IsVisible="False" />

                    <Button x:Name="BtnWhatsApp"
                            Text="💬 Contactar por WhatsApp"
                            Clicked="OnWhatsAppClicked"
                            BackgroundColor="#22C55E"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="48" />

                    <Label x:Name="LblReportePropio"
                           Text="Este reporte fue creado por ti. Por eso no se muestran acciones de contacto ni registro de avistamiento."
                           FontSize="12"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           IsVisible="False" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>