<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MascotasTrujillo.App.Views.DetalleReportePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalle del Reporte"
    BackgroundColor="#F5F1FF">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#5B21E6</Color>
            <Color x:Key="PrimaryDark">#2B0B98</Color>
            <Color x:Key="PrimaryDeep">#4C1D95</Color>
            <Color x:Key="PrimarySoft">#EEE7FF</Color>
            <Color x:Key="PrimarySoft2">#F3E8FF</Color>

            <Color x:Key="AccentPink">#FF4FB3</Color>
            <Color x:Key="AccentPinkSoft">#FDF2F8</Color>
            <Color x:Key="AccentPinkBorder">#F9A8D4</Color>
            <Color x:Key="AccentPinkText">#DB2777</Color>

            <Color x:Key="TextMain">#1F2340</Color>
            <Color x:Key="TextTitle">#1E1B4B</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Color x:Key="TextSecondary">#475569</Color>
            <Color x:Key="TextLight">#8A86A3</Color>

            <Color x:Key="CardBorder">#DCCBFF</Color>
            <Color x:Key="CardBorderStrong">#A855F7</Color>
            <Color x:Key="InputBackground">#F8F5FF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="#E1D2FF" />
                <GradientStop Offset="0.45" Color="#EADFFF" />
                <GradientStop Offset="1.0" Color="#F4ECFF" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="12,12,12,20" Spacing="10">

                <!--  Encabezado con volver  -->
                <Border
                    Padding="12,10"
                    BackgroundColor="#FCFBFF"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.55" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#6D28D9" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#6D28D9"
                            Opacity="0.26"
                            Radius="18"
                            Offset="0,7" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">

                        <Button
                            Grid.Column="0"
                            Padding="0"
                            BackgroundColor="{StaticResource PrimaryDark}"
                            BorderColor="#6D28D9"
                            BorderWidth="1"
                            Clicked="OnVolverClicked"
                            CornerRadius="21"
                            FontAttributes="Bold"
                            FontSize="22"
                            HeightRequest="42"
                            Text="←"
                            TextColor="White"
                            VerticalOptions="Center"
                            WidthRequest="42">

                            <Button.Shadow>
                                <Shadow
                                    Brush="#2B0B98"
                                    Opacity="0.35"
                                    Radius="10"
                                    Offset="0,4" />
                            </Button.Shadow>
                        </Button>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="1"
                            VerticalOptions="Center">

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="Detalle del reporte"
                                TextColor="{StaticResource PrimaryDark}" />

                            <Label
                                FontSize="12"
                                Text="Información y acciones disponibles"
                                TextColor="{StaticResource TextMuted}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!--  Imagen principal  -->
                <Border
                    BackgroundColor="#FCFBFF"
                    HeightRequest="290"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.55" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#6D28D9" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#6D28D9"
                            Opacity="0.24"
                            Radius="16"
                            Offset="0,6" />
                    </Border.Shadow>

                    <Grid BackgroundColor="#F8F5FF">

                        <Image
                            x:Name="FotoReporteImage"
                            Aspect="AspectFit"
                            BackgroundColor="#F8F5FF"
                            HorizontalOptions="Fill"
                            Source="{Binding FotoMostrar}"
                            VerticalOptions="Fill" />

                        <!--  Etiqueta del tipo de reporte  -->
                        <Border
                            Margin="12"
                            Padding="10,5"
                            BackgroundColor="{Binding TipoReporteFondo}"
                            HorizontalOptions="Start"
                            Stroke="Transparent"
                            VerticalOptions="Start">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="{Binding TipoReporte}"
                                TextColor="{Binding TipoReporteTexto}" />
                        </Border>

                    </Grid>
                </Border>

                <!--  Información principal  -->
                <Border
                    Padding="16"
                    BackgroundColor="#FCFBFF"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.65" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#7C3AED" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#6D28D9"
                            Opacity="0.22"
                            Radius="14"
                            Offset="0,5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <Label
                            FontAttributes="Bold"
                            FontSize="22"
                            LineBreakMode="WordWrap"
                            Text="{Binding Titulo}"
                            TextColor="{StaticResource PrimaryDark}" />

                        <Label
                            FontSize="14"
                            LineBreakMode="WordWrap"
                            Text="{Binding Descripcion}"
                            TextColor="{StaticResource TextMuted}" />

                        <Grid
                            Margin="0,4,0,0"
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="10"
                            RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="8">

                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                FontSize="15"
                                Text="📍" />

                            <Label
                                x:Name="LblDistancia"
                                Grid.Row="0"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="13"
                                TextColor="{StaticResource PrimaryDeep}" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                FontSize="15"
                                Text="📅" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="13"
                                Text="{Binding FechaReporteTexto}"
                                TextColor="{StaticResource TextSecondary}" />

                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                FontSize="15"
                                Text="📌" />

                            <Border
                                Grid.Row="2"
                                Grid.Column="1"
                                Padding="10,4"
                                BackgroundColor="{Binding EstadoReporteFondo}"
                                HorizontalOptions="Start"
                                Stroke="Transparent">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="{Binding EstadoReporte}"
                                    TextColor="{Binding EstadoReporteTexto}" />
                            </Border>

                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!--  Datos referenciales de la mascota  -->
                <Border
                    Padding="16"
                    BackgroundColor="#FCFBFF"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.65" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#7C3AED" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#6D28D9"
                            Opacity="0.22"
                            Radius="14"
                            Offset="0,5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="Mascota"
                            TextColor="{StaticResource PrimaryDark}" />

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="12"
                            RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="10">

                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                Padding="10"
                                BackgroundColor="#FFFFFF"
                                Stroke="#D8B4FE"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        FontSize="11"
                                        Text="Nombre"
                                        TextColor="#7A7298" />
                                    <Label
                                        x:Name="LblNombreMascota"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        TextColor="#1E1B4B" />
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                Padding="10"
                                BackgroundColor="#FFFFFF"
                                Stroke="#D8B4FE"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        FontSize="11"
                                        Text="Especie"
                                        TextColor="#7A7298" />
                                    <Label
                                        x:Name="LblEspecie"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        TextColor="#1E1B4B" />
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Padding="10"
                                BackgroundColor="#FFFFFF"
                                Stroke="#D8B4FE"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        FontSize="11"
                                        Text="Raza"
                                        TextColor="#7A7298" />
                                    <Label
                                        x:Name="LblRaza"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        TextColor="#1E1B4B" />
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Padding="10"
                                BackgroundColor="#FFFFFF"
                                Stroke="#D8B4FE"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        FontSize="11"
                                        Text="Color"
                                        TextColor="#7A7298" />
                                    <Label
                                        x:Name="LblColor"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        TextColor="#1E1B4B" />
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                Grid.Row="2"
                                Grid.Column="0"
                                Padding="10"
                                BackgroundColor="#FFFFFF"
                                Stroke="#D8B4FE"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        FontSize="11"
                                        Text="Sexo"
                                        TextColor="#7A7298" />
                                    <Label
                                        x:Name="LblSexo"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        TextColor="#1E1B4B" />
                                </VerticalStackLayout>
                            </Border>

                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!--  Información de salud  -->
                <Border
                    x:Name="SeccionSalud"
                    Padding="16"
                    BackgroundColor="#FCFBFF"
                    IsVisible="False"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.65" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#7C3AED" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#6D28D9"
                            Opacity="0.22"
                            Radius="14"
                            Offset="0,5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">

                            <Border
                                BackgroundColor="#FFF7ED"
                                HeightRequest="38"
                                Stroke="#FED7AA"
                                StrokeThickness="1"
                                VerticalOptions="Center"
                                WidthRequest="38">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="19" />
                                </Border.StrokeShape>

                                <Label
                                    FontSize="19"
                                    HorizontalOptions="Center"
                                    Text="🩺"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="1"
                                VerticalOptions="Center">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="Salud"
                                    TextColor="{StaticResource PrimaryDark}" />

                                <Label
                                    FontSize="12"
                                    Text="Cuidados importantes"
                                    TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="10"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                            RowSpacing="10">

                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                FontSize="15"
                                Text="🩺" />

                            <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                                <Label
                                    FontSize="11"
                                    Text="Enfermedades"
                                    TextColor="#7A7298" />
                                <Label
                                    x:Name="LblEnfermedades"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    LineBreakMode="WordWrap"
                                    TextColor="{StaticResource PrimaryDark}" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                FontSize="15"
                                Text="♿" />

                            <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                <Label
                                    FontSize="11"
                                    Text="Discapacidades"
                                    TextColor="#7A7298" />
                                <Label
                                    x:Name="LblDiscapacidades"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    LineBreakMode="WordWrap"
                                    TextColor="{StaticResource PrimaryDark}" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                FontSize="15"
                                Text="💊" />

                            <VerticalStackLayout Grid.Row="2" Grid.Column="1">
                                <Label
                                    FontSize="11"
                                    Text="Tratamientos"
                                    TextColor="#7A7298" />
                                <Label
                                    x:Name="LblTratamientos"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    LineBreakMode="WordWrap"
                                    TextColor="{StaticResource PrimaryDark}" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Row="3"
                                Grid.Column="0"
                                FontSize="15"
                                Text="⚠️" />

                            <VerticalStackLayout Grid.Row="3" Grid.Column="1">
                                <Label
                                    FontSize="11"
                                    Text="Necesidades especiales"
                                    TextColor="#7A7298" />
                                <Label
                                    x:Name="LblNecesidadesEspeciales"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    LineBreakMode="WordWrap"
                                    TextColor="{StaticResource PrimaryDark}" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Row="4"
                                Grid.Column="0"
                                FontSize="15"
                                Text="📝" />

                            <VerticalStackLayout Grid.Row="4" Grid.Column="1">
                                <Label
                                    FontSize="11"
                                    Text="Observaciones"
                                    TextColor="#7A7298" />
                                <Label
                                    x:Name="LblObservacionesSalud"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    LineBreakMode="WordWrap"
                                    TextColor="{StaticResource PrimaryDark}" />
                            </VerticalStackLayout>

                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!--  Avistamientos registrados  -->
                <Border
                    x:Name="SeccionAvistamientos"
                    Padding="16"
                    BackgroundColor="#FCFBFF"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.65" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#7C3AED" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#6D28D9"
                            Opacity="0.22"
                            Radius="14"
                            Offset="0,5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="1">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="Avistamientos"
                                    TextColor="{StaticResource PrimaryDark}" />

                                <Label
                                    x:Name="LblAvistamientosResumen"
                                    FontSize="12"
                                    LineBreakMode="TailTruncation"
                                    Text="Sin avistamientos registrados."
                                    TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Padding="0"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                BorderColor="{StaticResource CardBorder}"
                                BorderWidth="1"
                                Clicked="OnActualizarAvistamientosClicked"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                HeightRequest="38"
                                Text="↻"
                                TextColor="{StaticResource PrimaryColor}"
                                VerticalOptions="Center"
                                WidthRequest="42" />
                        </Grid>

                        <CollectionView
                            x:Name="AvistamientosList"
                            HeightRequest="210"
                            SelectionMode="None">

                            <CollectionView.EmptyView>
                                <VerticalStackLayout
                                    Padding="20"
                                    HorizontalOptions="Center"
                                    Spacing="8"
                                    VerticalOptions="Center">

                                    <Label
                                        FontSize="34"
                                        HorizontalOptions="Center"
                                        Text="👀" />

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        HorizontalOptions="Center"
                                        Text="Sin avistamientos"
                                        TextColor="{StaticResource PrimaryDark}" />

                                    <Label
                                        FontSize="12"
                                        HorizontalTextAlignment="Center"
                                        Text="Aparecerán aquí cuando alguien reporte una pista."
                                        TextColor="{StaticResource TextMuted}" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>

                                    <Border
                                        Margin="0,0,0,12"
                                        Padding="10"
                                        BackgroundColor="#FFFCFF"
                                        Stroke="#CDB7FF"
                                        StrokeThickness="1.2">

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnAvistamientoTapped" />
                                        </Border.GestureRecognizers>

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="18" />
                                        </Border.StrokeShape>

                                        <Border.Shadow>
                                            <Shadow
                                                Brush="#5B21E6"
                                                Opacity="0.16"
                                                Radius="8"
                                                Offset="0,3" />
                                        </Border.Shadow>

                                        <Grid ColumnDefinitions="70,*" ColumnSpacing="10">

                                            <Border
                                                Grid.Column="0"
                                                BackgroundColor="#E2E8F0"
                                                HeightRequest="68"
                                                Stroke="Transparent"
                                                VerticalOptions="Center"
                                                WidthRequest="68">

                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="14" />
                                                </Border.StrokeShape>

                                                <Image
                                                    Aspect="AspectFill"
                                                    HeightRequest="68"
                                                    Source="{Binding FotoMostrar}"
                                                    WidthRequest="68" />
                                            </Border>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="4"
                                                VerticalOptions="Center">

                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="13"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="2"
                                                    Text="{Binding Descripcion}"
                                                    TextColor="{StaticResource TextMain}" />

                                                <Label
                                                    FontSize="12"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="1"
                                                    Text="{Binding ResumenUbicacion}"
                                                    TextColor="{StaticResource TextMuted}" />

                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label
                                                        FontSize="11"
                                                        LineBreakMode="TailTruncation"
                                                        Text="{Binding FechaResumen}"
                                                        TextColor="#94A3B8" />

                                                    <Border
                                                        Grid.Column="1"
                                                        Padding="7,3"
                                                        BackgroundColor="{Binding DetalleChipFondo}"
                                                        HorizontalOptions="End"
                                                        Stroke="Transparent">

                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="10" />
                                                        </Border.StrokeShape>

                                                        <Label
                                                            FontAttributes="Bold"
                                                            FontSize="10"
                                                            Text="{Binding DetalleChipTexto}"
                                                            TextColor="{Binding DetalleChipColor}" />
                                                    </Border>
                                                </Grid>

                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>

                <!--  Acciones  -->
                <Border
                    Padding="16"
                    BackgroundColor="#FCFBFF"
                    StrokeThickness="1.2">

                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#D8B4FE" />
                            <GradientStop Offset="0.65" Color="#A855F7" />
                            <GradientStop Offset="1.0" Color="#7C3AED" />
                        </LinearGradientBrush>
                    </Border.Stroke>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#6D28D9"
                            Opacity="0.22"
                            Radius="14"
                            Offset="0,5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="Acciones"
                            TextColor="{StaticResource PrimaryDark}" />

                        <Button
                            BackgroundColor="{StaticResource PrimaryDark}"
                            BorderColor="#6D28D9"
                            BorderWidth="1"
                            Clicked="OnVerUbicacionClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            HeightRequest="48"
                            Text="📍 Ver ubicación"
                            TextColor="White">

                            <Button.Shadow>
                                <Shadow
                                    Brush="#2B0B98"
                                    Opacity="0.32"
                                    Radius="12"
                                    Offset="0,5" />
                            </Button.Shadow>
                        </Button>

                        <Button
                            x:Name="BtnRegistrarAvistamiento"
                            BackgroundColor="#047857"
                            Clicked="OnRegistrarAvistamientoClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            HeightRequest="46"
                            Text="👀 Registrar avistamiento"
                            TextColor="White">

                            <Button.Shadow>
                                <Shadow
                                    Brush="#0F766E"
                                    Opacity="0.30"
                                    Radius="10"
                                    Offset="0,4" />
                            </Button.Shadow>
                        </Button>

                        <Label
                            x:Name="LblAvistamientoNoDisponible"
                            FontSize="12"
                            HorizontalTextAlignment="Center"
                            IsVisible="False"
                            Text="Acción no disponible para este reporte."
                            TextColor="{StaticResource TextMuted}" />

                        <Button
                            x:Name="BtnWhatsApp"
                            BackgroundColor="#16A34A"
                            Clicked="OnWhatsAppClicked"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            HeightRequest="46"
                            Text="💬 Contactar por WhatsApp"
                            TextColor="White">

                            <Button.Shadow>
                                <Shadow
                                    Brush="#22C55E"
                                    Opacity="0.30"
                                    Radius="10"
                                    Offset="0,4" />
                            </Button.Shadow>
                        </Button>

                        <Label
                            x:Name="LblReportePropio"
                            FontSize="12"
                            HorizontalTextAlignment="Center"
                            IsVisible="False"
                            LineBreakMode="WordWrap"
                            Text="Este reporte fue creado por ti."
                            TextColor="{StaticResource TextMuted}" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>