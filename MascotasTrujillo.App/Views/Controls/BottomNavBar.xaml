<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MascotasTrujillo.App.Views.Controls.BottomNavBar">

    <Grid Padding="14,6,14,12"
          BackgroundColor="Transparent">

        <Border BackgroundColor="#FFFFFF"
                Stroke="#E9D8FD"
                StrokeThickness="1"
                Padding="8,8">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="#5B21E6"
                        Opacity="0.16"
                        Offset="0,6"
                        Radius="18" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*,*,*,*"
                  ColumnSpacing="4">

                <!-- Radar -->
                <Grid x:Name="RadarItem"
                      Grid.Column="0"
                      Padding="4">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRadarTapped" />
                    </Grid.GestureRecognizers>

                    <VerticalStackLayout Spacing="3"
                                         HorizontalOptions="Center">

                        <Border x:Name="RadarCircle"
                                WidthRequest="42"
                                HeightRequest="42"
                                BackgroundColor="#F3E8FF"
                                Stroke="Transparent">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="21" />
                            </Border.StrokeShape>

                            <Label x:Name="RadarIcon"
                                   Text="⌖"
                                   FontSize="23"
                                   FontAttributes="Bold"
                                   TextColor="#5B21E6"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <Label x:Name="RadarText"
                               Text="Radar"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#5B21E6"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Reportes -->
                <Grid x:Name="ReportesItem"
                      Grid.Column="1"
                      Padding="4">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnReportesTapped" />
                    </Grid.GestureRecognizers>

                    <VerticalStackLayout Spacing="3"
                                         HorizontalOptions="Center">

                        <Border x:Name="ReportesCircle"
                                WidthRequest="42"
                                HeightRequest="42"
                                BackgroundColor="Transparent"
                                Stroke="Transparent">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="21" />
                            </Border.StrokeShape>

                            <Label x:Name="ReportesIcon"
                                   Text="▣"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   TextColor="#64748B"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <Label x:Name="ReportesText"
                               Text="Reportes"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#64748B"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Mascotas -->
                <Grid x:Name="MascotasItem"
                      Grid.Column="2"
                      Padding="4">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMascotasTapped" />
                    </Grid.GestureRecognizers>

                    <VerticalStackLayout Spacing="3"
                                         HorizontalOptions="Center">

                        <Border x:Name="MascotasCircle"
                                WidthRequest="42"
                                HeightRequest="42"
                                BackgroundColor="Transparent"
                                Stroke="Transparent">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="21" />
                            </Border.StrokeShape>

                            <Label x:Name="MascotasIcon"
                                   Text="🐾"
                                   FontSize="19"
                                   TextColor="#64748B"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <Label x:Name="MascotasText"
                               Text="Mascotas"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#64748B"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Perfil -->
                <Grid x:Name="PerfilItem"
                      Grid.Column="3"
                      Padding="4">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPerfilTapped" />
                    </Grid.GestureRecognizers>

                    <VerticalStackLayout Spacing="3"
                                         HorizontalOptions="Center">

                        <Border x:Name="PerfilCircle"
                                WidthRequest="42"
                                HeightRequest="42"
                                BackgroundColor="Transparent"
                                Stroke="Transparent">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="21" />
                            </Border.StrokeShape>

                            <Label x:Name="PerfilIcon"
                                   Text="👤"
                                   FontSize="19"
                                   TextColor="#64748B"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <Label x:Name="PerfilText"
                               Text="Perfil"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#64748B"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</ContentView>