<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MascotasTrujillo.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MascotasTrujillo.App.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"

    Shell.TabBarBackgroundColor="#FFFFFF"
    Shell.TabBarTitleColor="#5B21E6"
    Shell.TabBarUnselectedColor="#94A3B8"
    Shell.TabBarForegroundColor="#5B21E6"

    Shell.BackgroundColor="#FFFFFF"
    Shell.TitleColor="#1E1B4B">

    <TabBar>

        <Tab Title=" " Icon="icon_radar.png">
            <ShellContent 
            Title="Radar"
            ContentTemplate="{DataTemplate views:RadarPage}" />
        </Tab>

        <Tab Title=" " Icon="icon_clipboard.png">
            <ShellContent 
            Title="Mis Reportes"
            ContentTemplate="{DataTemplate views:MisReportesPage}" />
        </Tab>

        <Tab Title=" " Icon="icon_paw.png">
            <ShellContent 
            Title="Mis Mascotas"
            ContentTemplate="{DataTemplate views:MisMascotasPage}" />
        </Tab>

        <Tab Title=" " Icon="icon_user.png">
            <ShellContent 
            Title="Perfil"
            ContentTemplate="{DataTemplate views:PerfilPage}" />
        </Tab>

    </TabBar>

</Shell>