<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MascotasTrujillo.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MascotasTrujillo.App"
    xmlns:views="clr-namespace:MascotasTrujillo.App.Views"
    Title="Mascotas Trujillo">

    <TabBar>

        <Tab Title="Radar">
            <ShellContent
                ContentTemplate="{DataTemplate views:RadarPage}"
                Route="MainPage" />
        </Tab>

        <Tab Title="Mis Reportes">
            <ShellContent
                ContentTemplate="{DataTemplate views:MisReportesPage}"
                Route="MisReportesPage" />
        </Tab>

    </TabBar>

</Shell>