<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MascotasTrujillo.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MascotasTrujillo.App.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="#FFFFFF"
    Shell.TabBarTitleColor="#2B0B98"
    Shell.TabBarUnselectedColor="#94A3B8">

    <TabBar>

        <Tab Title="Radar" Icon="icon_radar.png">
            <ShellContent ContentTemplate="{DataTemplate views:RadarPage}" />
        </Tab>

        <Tab Title="Mis Mascotas" Icon="icon_paw.png">
            <ShellContent ContentTemplate="{DataTemplate views:MisMascotasPage}" />
        </Tab>

        <Tab Title="Mis Reportes" Icon="icon_clipboard.png">
            <ShellContent ContentTemplate="{DataTemplate views:MisReportesPage}" />
        </Tab>

        <Tab Title="Perfil" Icon="icon_user.png">
            <ShellContent ContentTemplate="{DataTemplate views:PerfilPage}" />
        </Tab>

    </TabBar>

</Shell>