<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  Fondo general de página  -->
    <Style x:Key="PageRootGridStyle" TargetType="Grid">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0.0" Color="{StaticResource PageBackground}" />
                    <GradientStop Offset="0.55" Color="{StaticResource PageBackgroundLight}" />
                    <GradientStop Offset="1.0" Color="#FAF7FF" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Tarjeta principal moderna  -->
    <Style x:Key="ModernCardStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="Stroke" Value="{StaticResource CardBorder}" />
        <Setter Property="StrokeThickness" Value="1.2" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="22" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow
                    Brush="{StaticResource PrimaryColor}"
                    Opacity="0.14"
                    Radius="14"
                    Offset="0,5" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Tarjeta grande  -->
    <Style
        x:Key="ModernCardLargeStyle"
        BasedOn="{StaticResource ModernCardStyle}"
        TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="24" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Header / Topbar moderno  -->
    <Style x:Key="ModernHeaderCardStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="Stroke" Value="{StaticResource CardBorderStrong}" />
        <Setter Property="StrokeThickness" Value="1.2" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="22" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow
                    Brush="{StaticResource PrimaryColor}"
                    Opacity="0.18"
                    Radius="18"
                    Offset="0,7" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Botón circular de volver  -->
    <Style x:Key="BackCircleButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimarySoft2}" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="BorderColor" Value="{StaticResource InputBorder}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="WidthRequest" Value="42" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="CornerRadius" Value="21" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--  Círculo de ícono  -->
    <Style x:Key="IconCircleStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimarySoft2}" />
        <Setter Property="Stroke" Value="{StaticResource InputBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="WidthRequest" Value="42" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="21" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Texto título  -->
    <Style x:Key="TitleLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextTitle}" />
    </Style>

    <!--  Texto subtítulo  -->
    <Style x:Key="SubtitleLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <!--  Texto sección  -->
    <Style x:Key="SectionTitleLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextTitle}" />
    </Style>

    <!--  Campo input moderno  -->
    <Style x:Key="InputBorderStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource InputBackground}" />
        <Setter Property="Stroke" Value="{StaticResource InputBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Campo input multilinea  -->
    <Style
        x:Key="InputEditorBorderStyle"
        BasedOn="{StaticResource InputBorderStyle}"
        TargetType="Border">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="HeightRequest" Value="110" />
    </Style>

    <!--  Entry moderno  -->
    <Style x:Key="ModernEntryStyle" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextMain}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextLight}" />
    </Style>

    <!--  Editor moderno  -->
    <Style x:Key="ModernEditorStyle" TargetType="Editor">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextMain}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextLight}" />
    </Style>

    <!--  Picker moderno  -->
    <Style x:Key="ModernPickerStyle" TargetType="Picker">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextMain}" />
        <Setter Property="TitleColor" Value="{StaticResource TextLight}" />
    </Style>

    <!--  Botón principal  -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow
                    Brush="{StaticResource PrimaryColor}"
                    Opacity="0.32"
                    Radius="12"
                    Offset="0,5" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Botón principal grande  -->
    <Style
        x:Key="PrimaryButtonLargeStyle"
        BasedOn="{StaticResource PrimaryButtonStyle}"
        TargetType="Button">
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!--  Botón secundario morado  -->
    <Style x:Key="SecondaryPurpleButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimarySoft2}" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="BorderColor" Value="{StaticResource CardBorderStrong}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HeightRequest" Value="46" />
    </Style>

    <!--  Chip morado  -->
    <Style x:Key="PurpleChipStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimarySoft2}" />
        <Setter Property="Stroke" Value="{StaticResource InputBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Chip rosado  -->
    <Style x:Key="PinkChipStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource AccentPinkSoft}" />
        <Setter Property="Stroke" Value="{StaticResource AccentPinkBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>